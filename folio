# folio find secret [--plain] <part>...
# `pass find`, minus the texts.
SecretFind() {
    local arg terms
    local parts=()
    for arg in "$@"; do
        case $arg in
            -h|--help) secret-find-help ; return 0 ;;
            --plain)   PLAIN=1 ;;
            *)         parts+=("$arg") ;;
        esac
    done
    set -- ${parts[@]+"${parts[@]}"}
    (( $# > 0 )) || die "Usage: folio find secret [--plain] <part>..."
    terms="*$(printf '%s*|*' "$@")"
    printf 'Search Terms: %s\n' "$*"
    store-tree gpg "$STORE_PATH" -P "${terms%|*}" --matchdirs --ignore-case
}

