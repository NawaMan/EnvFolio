#!/usr/bin/env bash

#== Doc ========================================================================
#
# EnvFolio — a command-line tool for keeping texts and secrets, built on `pass`.
#
# Usage: folio <command> [args...]        (`folio help` lists the commands)
#   folio init | path | backup | restore | export | import
#   folio ls | find | grep | show | insert | edit | generate | rm | mv | cp   text|secret
#   folio check vars
#   folio ls | exec | shell | completion | version | help [command]
#   (The kind can also come first: `folio text show` is `folio show text`.)
#
# Environment:
#   FOLIO_STORE_DIR  The EnvFolio store (default ~/.folio). Laid out like a pass store, but
#                    kept apart from your own ~/.password-store.
#
# Every command, with examples: MANUAL.md

#== Settings ===================================================================

# Set by the release: `<major>.<minor>.<patch>` in a release, `<next>--rc` on main between releases.
# The release workflow (.github/workflows/release.yml) reads and bumps this exact line.
APP_VERSION=1.0.0--rc

STORE_PATH=${FOLIO_STORE_DIR:-$HOME/.folio}
# Always absolute: `pass` loops forever on a relative PASSWORD_STORE_DIR whose folder doesn't exist
# yet (its set_git keeps stripping "/…" off a path that has none left).
[[ $STORE_PATH == /* ]] || STORE_PATH=$PWD/$STORE_PATH

# The caller's own PASSWORD_STORE_DIR (set or not), put back for the command `folio exec` runs.
CALLER_STORE_DIR_SET=${PASSWORD_STORE_DIR+set}
CALLER_STORE_DIR=${PASSWORD_STORE_DIR-}

# The EnvFolio store is laid out like a pass store, but lives in its own place so it never touches
# the user's own ~/.password-store. Every `pass` call goes there.
export PASSWORD_STORE_DIR="$STORE_PATH"

# gpg's passphrase prompt needs the terminal, also when its stdin is a pipe or a file (as pass does).
[[ -n ${GPG_TTY:-} ]] || ! tty -s || { GPG_TTY=$(tty) ; export GPG_TTY ; }

#== Main =======================================================================

Main() {
    # Asked at every Tab press, by the scripts of `folio completion`: quick, and quiet.
    if [[ ${1:-} == __complete ]]; then shift ; complete-words "$@" ; return 0 ; fi
    # --fresh-passphrase (or FOLIO_FRESH_PASSPHRASE=1) goes with every command, so it is taken here.
    take-fresh-passphrase "$@"
    set -- "${ARGS[@]}"
    # `folio show text …` is run as `folio text show …`, the order the code below takes.
    if is-action-first "${1:-}" "${2:-}"; then set -- "$2" "$1" "${@:3}" ; fi
    # Quiet when all is there; otherwise show the table and stop.
    if ! ensure-requirements "$@" >/dev/null; then ensure-requirements "$@" ; return 1 ; fi
    set-gpg-tty
    start-fresh-passphrase

    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        init|backup|restore|export|import|exec|shell) passphrase-option-is-renamed "$category" "$@" ;;
    esac
    # --store-passphrase-fd <n> means the same for every command that may need the store key's
    # passphrase, so it is taken here; require-store unlocks the key with it.
    case "$category ${1:-}" in
        "backup "*|"export "*|"import "*|"exec "*|"shell "*|"text insert"|"text edit"|"text generate"|\
        "secret show"|"secret grep"|"secret edit"|"secret generate")
            take-store-passphrase-fd "$@"
            set -- "${ARGS[@]}" ;;
    esac
    case "$category" in
        init)    Init    "$@" ;;
        path)    Path    "$@" ;;
        backup)  Backup  "$@" ;;
        restore) Restore "$@" ;;
        export)  Export  "$@" ;;
        import)  Import  "$@" ;;
        text)    Text    "$@" ;;
        secret)  Secret  "$@" ;;
        vars)    Vars    "$@" ;;
        ls)      Ls      "$@" ;;
        exec)    Exec    "$@" ;;
        shell)   Shell   "$@" ;;
        completion) Completion "$@" ;;
        version) Version "$@" ;;
        help)    Help    "$@" ;;
        store)   store-is-gone "$@" ;;
        find|grep|show|insert|edit|generate|rm|mv|cp)
                 die "$category: a text or a secret? \`folio $category text …\` or \`folio $category secret …\`." ;;
        check)   die "check: check what? \`folio check vars <file>…\`." ;;
        "")      echo    "Usage: folio <init|path|backup|restore|export|import|text|secret|vars|ls|exec|shell|completion|version|help> [args...]" >&2 ; return 1 ;;
        *)       echo    "folio: unknown command: $category" >&2 ; return 1 ;;
    esac
}

Version() {
    echo "EnvFolio $APP_VERSION"
}

# folio help [command...]
Help() {
    if is-action-first "${1:-}" "${2:-}"; then set -- "$2" "$1" "${@:3}" ; fi
    case "$*" in
        "")                folio-help           ;;
        "init")            init-help            ;;
        "path")            path-help            ;;
        "backup")          backup-help          ;;
        "restore")         restore-help         ;;
        "export")          export-help          ;;
        "import")          import-help          ;;
        "ls")              list-help            ;;
        "exec")            run-exec-help        ;;
        "shell")           run-shell-help       ;;
        "completion")      completion-help      ;;
        "text ls")         text-ls-help         ;;
        "text find")       text-find-help       ;;
        "text grep")       text-grep-help       ;;
        "text show")       text-show-help       ;;
        "text insert")     text-insert-help     ;;
        "text edit")       text-edit-help       ;;
        "text generate")   text-generate-help   ;;
        "text rm")         text-rm-help         ;;
        "text mv")         text-mv-help         ;;
        "text cp")         text-cp-help         ;;
        "secret ls")       secret-ls-help       ;;
        "secret find")     secret-find-help     ;;
        "secret grep")     secret-grep-help     ;;
        "secret show")     secret-show-help     ;;
        "secret insert")   secret-insert-help   ;;
        "secret edit")     secret-edit-help     ;;
        "secret generate") secret-generate-help ;;
        "secret rm")       secret-rm-help       ;;
        "secret mv")       secret-mv-help       ;;
        "secret cp")       secret-cp-help       ;;
        "vars check")      vars-check-help      ;;
        *)                 echo "folio help: no help for '$*' yet." >&2 ; return 1 ;;
    esac
}

function folio-help() {
    cat <<'EOF'
Usage: folio <command> [args...]

Commands:
  init              Create the EnvFolio store
  path              Print the store's folder
  backup            Save the store and its key into one file
  restore           Bring the store and its key back from a backup
  export            Copy some items into one locked file, with a key of its own
  import            Bring items from an export into the store (made if missing)
  ls                List texts and secrets together
  ls text           List texts
  ls secret         List secrets
  find text         Find texts by name
  find secret       Find secrets by name
  grep text         Find texts by value
  grep secret       Find secrets by value
  show text         Show a text (its signature checked), or copy it to the clipboard
  show secret       Show a secret, or copy it to the clipboard
  insert text       Add a text (plain, signed)
  insert secret     Add a secret
  edit text         Edit a text in $EDITOR
  edit secret       Edit a secret in $EDITOR
  generate text     Generate a random text
  generate secret   Generate a random secret
  rm text           Remove a text
  rm secret         Remove a secret
  mv text           Rename or move a text
  mv secret         Rename or move a secret
  cp text           Copy a text
  cp secret         Copy a secret
  check vars        Check vars files (for exec and shell --vars) for mistakes
  exec              Run a command with entries as environment variables
  shell             Start a shell with entries as environment variables
  completion        Print the Tab completion script for bash or zsh
  version           Print EnvFolio's version
  help [command]    Show help, e.g. `folio help init`

Options for every command:
  --fresh-passphrase  Have gpg-agent forget the store key's passphrase at the start and the end
                      (also FOLIO_FRESH_PASSPHRASE=1)

The kind can also come first: `folio text show` is `folio show text`.
The store is $FOLIO_STORE_DIR, default ~/.folio. EnvFolio warns when that folder is someone
else's or open to other users.
Details and examples: MANUAL.md
EOF
}

#== Common Constants ===========================================================

EXTRA_LINE=$'\n'

# is-action-first <word> <word>: whether they are an action and then a kind (`folio show text`).
# The code takes the kind first (`folio text show`), so Main and Help swap them; typed kind first,
# a command still works.
function is-action-first() {
    case $2 in
        text|secret) [[ " ls find grep show insert edit generate rm mv cp " == *" $1 "* ]] ;;
        vars)        [[ $1 == check ]] ;;
        *)           return 1 ;;
    esac
}

# is-action <word>: whether it is an action of a kind (show, check, …).
function is-action() { is-action-first "$1" text || is-action-first "$1" vars ; }

#== Old commands ===============================================================

# folio store <command>: the store commands were moved up a level in 0.5.0 (`folio store init` is
# now `folio init`). Not an alias: it says what to run instead.
function store-is-gone() {
    case ${1:-} in
        init|path|backup|restore|export|import)
            die "there is no \`folio store\` any more: run \`folio $1\`." ;;
        *)  die "there is no \`folio store\` any more: its commands are \`folio init\`, \`path\`, \`backup\`," \
                "\`restore\`, \`export\` and \`import\`." ;;
    esac
}

# passphrase-option-is-renamed <command> [args...]: --passphrase-stdin and --passphrase-fd were
# renamed in 0.7.0, by whose passphrase they give: --store-… for the store key's (init), --file-…
# for a backup's or an export's (the others). Not an alias: it says what to use instead.
function passphrase-option-is-renamed() {
    local command=$1 arg kind=file ; shift
    [[ $command == init ]] && kind=store
    for arg in "$@"; do
        case $arg in
            --) return 0 ;;
            --passphrase-stdin|--passphrase-fd|--passphrase-fd=*) ;;
            *)  continue ;;
        esac
        # exec and shell never had --passphrase-stdin: for them it is just an unknown option.
        [[ $arg == --passphrase-stdin && ( $command == exec || $command == shell ) ]] && continue
        arg=${arg%%=*}
        die "$command: $arg is now --$kind-${arg#--}."
    done
}

# --- path ---------------------------------------------------------------------

function path-help() {
    cat <<'EOF'
Usage: folio path

Print the EnvFolio store's folder: $FOLIO_STORE_DIR, default ~/.folio. Works without a store.

Options:
  -h, --help          Show this help and stop.
EOF
}

# folio path
Path() {
    case ${1:-} in -h|--help) path-help ; return 0 ;; esac
    (( $# == 0 )) || die "Usage: folio path"
    echo "${STORE_PATH}"
}

# Whether the store is ready to use. Prints nothing; the caller acts on the return code:
#   0 - ready: the folder has a non-empty .gpg-id (written by `pass init`) and a git history
#   1 - missing: no folder at all
#   2 - not ready: the folder exists but lacks one of those (another folder, or an unfinished init)
function store-exists() {
    [[ -d $STORE_PATH          ]] || return 1
    [[ -s $STORE_PATH/.gpg-id  ]] || return 2
    [[ -e $STORE_PATH/.git     ]] || return 2
    return 0
}

# Whether $1 is a folder with nothing in it, dotfiles included. Such a folder is as good as none
# for `folio init` and `folio restore`: the store is made inside it.
function is-empty-dir() {
    [[ -d $1 && -z $(ls -A "$1") ]]
}

# Whether only its owner can get into folder $1: no group or other bits in its `ls -ldL` mode,
# which reads the same on Linux and macOS (stat's flags do not).
function is-private-dir() {
    local mode
    mode=$(ls -ldL "$1" 2>/dev/null) || return 1
    [[ ${mode:4:6} == ------ ]]
}

# Whether the user owns folder $1 (a function, so tests can stand in for another owner).
function is-own-dir() {
    [[ -O $1 ]]
}

# Whether the store's folder exists and is someone else's, or open to other users.
function is-unsafe-store() {
    [[ -d $STORE_PATH ]] || return 1
    ! is-own-dir "$STORE_PATH" || ! is-private-dir "$STORE_PATH"
}

# Warn, as gpg does for its home, when the store's folder is someone else's or other users can get
# into it. EnvFolio makes the folder private (700) when it creates it, but leaves one it was given
# (a bind mount, say) as it is. There is no switch to hide this: it is the user's data.
function warn-unsafe-store() {
    [[ -d $STORE_PATH ]] || return 0
    local owner
    if ! is-own-dir "$STORE_PATH"; then
        # shellcheck disable=SC2012  # one known folder's owner, not a listing of names
        owner=$(ls -ldL "$STORE_PATH" | awk '{ print $3 }')
        printf 'folio: warning: %s belongs to %s, not to you: they can read and change your store.\n' \
               "$STORE_PATH" "$owner" >&2
    fi
    if ! is-private-dir "$STORE_PATH"; then
        printf 'folio: warning: other users can get into %s. To make it private:\n    chmod 700 %s\n' \
               "$STORE_PATH" "$STORE_PATH" >&2
    fi
}

# For the commands that put items into the store (init, restore, import): with the store's folder
# unsafe, warn, then go on only when the user says so — --allow-unsafe-folder, or yes when asked.
# Once accepted, a later check in the same run (import making the store with init) passes quietly.
# accept-unsafe-store <allowed> <stdin-taken: 1 when stdin carries a passphrase, so cannot answer>
STORE_UNSAFE_ACCEPTED=0
function accept-unsafe-store() {
    local allowed=$1 stdin_taken=$2
    (( ! STORE_UNSAFE_ACCEPTED )) && is-unsafe-store || return 0
    warn-unsafe-store
    STORE_MODE_CHECKED=1
    if (( ! allowed )); then
        (( ! stdin_taken )) \
            || die "Not using $STORE_PATH: stdin carries the passphrase, so EnvFolio cannot ask. Nothing changed." \
                   "Add --allow-unsafe-folder to use it anyway."
        confirm "Use $STORE_PATH anyway?" \
            || die "Not using $STORE_PATH. Nothing changed. Add --allow-unsafe-folder to use it anyway, or run with${EXTRA_LINE}    FOLIO_STORE_DIR=<other-folder>"
    fi
    STORE_UNSAFE_ACCEPTED=1
}

# --- init ---------------------------------------------------------------------

function store-init-usage() {
    cat <<'EOF'
Usage: folio init [--key <id>] [--allow-unsafe-folder]
       folio init [--new-key] [--name <name>] [--email <email>] [--key-type <pqc|classical>]
                  [--store-passphrase-stdin|--store-passphrase-fd <n>] [--allow-unsafe-folder]
EOF
}

function init-help() {
    store-init-usage
    cat <<'EOF'

Create the EnvFolio store ($FOLIO_STORE_DIR, default ~/.folio): pick or create the GPG key
that encrypts it, run `pass init`, and start the store's git history. A folder made here is private
(700); an existing empty folder is used as it is. When that folder is someone else's or other users
can get in, EnvFolio warns and asks before using it. Anything not given is asked for.

Options:
  --key <id>          Use an existing secret key: fingerprint, key id or email (must match one).
                      No passphrase is needed: the store only encrypts to the key.
  --new-key           Create a new key — post-quantum when gpg can make one (see --key-type).
                      Implied by any option below.
  --name <name>       The new key's name.
  --email <email>     The new key's email.
  --key-type <pqc|classical>
                      The new key's kind: pqc (post-quantum, ML-KEM + ECC; opening the store or
                      a backup of it then needs gpg 2.5.21 or later everywhere) or classical
                      (gpg's default key, e.g. X25519 + Ed25519). Not given: pqc when this gpg can
                      make one — asked, when anything else is asked — else classical.
  --store-passphrase-stdin
                      Read the new key's passphrase from the first line of stdin.
                      Needs --name and --email. An empty passphrase is refused.
  --store-passphrase-fd <n>
                      Read the new key's passphrase from the first line of file descriptor <n>,
                      e.g. --store-passphrase-fd 3 3< pass.txt. stdin stays free, so anything not
                      given is still asked for. An empty passphrase is refused.
  --allow-unsafe-folder
                      Use an existing folder that is someone else's or open to other users without
                      asking (still with the warning).
  -h, --help          Show this help.

--opt=value works as well as --opt value.
Examples: MANUAL.md, section `folio init`.
EOF
}

# folio init [--key <id>] | [--new-key] [--name <name>] [--email <email>] [--key-type <pqc|classical>]
#                     [--store-passphrase-stdin|--store-passphrase-fd <n>] [--allow-unsafe-folder]
# Anything not given is asked for. An existing key needs no passphrase: the store only encrypts to it.
Init() {
    # Process the command-line options
    local key_id="" new_key=0 name="" email="" key_type="" passphrase_stdin=0 passphrase_fd="" allow_unsafe=0 arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        # --opt=value is the same as --opt value
        if [[ $arg == --*=* ]]; then set -- "${arg#*=}" "$@" ; arg=${arg%%=*} ; fi
        case $arg in
            --key|--name|--email|--key-type|--store-passphrase-fd)
                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                case $arg in
                    --key)   key_id=$1 ;;
                    --name)  name=$1   ;;
                    --email) email=$1  ;;
                    --key-type) key_type=$1 ;;
                    --store-passphrase-fd) passphrase_fd=$1 ;;
                esac
                shift ;;
            --new-key)          new_key=1          ;;
            --store-passphrase-stdin) passphrase_stdin=1 ;;
            --allow-unsafe-folder) allow_unsafe=1 ;;
            -h|--help)          init-help ; return 0 ;;
            *) die "init: unknown option: $arg${EXTRA_LINE}$(store-init-usage)" ;;
        esac
    done

    section "Overview"
    cat >&2 <<'EOF'
This creates your EnvFolio store, where your texts and secrets are kept. It needs:
  - A folder for the store.
  - A GPG key to protect it: an existing one, or a new one made from your name and email.
    (For a key with special needs, make it with gpg first and pick it here.)
A new key also needs a passphrase. An existing key needs none: the store is only encrypted to it.
EOF

    section "Parameters"

    # Input: the store path — FOLIO_STORE_DIR, default ~/.folio (see STORE_PATH at the top)
    show-answer "Store path" "$(tilde-path "$STORE_PATH")"

    local status=0
    # Input: the state of the store folder (FOLIO_STORE_DIR, default ~/.folio)
    store-exists || status=$?
    # An empty folder is as good as none: the store is made inside it, its mode left as it is.
    if (( status == 2 )) && is-empty-dir "$STORE_PATH"; then
        # Input: the folder's owner and mode; --allow-unsafe-folder, or a y/N answer on stdin
        accept-unsafe-store "$allow_unsafe" "$passphrase_stdin"
        status=1
    fi
    if (( status == 0 )); then
        die "A EnvFolio store already exists at $STORE_PATH." \
            "To create another one, run with${EXTRA_LINE}    FOLIO_STORE_DIR=<other-folder> $0 init."
    fi
    if (( status == 2 )); then
        die "$STORE_PATH exists but is not a ready EnvFolio store" \
            "(maybe an earlier \`folio init\` did not finish)." \
            "Remove it and run again, or run with${EXTRA_LINE}    FOLIO_STORE_DIR=<other-folder> $0 init."
    fi
    if [[ -d $STORE_PATH ]]; then
        info "The store path is available: an empty folder, used as it is." >&2
    else
        info "The store path is available: the folder will be made (private, 700)." >&2
    fi

    # --name / --email / --key-type / --store-passphrase-stdin / --store-passphrase-fd imply --new-key
    [[ -n $name || -n $email || -n $key_type || -n $passphrase_fd ]] || (( passphrase_stdin )) && new_key=1
    if [[ -n $key_id ]] && (( new_key )); then
        die "--key cannot be used with --new-key, --name, --email, --key-type, --store-passphrase-stdin or --store-passphrase-fd."
    fi
    case $key_type in
        ""|classical) ;;
        pqc) gpg-has-pqc || die "--key-type pqc needs gpg 2.5.21 or later (this one is $(gpg-version))."$'\n'"$PQC_GPG_HELP" ;;
        *)   die "--key-type is pqc or classical, not '$key_type'." ;;
    esac
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--store-passphrase-stdin and --store-passphrase-fd cannot be used together."
    fi
    [[ -z $passphrase_fd ]] || check-passphrase-fd --store-passphrase-fd "$passphrase_fd"
    # stdin carries the passphrase, so nothing else can be asked for.
    if (( passphrase_stdin )) && [[ -z $name || -z $email ]]; then
        die "--store-passphrase-stdin needs --name and --email too."
    fi

    # Input: the key — --key; otherwise picked from the keyring's secret keys, or a new one.
    local key="" passphrase="" algo="" asked=0 uid expiry
    if [[ -n $key_id ]]; then
        key=$(find-key "$key_id") || exit 1
    elif (( ! new_key )); then
        key=$(select-key) || exit 1
        [[ -n $key ]] || new_key=1
    fi
    if (( new_key )); then
        # Input: the new key's name and email — --name / --email, or asked with a guess
        # (git, passwd, EMAIL).
        [[ -n $name && -n $email ]] || asked=1
        [[ -n $name  ]] || name=$( ask-text "Your name"  "e.g. Jane Doe"         "$(guess-name)")  || exit 1
        [[ -n $name  ]] || die "A name is needed to create a key."
        show-answer "Name" "$name"
        [[ -n $email ]] || email=$(ask-text "Your email" "e.g. jane@example.com" "$(guess-email)") || exit 1
        [[ -n $email ]] || die "An email is needed to create a key."
        show-answer "Email" "$email"
        # Input: the new key's passphrase — the first line of stdin with --store-passphrase-stdin, or
        # of fd <n> with --store-passphrase-fd <n>; otherwise gpg asks for it when it makes the key.
        if (( passphrase_stdin )); then
            IFS= read -rs passphrase || true
            [[ -n $passphrase ]] || die "No passphrase on stdin."
        elif [[ -n $passphrase_fd ]]; then
            read-passphrase-fd "$passphrase_fd"
            passphrase=$PASSPHRASE
            unset PASSPHRASE
        fi
        if [[ -n $passphrase ]]; then
            show-answer "Passphrase" "************"
        else
            show-answer "Passphrase" "gpg asks for it when it makes the key"
            asked=1
        fi
        # Input: the new key's kind — --key-type; otherwise post-quantum when this gpg can make one,
        # else gpg's default. Asked (post-quantum or classical) when this gpg can, unless every
        # input above came from an option: a run with no prompts stays one.
        algo=default
        if [[ $key_type == pqc ]]; then
            algo=pqc
        elif [[ -z $key_type ]] && gpg-has-pqc; then
            algo=pqc
            if (( asked )); then algo=$(ask-key-kind) || exit 1; fi
        fi
        show-answer "Key type" "$(key-kind-label "$algo")"
    else
        show-answer "Key" "$key"
    fi

    section "Creating"
    info "That is everything needed. Creating the store now." >&2

    if (( new_key )); then
        section "Generating the key."
        if [[ -n $passphrase ]]; then
            # printf is a builtin: the passphrase reaches gpg through a pipe, never through argv.
            key=$(printf '%s\n' "$passphrase" | generate-key "$name" "$email" 1 "$algo") || exit 1
            unset passphrase
        else
            acknowledge "Next, gpg asks you to choose the new key's passphrase (twice)." \
                        "It protects the key: you need it to read your secrets and to add texts." \
                        "It cannot be reset, so keep it safe."
            key=$(generate-key "$name" "$email" 0 "$algo") || exit 1
        fi
        section-end
        show-answer "Key" "$key"
    fi
    # Input: the key's user id (it becomes the git author) and its expiry, from the keyring
    uid=$(key-uid "$key")
    [[ -n $uid ]] || die "Cannot find the key $key."
    expiry=$(key-expiry "$key")

    # A folder made here, and the git history, are for the owner only (700).
    umask 077
    mkdir -p "$STORE_PATH" || die "Cannot create $STORE_PATH."

    section "Create the password store"
    # Input: PASSWORD_STORE_DIR, set to the store's folder at startup
    pass init "$key" || die "pass init failed."

    section "Start the store's git history"
    start-store-history "$uid"

    section "Summary"
    store-summary "$key" "$uid" "$expiry" "$(key-kind "$key")"
    echo ""
}

# Start the store's git history, so `pass` commits every change from here on. The repo gets its
# own author (from the key's user id) first: without a global git identity, `pass git init`'s
# first commit — and every later automatic one — would fail.
function start-store-history() {
    local uid=$1
    local name=${uid% <*} email=${uid##*<}
    email=${email%>}

    git -C "$STORE_PATH" init --quiet                || die "Starting the store's git history failed."
    git -C "$STORE_PATH" config user.name  "$name"
    git -C "$STORE_PATH" config user.email "$email"
    pass git init >/dev/null                         || die "Starting the store's git history failed."
    show-answer "History" "$(git -C "$STORE_PATH" log --oneline | wc -l | tr -d ' ') commit(s)"
}

# The closing box: what was set up, and what the user must keep to ever get their passwords back.
function store-summary() {
    local key=$1 uid=$2 expiry=$3 kind=$4 lines
    lines=(
        "Your pass store is ready."
        ""
        "Store:   $(tilde-path "$(Path)")"
        "Key:     $key"
        "         $uid"
        "Type:    $kind"
        "Expires: ${expiry:-never}"
        ""
        "To get your passwords back if this machine is lost, you need both:"
        ""
        "1. Your passphrase — it can't be reset. Memorise it, and keep a written copy offline."
        ""
        "2. A backup of your key and store — one file, made with:"
        "     folio backup"
        "   Keep it somewhere safe and offline, and run it again after you change passwords."
    )
    if [[ -n $expiry ]]; then
        lines+=(
            ""
            "When the key expires ($expiry), pass can't add or change entries until you extend it:"
            "  gpg --quick-set-expire $key 2y"
        )
    fi
    show-box "${lines[@]}"
}

# Die unless the store is ready; commands that read or write items call this first.
# Warns (once) when the store's folder is someone else's or other users can get into it.
# With --store-passphrase-fd, unlocks the store's key.
STORE_MODE_CHECKED=0
function require-store() {
    check-store
    unlock-store-key
}

# check-store: require-store without unlocking the key — for exec and shell, which unlock it only
# once they go on to read a value.
function check-store() {
    store-exists || die "No ready EnvFolio store at $STORE_PATH. Create one with: folio init"
    if (( ! STORE_MODE_CHECKED )); then
        STORE_MODE_CHECKED=1
        warn-unsafe-store
    fi
}

# --- backup -------------------------------------------------------------------

# A backup is one file: folio-backup.txt (what it holds), key.asc (the store's keys, still
# protected by their passphrase) and the store's folder — without .git unless --history.
BACKUP_SUFFIX=--folio.tar.gz
ENCRYPTED_BACKUP_SUFFIX=--folio.gpg

function store-backup-usage() {
    cat <<'EOF'
Usage: folio backup [--history] [--encrypt [--file-passphrase-stdin|--file-passphrase-fd <n>]]
                    [--store-passphrase-fd <n>] [<file>|<folder>]
EOF
}

function backup-help() {
    store-backup-usage
    cat <<'EOF'

Save the whole EnvFolio store and its GPG key into one file, to get it all back with
`folio restore` — here or on a new machine. gpg asks for the key's passphrase to export
it; in the backup, the key stays protected by that passphrase.

The file is <file> (--folio.tar.gz added when missing), or
backup-<date>-<time>--folio.tar.gz in <folder>, default the current one. An existing file is
never replaced.

Options:
  --history           Keep the store's git history too. Without it, a restore starts a new one.
  --encrypt           Encrypt the backup with a passphrase of its own; the file ends in
                      --folio.gpg. Without it, the texts and the names of the secrets can be read by anyone
                      who has the file (the secrets themselves stay encrypted).
  --file-passphrase-stdin
                      Read that passphrase from the first line of stdin. Needs --encrypt.
                      An empty passphrase is refused.
  --file-passphrase-fd <n>
                      The same, from the first line of file descriptor <n>, e.g.
                      --file-passphrase-fd 3 3< pass.txt.
  --store-passphrase-fd <n>
                      The store key's passphrase, from the first line of file descriptor <n>,
                      instead of gpg's prompt.
  -h, --help          Show this help.
EOF
}

# folio backup [--history] [--encrypt [--file-passphrase-stdin|--file-passphrase-fd <n>]]
#              [--store-passphrase-fd <n>] [<file>|<folder>]
Backup() {
    local history=0 encrypt=0 passphrase_stdin=0 passphrase_fd="" target=""
    while (( $# > 0 )); do
        case $1 in
            --history)          history=1          ;;
            --encrypt)          encrypt=1          ;;
            --file-passphrase-stdin) passphrase_stdin=1 ;;
            --file-passphrase-fd)
                [[ $# -gt 1 && -n $2 ]] || die "$1 needs a value."
                passphrase_fd=$2 ; shift ;;
            --file-passphrase-fd=*) passphrase_fd=${1#*=} ;;
            -h|--help)          backup-help ; return 0 ;;
            -*) die "backup: unknown option: $1${EXTRA_LINE}$(store-backup-usage)" ;;
            *)  [[ -z $target ]] || die "backup: one file or folder only.${EXTRA_LINE}$(store-backup-usage)"
                target=$1 ;;
        esac
        shift
    done
    (( encrypt || ! passphrase_stdin )) || die "--file-passphrase-stdin needs --encrypt."
    (( encrypt )) || [[ -z $passphrase_fd ]] || die "--file-passphrase-fd needs --encrypt."
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--file-passphrase-stdin and --file-passphrase-fd cannot be used together."
    fi
    [[ -z $passphrase_fd ]] || check-passphrase-fd --file-passphrase-fd "$passphrase_fd"
    require-store

    local suffix=$BACKUP_SUFFIX file=${target:-.}
    (( encrypt )) && suffix=$ENCRYPTED_BACKUP_SUFFIX
    [[ -d $file ]] && file=${file%/}/backup-$(date +%Y%m%d-%H%M%S)$suffix
    [[ $file == *"$suffix" ]] || file+=$suffix
    [[ ! -e $file ]]              || die "$file already exists."
    [[ -d $(dirname "$file") ]]   || die "There is no folder $(dirname "$file")."

    local passphrase=""
    if (( passphrase_stdin )); then
        IFS= read -rs passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on stdin."
    elif [[ -n $passphrase_fd ]]; then
        read-passphrase-fd "$passphrase_fd"
        passphrase=$PASSPHRASE
        unset PASSPHRASE
    fi

    # The store's keys, by primary fingerprint; each must have its secret part here.
    local store id ids=() keys=() key
    store=$(cd "$STORE_PATH" && pwd -P)
    while IFS= read -r id; do [[ -n $id ]] && ids+=("$id") ; done < "$store/.gpg-id"
    while IFS= read -r key; do
        gpg --list-secret-keys "$key" >/dev/null 2>&1 \
            || die "The secret key $key is not in this keyring, so it cannot be backed up."
        keys+=("$key")
    done < <(gpg --list-keys --with-colons -- "${ids[@]}" 2>/dev/null \
                | awk -F: '$1 == "pub" { p = 1 } $1 == "fpr" && p { print $10 ; p = 0 }')
    (( ${#keys[@]} > 0 )) || die "Cannot find the store's key in this keyring."

    umask 077
    local stage
    stage=$(mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$stage" "$file.partial"
    {
        echo "folio-backup 1"
        echo "created $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "store ${store##*/}"
        printf 'key %s\n' "${keys[@]}"
    } > "$stage/folio-backup.txt"

    # gpg-agent asks for the passphrase to export a key even when it has it already: with
    # --store-passphrase-fd, it is given here too, on fd 3 as for the backup's own.
    section "Export the key (gpg may ask for its passphrase)"
    local take_key=(gpg)
    [[ -n $STORE_PASSPHRASE ]] && take_key=(gpg --batch --pinentry-mode loopback --passphrase-fd 3)
    if ! "${take_key[@]}" --armor --output "$stage/key.asc" --export-secret-keys "${keys[@]}" \
             3< <(printf '%s\n' "$STORE_PASSPHRASE") \
           || [[ ! -s $stage/key.asc ]]; then
        die "Exporting the key failed."
    fi
    unset STORE_PASSPHRASE
    show-answer "Key" "${keys[*]}"

    section "Pack the backup"
    local pack=(tar -czf -) seal=(cat)
    (( history )) || pack+=(--exclude=.git)
    pack+=(-C "$stage" folio-backup.txt key.asc -C "$(dirname "$store")" "${store##*/}")
    if (( encrypt )); then
        seal=(gpg --symmetric --compress-algo none --output -)
        [[ -n $passphrase ]] && seal=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${seal[@]:1}")
        (( ! FRESH_PASSPHRASE )) || seal=(gpg --no-symkey-cache "${seal[@]:1}")
    fi
    # The passphrase reaches gpg on fd 3 (printf is a builtin: never in argv). COPYFILE_DISABLE
    # keeps macOS tar from adding ._ files.
    COPYFILE_DISABLE=1 "${pack[@]}" | "${seal[@]}" > "$file.partial" 3< <(printf '%s\n' "$passphrase")
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Packing the backup failed."
    unset passphrase
    mv "$file.partial" "$file" || die "Cannot write $file."
    show-answer "File" "$file"

    local lines=(
        "Your EnvFolio store is backed up."
        ""
        "File:      $(tilde-path "$file")"
        "Key:       ${keys[0]}"
        "History:   $( (( history )) && echo "included" || echo "not included (add --history)" )"
        "Encrypted: $( (( encrypt )) && echo "yes" || echo "no (add --encrypt)" )"
        ""
        "To restore it, here or on a new machine:"
        "  folio restore $file"
        "That needs the key's passphrase$( (( encrypt )) && echo ", and the backup's own" )$(
            has-pqc-key "$stage/key.asc" && echo ", and gpg 2.5.21 or later (the key is post-quantum)")."
        "Keep the file somewhere safe and offline."
    )
    echo ""
    show-box "${lines[@]}"
}

# --- restore ------------------------------------------------------------------

function store-restore-usage() {
    echo "Usage: folio restore [--file-passphrase-stdin|--file-passphrase-fd <n>] [--allow-unsafe-folder] <file>"
}

function restore-help() {
    store-restore-usage
    cat <<'EOF'

Bring back an EnvFolio store from a file made by `folio backup`: import its GPG key
(trusted as your own), and put the store at $FOLIO_STORE_DIR (default ~/.folio). A backup
without its git history starts a new one. Refuses when $FOLIO_STORE_DIR is a folder with anything
in it. An existing empty folder is used as it is (a folder made here is private, 700); when it is
someone else's or other users can get in, EnvFolio warns and asks before using it.

Options:
  --file-passphrase-stdin
                      Read the passphrase of an encrypted backup (--folio.gpg) from the first
                      line of stdin, instead of gpg's prompt.
  --file-passphrase-fd <n>
                      The same, from the first line of file descriptor <n>, e.g.
                      --file-passphrase-fd 3 3< pass.txt.
  --allow-unsafe-folder
                      Use an existing empty folder that is someone else's or open to other users
                      without asking (still with the warning).
  -h, --help          Show this help.
EOF
}

# folio restore [--file-passphrase-stdin|--file-passphrase-fd <n>] [--allow-unsafe-folder] <file>
Restore() {
    local passphrase_stdin=0 passphrase_fd="" allow_unsafe=0 file=""
    while (( $# > 0 )); do
        case $1 in
            --file-passphrase-stdin) passphrase_stdin=1 ;;
            --file-passphrase-fd)
                [[ $# -gt 1 && -n $2 ]] || die "$1 needs a value."
                passphrase_fd=$2 ; shift ;;
            --file-passphrase-fd=*) passphrase_fd=${1#*=} ;;
            --allow-unsafe-folder) allow_unsafe=1 ;;
            -h|--help)          restore-help ; return 0 ;;
            -*) die "restore: unknown option: $1${EXTRA_LINE}$(store-restore-usage)" ;;
            *)  [[ -z $file ]] || die "restore: one file only.${EXTRA_LINE}$(store-restore-usage)"
                file=$1 ;;
        esac
        shift
    done
    [[ -n $file ]] || die "$(store-restore-usage)"
    [[ -f $file ]] || die "There is no file $file."
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--file-passphrase-stdin and --file-passphrase-fd cannot be used together."
    fi
    [[ -z $passphrase_fd ]] || check-passphrase-fd --file-passphrase-fd "$passphrase_fd"

    local open=(cat)
    case $file in
        *"$ENCRYPTED_BACKUP_SUFFIX")
            open=(gpg --decrypt --output -)
            (( passphrase_stdin )) || [[ -n $passphrase_fd ]] \
                && open=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${open[@]:1}")
            (( ! FRESH_PASSPHRASE )) || open=(gpg --no-symkey-cache "${open[@]:1}") ;;
        *"$BACKUP_SUFFIX")
            [[ $passphrase_stdin == 0 && -z $passphrase_fd ]] \
                || die "--file-passphrase-stdin and --file-passphrase-fd are only for an encrypted backup ($ENCRYPTED_BACKUP_SUFFIX)." ;;
        *)  die "$file is not an EnvFolio backup: its name ends in neither $BACKUP_SUFFIX nor $ENCRYPTED_BACKUP_SUFFIX." ;;
    esac
    # An empty folder is as good as none: the store is moved inside it (it may be a mount point),
    # its mode left as it is.
    local into=0
    if [[ -e $STORE_PATH ]]; then
        is-empty-dir "$STORE_PATH" \
            || die "$STORE_PATH already exists. Move it away to restore there, or run with${EXTRA_LINE}    FOLIO_STORE_DIR=<other-folder> $0 restore $file"
        accept-unsafe-store "$allow_unsafe" "$passphrase_stdin"
        into=1
    fi

    local passphrase=""
    if (( passphrase_stdin )); then
        IFS= read -rs passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on stdin."
    elif [[ -n $passphrase_fd ]]; then
        read-passphrase-fd "$passphrase_fd"
        passphrase=$PASSPHRASE
        unset PASSPHRASE
    fi

    # Unpack next to the store's place, so the last step is one rename.
    local target=${STORE_PATH%/} stage
    umask 077
    mkdir -p "$(dirname "$target")" || die "Cannot create $(dirname "$target")."
    stage=$(mktemp -d "$(dirname "$target")/.folio-restore.XXXXXX") || die "Cannot make a temporary folder."
    remove-on-exit "$stage"

    section "Unpack the backup"
    "${open[@]}" < "$file" 3< <(printf '%s\n' "$passphrase") | tar -xzf - -C "$stage"
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Unpacking $file failed."
    unset passphrase

    local field value format="" name="" keys=() key manifest=$stage/folio-backup.txt
    [[ -f $manifest ]] || manifest=$stage/envfolio-backup.txt    # made before 0.4.0, renamed by hand
    [[ -f $manifest ]] || die "$file is not an EnvFolio backup: it has no folio-backup.txt."
    while read -r field value; do
        case $field in
            folio-backup|envfolio-backup) format=$value ;;
            store)                        name=$value   ;;
            key)                          keys+=("$value") ;;
        esac
    done < "$manifest"
    [[ $format == 1 ]] || die "$file is an EnvFolio backup of a format this EnvFolio cannot read ($format)."
    [[ -n $name && $name != */* && $name != . && $name != .. && -s $stage/$name/.gpg-id ]] \
        || die "$file has no store in it."
    [[ -s $stage/key.asc && ${#keys[@]} -gt 0 ]] || die "$file has no key in it."
    for key in "${keys[@]}"; do
        [[ $key =~ ^[0-9A-F]{40,64}$ ]] || die "$file names a key that is not a fingerprint: $key"
    done
    show-answer "Store" "$name"
    # An older gpg imports a post-quantum key without a word, then cannot decrypt with it.
    if has-pqc-key "$stage/key.asc" && ! gpg-has-pqc; then
        die "This backup's key is post-quantum: restoring it needs gpg 2.5.21 or later" \
            "(this one is $(gpg-version)). Nothing changed."$'\n'"$PQC_GPG_HELP"
    fi

    section "Import the key"
    gpg --batch --quiet --import "$stage/key.asc" || die "Importing the key failed."
    printf '%s:6:\n' "${keys[@]}" | gpg --batch --quiet --import-ownertrust || die "Trusting the key failed."
    for key in "${keys[@]}"; do
        gpg --list-secret-keys "$key" >/dev/null 2>&1 || die "The backup's key.asc has no secret key $key."
    done
    show-answer "Key" "${keys[*]}"

    local uid history="from the backup"
    uid=$(key-uid "${keys[0]}")
    if [[ ! -e $stage/$name/.git ]]; then
        section "Start the store's git history"
        STORE_PATH=$stage/$name PASSWORD_STORE_DIR=$stage/$name start-store-history "$uid"
        history="new (the backup had none)"
    fi

    if (( into )); then
        shopt -s dotglob
        mv "$stage/$name"/* "$target/" || die "Cannot move the store to $target."
        shopt -u dotglob
    else
        mv "$stage/$name" "$target" || die "Cannot move the store to $target."
        chmod 700 "$target"         || die "Cannot make $target private."
    fi

    section "Summary"
    show-box "Your EnvFolio store is restored." \
             "" \
             "Store:   $(tilde-path "$target")" \
             "Key:     ${keys[0]}" \
             "         $uid" \
             "History: $history"
    echo ""
}

# --- export -------------------------------------------------------------------

# An export is one file, always locked: folio-export.txt (what it holds), key.asc (a new key made
# for this export only, with no passphrase — the lock on the file protects it) and store/, a pass
# store of the chosen items encrypted and signed with that key. Secrets go from one key to the
# other through a pipe, never through a file.
EXPORT_SUFFIX=.folio

function store-export-usage() {
    cat <<'EOF'
Usage: folio export [-s|--secrets] [--to <key>|--file-passphrase-stdin|--file-passphrase-fd <n>]
                    [--store-passphrase-fd <n>] [--use <@namespace>]... [--vars <file>]...
                    [-o|--output <file>|<folder>] [<name>...]
EOF
}

function export-help() {
    store-export-usage
    cat <<'EOF'

Copy some items into one file, to bring them into another store with `folio import` — on
a server, in a booth, or on another machine. Your store's key stays here: the items are encrypted
and signed with a new key made for this export only, and the file is locked — with a passphrase,
or with --to, to the public key of where it is going. With neither given, EnvFolio asks which.
gpg may ask for your store key's passphrase to read the secrets.

A <name> is a text or secret, or a folder: every text under it, and its secrets with --secrets.
With --use @app2, every item under @app2 is taken as if @app2/ were not in its path, and the file
has it so: @app2/@prod/server/user goes in as @prod/server/user. The <name>s and --use are laid
in the order typed, and the last one wins where two give the same item. With --vars, the items a
vars file names are taken too. With no <name>, --use or --vars, EnvFolio lists every item and
asks which ones.

The file is <file> (.folio added when missing), or store-<date>.folio in <folder> —
never inside the store. An existing file is never replaced. With no -o, EnvFolio asks, offering
store-<date>.folio in the current folder (taken as it is with --file-passphrase-stdin).

Options:
  -s, --secrets       Take the secrets in a folder, or under a --use, too. A secret named on its
                      own always goes; one a vars file names needs it.
  --to <key>          Lock the file to this public key: a key file (.asc) or a key in your
                      keyring (fingerprint, key id or email). Only its secret key can open it.
  --file-passphrase-stdin
                      Read the file's passphrase from the first line of stdin, instead of gpg's
                      prompt. Not with --to. Needs a <name> or --vars. An empty passphrase is
                      refused.
  --file-passphrase-fd <n>
                      Read the file's passphrase from the first line of file descriptor <n>,
                      e.g. --file-passphrase-fd 3 3< pass.txt. Not with --to. stdin stays free,
                      so the items can still be picked. An empty passphrase is refused.
  --store-passphrase-fd <n>
                      The store key's passphrase (to read the secrets), from the first line of
                      file descriptor <n>, instead of gpg's prompt.
  --use <@namespace>  Take every item under <@namespace> (e.g. @app2, or @app2/@prod), named
                      without it; its secrets with --secrets. Can be given more than once.
                      Experimental: it may change in a later version.
  --vars <file>       Take the items a vars file names (the one `folio exec --vars` reads), to
                      run the same command with `folio exec --from`: every @{…} in it, also one
                      in a fallback (left out, with a note, when it is not there). Any secret in
                      it needs --secrets. Can be given more than once.
  -o, --output <file>|<folder>
                      Where to write the file.
  -h, --help          Show this help.
EOF
}

# folio export [-s|--secrets] [--to <key>|--file-passphrase-stdin|--file-passphrase-fd <n>]
#              [--store-passphrase-fd <n>] [-o|--output <file>|<folder>] [<name>...]
# Anything not given is asked for: the items, and how to lock the file.
Export() {
    # Process the command-line options
    # layers: the <name>s and --use (--use=<@namespace>) in the order typed, for make-view.
    local secrets=0 to="" passphrase_stdin=0 passphrase_fd="" target="" names=() uses=() layers=() vars_files=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -s|--secrets)       secrets=1 ;;
            --to|-o|--output|--file-passphrase-fd|--vars|--use)
                                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                                case $arg in
                                    --to)                 to=$1 ;;
                                    --file-passphrase-fd) passphrase_fd=$1 ;;
                                    --vars)               read-vars-file export "$1" ; vars_files+=("$1") ;;
                                    --use)                uses+=("${1%/}") ; layers+=("--use=${1%/}") ;;
                                    *)                    target=$1 ;;
                                esac
                                shift ;;
            --vars=*)           read-vars-file export "${arg#*=}" ; vars_files+=("${arg#*=}") ;;
            --use=*)            arg=${arg#--use=} ; uses+=("${arg%/}") ; layers+=("--use=${arg%/}") ;;
            --to=*)             to=${arg#*=} ;;
            --output=*)         target=${arg#*=} ;;
            --file-passphrase-fd=*)  passphrase_fd=${arg#*=} ;;
            --file-passphrase-stdin) passphrase_stdin=1 ;;
            -h|--help)          export-help ; return 0 ;;
            --)                 names+=("$@") ; layers+=("$@") ; break ;;
            -*)                 die "export: unknown option: $arg${EXTRA_LINE}$(store-export-usage)" ;;
            *)                  names+=("$arg") ; layers+=("$arg") ;;
        esac
    done
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--file-passphrase-stdin and --file-passphrase-fd cannot be used together."
    fi
    [[ -z $to ]] || { (( ! passphrase_stdin )) && [[ -z $passphrase_fd ]] ; } \
        || die "--file-passphrase-stdin and --file-passphrase-fd are for a passphrase; a file locked --to needs none."
    (( ! passphrase_stdin || ${#names[@]} + ${#uses[@]} + ${#vars_files[@]} > 0 )) \
        || die "--file-passphrase-stdin needs the items named (or --use, --vars): stdin cannot also answer which ones."
    [[ -z $passphrase_fd ]] || check-passphrase-fd --file-passphrase-fd "$passphrase_fd"
    require-store

    section "Overview"
    cat >&2 <<'EOF'
This copies some items into one file, to bring them into another store with `folio import`.
The items are encrypted and signed with a new key made for this export only; your store's key
stays here. The file is locked with a passphrase, or to the public key of where it is going.
It needs:
  - The items to export.
  - Where to write the file.
  - How to lock it.
gpg may ask for your store key's passphrase to read the secrets.
EOF

    section "Parameters"

    # Input: the store — FOLIO_STORE_DIR, default ~/.folio (see STORE_PATH at the top)
    show-answer "Store path" "$(tilde-path "$STORE_PATH")"

    # Input: the items — the <name>s (a folder's secrets too with --secrets), the ones under each
    # --use, named with it peeled off, and the ones the vars files name; or with none of them,
    # picked from a list. With a --use, all are read from a view (make-view): the store with the
    # <name>s and --use laid over it in the order typed, the last one winning. The file has them
    # as they are named there.
    local item texts=0 use
    make-view export "$secrets" ${layers[@]+"${layers[@]}"}
    if (( ${#vars_files[@]} == 0 && ${#uses[@]} == 0 )); then
        select-items export "$STORE_PATH" "$secrets" 0 "${names[@]}"
    else
        if (( ${#uses[@]} > 0 )); then
            show-answer "Use" "$(printf '%s ' "${uses[@]}")"
        fi
        if (( ${#vars_files[@]} > 0 )); then
            local vars_list
            vars_list=$(printf ', %s' "${vars_files[@]}")
            show-answer "Vars files" "${vars_list#, }"
        fi
        # The <name>s first, as select-items takes them; then each --use's; then each item the vars
        # files name — each item once.
        SELECTED=()
        if (( ${#names[@]} > 0 )); then
            select-items export "$STORE_PATH" "$secrets" 0 "${names[@]}"
        fi
        for use in ${uses[@]+"${uses[@]}"}; do
            used-items export "$secrets" "$use"
            select-more "${USED_ITEMS[@]}"
        done
        if (( ${#vars_files[@]} > 0 )); then
            vars-items export "$secrets"
            select-more ${VARS_ITEMS[@]+"${VARS_ITEMS[@]}"}
        fi
        (( ${#SELECTED[@]} > 0 )) || die "export: the vars files name no item that is there."
    fi
    for item in "${SELECTED[@]}"; do [[ $item == *.gpg ]] || texts=$(( texts + 1 )) ; done
    show-answer "Items" "${#SELECTED[@]} (texts: $texts, secrets: $(( ${#SELECTED[@]} - texts )))"
    for item in "${SELECTED[@]}"; do printf '    %s\n' "$(item-label "$item")" >&2 ; done

    # Input: the file — -o <file>|<folder>; otherwise asked, offering a new file in the current
    # folder (taken as it is when stdin carries the passphrase, so cannot answer).
    local file=$target
    if [[ -z $file ]]; then
        file=./store-$(date +%Y%m%d)$EXPORT_SUFFIX
        if (( ! passphrase_stdin )); then
            file=$(ask-path "File (or a folder)" "" "$file") || exit 1
        fi
    fi
    [[ -d $file ]] && file=${file%/}/store-$(date +%Y%m%d)$EXPORT_SUFFIX
    [[ $file == *"$EXPORT_SUFFIX" ]] || file+=$EXPORT_SUFFIX
    [[ ! -e $file ]]            || die "$file already exists."
    [[ -d $(dirname "$file") ]] || die "There is no folder $(dirname "$file")."
    [[ $(cd "$(dirname "$file")" && pwd -P)/ != "$(cd "${VIEW_SOURCE:-$STORE_PATH}" && pwd -P)"/* ]] \
        || die "$file is inside the store; write the export somewhere else."
    show-answer "File" "$(tilde-path "$file")"

    # Input: the lock — --to <key>, or a passphrase (--file-passphrase-stdin / --file-passphrase-fd);
    # with neither, asked: a passphrase (gpg asks for it later), or a public key.
    local choice to_key="With a public key"
    if [[ -z $to && -z $passphrase_fd ]] && (( ! passphrase_stdin )); then
        echo >&2
        choice=$(ask-choice "How should the file be locked?" "With a passphrase" "$to_key") \
            || die "Cancelled."
        if [[ $choice == "$to_key" ]]; then
            to=$(pick-public-key) || exit 1
            [[ -n $to ]] \
                || to=$(ask-path "Public key" "a .asc file, or a fingerprint, key id or email") || exit 1
            [[ -n $to ]] || die "A public key is needed to lock the file to it."
        fi
    fi

    umask 077
    local stage home pack status key recipient="" passphrase=""
    stage=$(mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$stage" "$file.partial"
    home=$stage/home pack=$stage/pack
    new-gpg-home "$home"
    mkdir -p "$pack/store"

    if [[ -n $to ]]; then
        # Into the export's own keyring only: a key file never lands in yours.
        if [[ -f $to ]]; then GNUPGHOME=$home gpg --batch --quiet --import "$to"
        else gpg --export -- "$to" | GNUPGHOME=$home gpg --batch --quiet --import
        fi 2>/dev/null
        recipient=$(GNUPGHOME=$home gpg --list-keys --with-colons 2>/dev/null \
            | awk -F: '$1 == "pub" { p = 1 } $1 == "fpr" && p { p = 0 ; print $10 }')
        [[ -n $recipient ]]                || die "No public key found in or for '$to'."
        [[ $recipient != *$'\n'* ]]        || die "'$to' holds or matches more than one key; give one by its fingerprint."
        show-answer "Lock" "to $recipient $(GNUPGHOME=$home key-uid "$recipient")"
    else
        if (( passphrase_stdin )); then
            IFS= read -rs passphrase || true
            [[ -n $passphrase ]] || die "No passphrase on stdin."
        elif [[ -n $passphrase_fd ]]; then
            read-passphrase-fd "$passphrase_fd"
            passphrase=$PASSPHRASE
            unset PASSPHRASE
        fi
        if [[ -n $passphrase ]]; then
            show-answer "Lock" "a passphrase: ************"
        else
            show-answer "Lock" "a passphrase: gpg asks for it when it locks the file"
        fi
    fi

    section "Exporting"
    info "That is everything needed. Exporting now." >&2

    section "Make the export's own key"
    status=$(GNUPGHOME=$home gpg --batch --passphrase '' --status-fd 3 \
                 --quick-generate-key "EnvFolio export $(date +%Y%m%d-%H%M%S)" default default never 3>&1 1>/dev/null 2>/dev/null)
    key=$(printf '%s\n' "$status" | awk '$2 == "KEY_CREATED" { print $4 }')
    [[ -n $key ]] || die "Making the export's key failed."
    echo "$key" > "$pack/store/.gpg-id"
    show-answer "Key" "$key"

    section "Copy the items (gpg may ask for your store key's passphrase)"
    local name out
    for item in "${SELECTED[@]}"; do
        name=${item%.*} out=$pack/store/$item
        mkdir -p "$(dirname "$out")"
        if [[ $item == *.gpg ]]; then
            pass show -- "$name" \
                | GNUPGHOME=$home gpg --batch --quiet --trust-model always --compress-algo none \
                      --encrypt --recipient "$key" --output "$out"
            [[ ${PIPESTATUS[*]} == "0 0" ]] || die "export: could not copy '$name'."
        else
            verify-text "$name"
            cp "$STORE_PATH/$item" "$out"
            GNUPGHOME=$home gpg --batch --quiet --local-user "$key" --detach-sign --output "$out.sig" "$out" \
                || die "export: could not sign '$name'."
        fi
        show-answer "Copied" "$(item-label "$item")"
    done
    GNUPGHOME=$home gpg --batch --armor --export-secret-keys "$key" > "$pack/key.asc" 2>/dev/null
    [[ -s $pack/key.asc ]] || die "Exporting the export's key failed."
    {
        echo "folio-export 1"
        echo "created $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "key $key"
    } > "$pack/folio-export.txt"

    section "Pack and lock the file"
    if [[ -z $recipient && -z $passphrase ]]; then
        acknowledge "Next, gpg will ask you to choose a passphrase for the export file (twice)." \
                    "Whoever imports the file needs it: tell them another way than the file itself." \
                    "" \
                    "Be prepared to provide the new passphrase."
    fi
    local seal=(gpg --symmetric --compress-algo none --output -)
    [[ -n $passphrase ]] && seal=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${seal[@]:1}")
    (( ! FRESH_PASSPHRASE )) || seal=(gpg --no-symkey-cache "${seal[@]:1}")
    [[ -n $recipient ]] && seal=(env GNUPGHOME="$home" gpg --batch --trust-model always --compress-algo none
                                 --encrypt --recipient "$recipient" --output -)
    # As in backup: the passphrase reaches gpg on fd 3, never in argv.
    COPYFILE_DISABLE=1 tar -czf - -C "$pack" folio-export.txt key.asc store \
        | "${seal[@]}" > "$file.partial" 3< <(printf '%s\n' "$passphrase")
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Packing the export failed."
    unset passphrase
    mv "$file.partial" "$file" || die "Cannot write $file."
    show-answer "File" "$file"

    local lock="a passphrase" opens="the file's passphrase"
    if [[ -n $recipient ]]; then
        lock="to $recipient"
        opens="the secret key of $(GNUPGHOME=$home key-uid "$recipient")"
        [[ $(GNUPGHOME=$home key-kind "$recipient") != post-quantum* ]] \
            || opens+=", and gpg 2.5.21 or later (the key is post-quantum)"
    fi
    local box=("Your items are exported."
               ""
               "File:   $(tilde-path "$file")"
               "Items:  ${#SELECTED[@]} (texts: $texts, secrets: $(( ${#SELECTED[@]} - texts )))"
               "Locked: $lock"
               ""
               "To bring them into a store (a new one, or one that is there):"
               "  folio import $file")
    # With --vars: how to run the command there, with the same vars files, straight from the file.
    if (( ${#vars_files[@]} > 0 )); then
        local exec_line="  folio exec" vars_file
        (( texts == ${#SELECTED[@]} )) || exec_line+=" -s"
        exec_line+=" --from $file"
        for vars_file in "${vars_files[@]}"; do exec_line+=" --vars $vars_file" ; done
        box+=("" "Or to run a command with them, with the same vars file(s), no store needed:")
        box+=("$exec_line -- <command>")
    fi
    box+=("That needs $opens.")
    echo ""
    show-box "${box[@]}"
}

# --- import -------------------------------------------------------------------

function store-import-usage() {
    cat <<'EOF'
Usage: folio import [-a|--all] [--overwrite|--skip-existing] [--key <id>]
                    [--file-passphrase-stdin|--file-passphrase-fd <n>] [--store-passphrase-fd <n>]
                    [--allow-unsafe-folder] [<file> [<name>...]]
EOF
}

function import-help() {
    store-import-usage
    cat <<'EOF'

Bring items from a file made by `folio export` into the EnvFolio store
($FOLIO_STORE_DIR, default ~/.folio): the secrets are encrypted to the store's key, the texts
checked and signed with it (gpg may ask for its passphrase). With no store yet, one is made first,
as `folio init` does: its key is asked for here, before anything is made. The export's key
is used here only, never added to your keyring.

With no <file>, EnvFolio asks for it. A <name> is an item in the export, or a folder: every item
under it. With neither <name> nor --all, EnvFolio lists the export's items and asks which ones. An
item already in the store is overwritten or skipped, as the options say; otherwise EnvFolio asks.

Options:
  -a, --all           Take every item in the export.
  --overwrite         Replace the items already in the store.
  --skip-existing     Keep the items already in the store; take only the new ones.
  --key <id>          With no store yet: make it with this key, as `folio init --key`.
  --file-passphrase-stdin
                      Read the file's passphrase (or your key's, for a file locked to it) from the
                      first line of stdin. Needs <file>, and --all or a <name>; with no store
                      yet, --key too.
  --file-passphrase-fd <n>
                      The same, from the first line of file descriptor <n>, e.g.
                      --file-passphrase-fd 3 3< pass.txt. stdin stays free, so anything not given
                      is still asked for.
  --store-passphrase-fd <n>
                      The store key's passphrase (to sign the texts), from the first line of file
                      descriptor <n>, instead of gpg's prompt. With no store yet and a new key
                      made for it, that new key's passphrase.
  --allow-unsafe-folder
                      Use a store folder that is someone else's or open to other users without
                      asking (still with the warning).
  -h, --help          Show this help.
EOF
}

# folio import [-a|--all] [--overwrite|--skip-existing] [--key <id>]
#              [--file-passphrase-stdin|--file-passphrase-fd <n>] [--store-passphrase-fd <n>]
#              [--allow-unsafe-folder] [<file> [<name>...]]
# Anything not given is asked for: the file, a new store's key, the items, what to do with clashes.
Import() {
    # Process the command-line options
    local all=0 clash="" key_id="" passphrase_stdin=0 passphrase_fd="" allow_unsafe=0 file="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -a|--all)           all=1 ;;
            --overwrite)        clash=overwrite ;;
            --skip-existing)    clash=skip ;;
            --key|--file-passphrase-fd)
                                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                                if [[ $arg == --key ]]; then key_id=$1 ; else passphrase_fd=$1 ; fi
                                shift ;;
            --key=*)            key_id=${arg#*=} ;;
            --file-passphrase-fd=*)  passphrase_fd=${arg#*=} ;;
            --file-passphrase-stdin) passphrase_stdin=1 ;;
            --allow-unsafe-folder) allow_unsafe=1 ;;
            -h|--help)          import-help ; return 0 ;;
            -*) die "import: unknown option: $arg${EXTRA_LINE}$(store-import-usage)" ;;
            *)  if [[ -z $file ]]; then file=$arg ; else names+=("$arg") ; fi ;;
        esac
    done
    (( ! all || ${#names[@]} == 0 )) || die "--all takes every item; give no <name> with it."
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--file-passphrase-stdin and --file-passphrase-fd cannot be used together."
    fi
    # stdin carries the passphrase, so it cannot also answer the questions.
    if (( passphrase_stdin )); then
        [[ -n $file ]] || die "--file-passphrase-stdin needs the file given: stdin cannot also answer which one."
        (( all || ${#names[@]} > 0 )) \
            || die "--file-passphrase-stdin needs --all or the items named: stdin cannot also answer which ones."
    fi
    [[ -z $passphrase_fd ]] || check-passphrase-fd --file-passphrase-fd "$passphrase_fd"
    [[ -z $file ]] || check-export-file "$file"
    # The store's folder: one there is, or none yet (missing, or an empty folder) to make one in.
    local status=0 new_store=0
    store-exists || status=$?
    if (( status == 2 )) && ! is-empty-dir "$STORE_PATH"; then
        die "$STORE_PATH exists but is not a ready EnvFolio store" \
            "(maybe an earlier \`folio init\` did not finish)." \
            "Remove it and run again, or run with${EXTRA_LINE}    FOLIO_STORE_DIR=<other-folder>"
    fi
    (( status == 0 )) || new_store=1
    (( new_store )) || [[ -z $key_id ]] || die "--key is only for making a new store, and $STORE_PATH is one already."
    if (( new_store && passphrase_stdin )) && [[ -z $key_id ]]; then
        die "--file-passphrase-stdin with no store yet needs --key: stdin cannot also answer which key."
    fi

    section "Overview"
    cat >&2 <<'EOF'
This brings items from a file made by `folio export` into your EnvFolio store. With no
store yet, one is made first. It needs:
  - The export file, and what opens it: its passphrase, or your key it is locked to.
  - The items to take.
  - The store: the one there is, or the key for a new one.
  - What to do with the items already in the store.
gpg may ask for your store key's passphrase to sign the texts.
EOF

    section "Parameters"

    # Input: the export file — <file>, or asked.
    [[ -n $file ]] || file=$(ask-path "Export file" "a .folio file") || exit 1
    [[ -n $file ]] || die "An export file is needed."
    check-export-file "$file"
    show-answer "File" "$(tilde-path "$file")"

    # Input: what opens the file — its passphrase (--file-passphrase-stdin / --file-passphrase-fd,
    # or gpg asks), or your key it is locked to (gpg may ask for that key's passphrase).
    local passphrase=""
    if (( passphrase_stdin )); then
        IFS= read -rs passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on stdin."
    elif [[ -n $passphrase_fd ]]; then
        read-passphrase-fd "$passphrase_fd"
        passphrase=$PASSPHRASE
        unset PASSPHRASE
    fi

    if [[ -z $passphrase ]] && is-passphrase-locked "$file"; then
        acknowledge "Next, gpg asks for the export file's passphrase: the one chosen when it was exported."
    fi
    open-export "$file" "$passphrase"
    unset passphrase
    local home=$EXPORT_HOME root=$EXPORT_ROOT
    show-answer "Opened" "the export's key is $EXPORT_KEY"

    # Input: the items — --all, the <name>s, or picked from a list
    select-items import "$root" 1 "$all" "${names[@]}"
    local item name texts=0
    for item in "${SELECTED[@]}"; do [[ $item == *.gpg ]] || texts=$(( texts + 1 )) ; done
    show-answer "Items" "${#SELECTED[@]} (texts: $texts, secrets: $(( ${#SELECTED[@]} - texts )))"
    for item in "${SELECTED[@]}"; do printf '    %s\n' "$(item-label "$item")" >&2 ; done

    # Every text must be the one the export signed, before anything is written.
    for item in "${SELECTED[@]}"; do
        [[ $item == *.txt ]] || continue
        verify-export-text import "${item%.txt}"
    done

    # Input: the store — FOLIO_STORE_DIR, default ~/.folio (see STORE_PATH at the top). Before
    # anything is written: the store, or the empty folder it is to be made in, must be safe.
    (( status == 1 )) || accept-unsafe-store "$allow_unsafe" "$passphrase_stdin"
    if (( new_store )); then
        show-answer "Store path" "$(tilde-path "$STORE_PATH") — no store yet: one is made first"
    else
        show-answer "Store path" "$(tilde-path "$STORE_PATH")"
    fi

    # Input: a new store's key — --key; otherwise picked from the keyring's secret keys, or a new
    # one from a name and email (asked with a guess). gpg asks a new key's passphrase when it makes it.
    local init_args=() name email
    if (( new_store )); then
        if [[ -n $key_id ]]; then
            key_id=$(find-key "$key_id") || exit 1
        else
            key_id=$(select-key) || exit 1
        fi
        if [[ -n $key_id ]]; then
            show-answer "Store key" "$key_id"
            init_args=(--key "$key_id")
        else
            name=$( ask-text "Your name"  "e.g. Jane Doe"         "$(guess-name)")  || exit 1
            [[ -n $name  ]] || die "A name is needed to create a key."
            email=$(ask-text "Your email" "e.g. jane@example.com" "$(guess-email)") || exit 1
            [[ -n $email ]] || die "An email is needed to create a key."
            init_args=(--name "$name" --email "$email")
            if [[ -n $STORE_PASSPHRASE_FD ]]; then
                show-answer "Store key" "a new one for $name <$email>, its passphrase from --store-passphrase-fd"
                init_args+=(--store-passphrase-fd 4)
            else
                show-answer "Store key" "a new one for $name <$email> — gpg asks for its passphrase"
            fi
        fi
    fi

    # Input: what to do with the items already in the store — --overwrite / --skip-existing, or asked.
    local clashes=()
    for item in "${SELECTED[@]}"; do [[ -f $STORE_PATH/$item ]] && clashes+=("$item") ; done
    if (( ${#clashes[@]} > 0 )); then
        if [[ -z $clash ]]; then
            echo >&2
            echo "Already in the store:" >&2
            for item in "${clashes[@]}"; do printf '    %s\n' "$(item-label "$item")" >&2 ; done
            case $(ask-choice "What to do with these ${#clashes[@]}?" "Overwrite them" "Skip them") in
                Overwrite*) clash=overwrite ;;
                Skip*)      clash=skip ;;
                *)          die "Cancelled." ;;
            esac
        fi
        show-answer "Already in the store" "${#clashes[@]}: $( [[ $clash == skip ]] && echo "skipped" || echo "overwritten" )"
    fi

    section "Importing"
    info "That is everything needed. Importing now." >&2

    if (( new_store )); then
        section "Make the store"
        # A new key's passphrase reaches Init on fd 4 (printf is a builtin: never in argv); it is
        # kept for require-store, which unlocks the new key with it.
        load-store-passphrase
        Init "${init_args[@]}" 4< <(printf '%s\n' "$STORE_PASSPHRASE")
    fi
    require-store

    section "Import the items (gpg may ask for your store key's passphrase)"
    local secrets=0 skipped=0
    texts=0
    for item in "${SELECTED[@]}"; do
        name=${item%.*}
        if [[ -f $STORE_PATH/$item && $clash == skip ]]; then
            skipped=$(( skipped + 1 ))
            continue
        fi
        if [[ $item == *.gpg ]]; then
            # pass encrypts to the store's key(s) and commits, as for any secret it is given.
            GNUPGHOME=$home gpg --batch --quiet --decrypt "$root/$item" 2>/dev/null \
                | pass insert --multiline --force -- "$name" >/dev/null
            [[ ${PIPESTATUS[*]} == "0 0" ]] || die "import: could not import '$name'."
            secrets=$(( secrets + 1 ))
        else
            save-text "$name" "Import text for $name." < "$root/$item"
            texts=$(( texts + 1 ))
        fi
        show-answer "Imported" "$(item-label "$item")"
    done

    echo ""
    show-box "Your items are imported." \
             "" \
             "Store:   $(tilde-path "$STORE_PATH")" \
             "Texts:   $texts" \
             "Secrets: $secrets" \
             "Skipped: $skipped (already in the store)"
}

# open-export <file> <passphrase> [quiet]: unpack an export into a private temporary folder, its key into
# a GnuPG home of its own (never your keyring); both are removed when EnvFolio exits. Sets
# EXPORT_HOME, EXPORT_ROOT (its items, laid out like a store) and EXPORT_KEY. An empty
# <passphrase> leaves opening to gpg: it asks for the file's passphrase, or uses your key the file
# is locked to. With quiet, gpg says only what goes wrong.
function open-export() {
    local file=$1 passphrase=$2 quiet=${3:-} stage
    umask 077
    stage=$(mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$stage"
    EXPORT_HOME=$stage/home EXPORT_ROOT=$stage/unpack/store
    new-gpg-home "$EXPORT_HOME"
    mkdir "$stage/unpack"
    # An older gpg cannot open a file locked to a post-quantum key, and says only "No secret key".
    if has-pqc-key "$file" && ! gpg-has-pqc; then
        die "$file is locked to a post-quantum key: opening it needs gpg 2.5.21 or later" \
            "(this one is $(gpg-version))."$'\n'"$PQC_GPG_HELP"
    fi

    local open=(gpg --decrypt --output -)
    [[ -n $quiet ]] && open=(gpg --quiet "${open[@]:1}")
    [[ -n $passphrase ]] && open=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${open[@]:1}")
    (( ! FRESH_PASSPHRASE )) || open=(gpg --no-symkey-cache "${open[@]:1}")
    # The passphrase reaches gpg on fd 3 (printf is a builtin: never in argv).
    "${open[@]}" < "$file" 3< <(printf '%s\n' "$passphrase") | tar -xzf - -C "$stage/unpack"
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Opening $file failed."
    unset passphrase

    local field value format="" key="" manifest=$stage/unpack/folio-export.txt
    [[ -f $manifest ]] || manifest=$stage/unpack/envfolio-export.txt    # made before 0.4.0, renamed by hand
    [[ -f $manifest ]] || die "$file is not an EnvFolio export: it has no folio-export.txt."
    while read -r field value; do
        case $field in
            folio-export|envfolio-export) format=$value ;;
            key)                          key=$value    ;;
        esac
    done < "$manifest"
    [[ $format == 1 ]]                 || die "$file is an EnvFolio export of a format this EnvFolio cannot read ($format)."
    [[ $key =~ ^[0-9A-F]{40,64}$ ]]    || die "$file names a key that is not a fingerprint: $key"
    [[ -s $stage/unpack/key.asc && -d $EXPORT_ROOT ]] || die "$file has no key or no items in it."
    GNUPGHOME=$EXPORT_HOME gpg --batch --quiet --import "$stage/unpack/key.asc" 2>/dev/null
    GNUPGHOME=$EXPORT_HOME gpg --list-secret-keys "$key" >/dev/null 2>&1 || die "$file has no secret key $key."
    can-use-imported-key "$EXPORT_HOME" "$key" \
        || die "This gpg ($(gpg-version)) cannot use the key in $file: gpg 2.5.23 and 2.5.24, as" \
               "released, cannot decrypt with a key they imported without a passphrase, as an" \
               "export's is (https://dev.gnupg.org/T8469). Use a gpg with the fix — Homebrew's," \
               "2.4, or a later 2.5. Nothing changed."$'\n'"$PQC_GPG_HELP"
    EXPORT_KEY=$key
}

# can-use-imported-key <gnupg-home> <key>: whether gpg decrypts with <key>, a secret key just imported
# into <gnupg-home> — by encrypting a word to it and decrypting that. gpg 2.5.23 and 2.5.24 as
# released cannot, for a key without a passphrase (https://dev.gnupg.org/T8469); Homebrew's can.
function can-use-imported-key() {
    printf 'folio\n' | GNUPGHOME=$1 gpg --batch --quiet --trust-model always --encrypt --recipient "$2" 2>/dev/null \
        | GNUPGHOME=$1 gpg --batch --quiet --decrypt 2>/dev/null | grep -qx folio
}

# verify-export-text <how> <name> [<root>]: die unless the text <name> in the opened export — or
# under <root>, a view of it — is the one the export signed.
function verify-export-text() {
    local signer item=${3:-$EXPORT_ROOT}/$2.txt
    signer=$(GNUPGHOME=$EXPORT_HOME gpg --status-fd 1 --verify "$item.sig" "$item" 2>/dev/null \
                | awk '$2 == "VALIDSIG" { print $NF }')
    [[ $signer == "$EXPORT_KEY" ]] || die "$1: the signature of '$2' in the export does not verify."
}

# check-export-file <file>: die unless <file> is there and named as an export.
function check-export-file() {
    [[ -f $1 ]] || die "There is no file $1."
    [[ $1 == *"$EXPORT_SUFFIX" ]] || die "$1 is not an EnvFolio export: its name does not end in $EXPORT_SUFFIX."
}

# is-passphrase-locked <file>: whether an export is locked with a passphrase, not to a key — its first
# OpenPGP packet is a symmetric-key session key (tag 3: 0x8c-0x8f old format, 0xc3 new).
function is-passphrase-locked() {
    case $(od -An -tx1 -N1 "$1" | tr -d ' \n') in
        8c|8d|8e|8f|c3) return 0 ;;
        *)              return 1 ;;
    esac
}

# --- Items: choose some -------------------------------------------------------

# select-more <item>...: add each item file to SELECTED, unless it is there already.
function select-more() {
    local item seen=$'\n'
    for item in ${SELECTED[@]+"${SELECTED[@]}"}; do seen+=$item$'\n' ; done
    for item in "$@"; do
        [[ $seen == *$'\n'"$item"$'\n'* ]] && continue
        SELECTED+=("$item")
        seen+=$item$'\n'
    done
}

# select-items <how> <root> <secrets:0|1> <all:0|1> [<name>...]: set SELECTED to item files
# (<name>.txt, <name>.gpg) under <root>: every one with <all>; else those the names pick — an item
# by its name, or else every item under a folder, its secrets only with <secrets>; else those
# picked from a numbered list.
function select-items() {
    local how=$1 root=$2 secrets=$3 all=$4 items=() taken=$'\n' item name found left answer picks i
    shift 4
    SELECTED=()
    while IFS= read -r item; do items+=("${item#"$root"/}") ; done < <(entries-under 1 "$root")
    (( ${#items[@]} > 0 )) || die "$how: there are no items."

    if (( all )); then
        SELECTED=("${items[@]}")
    elif (( $# > 0 )); then
        for name in "$@"; do
            name=${name%/} found=0 left=0
            [[ -n $name && $name != -* && /$name/ != */../* && /$name/ != */./* ]] \
                || die "$how: '$name' is not a valid name."
            for item in "${items[@]}"; do
                case $item in "$name".txt|"$name".gpg) found=1 ;; *) continue ;; esac
                [[ $taken == *$'\n'"$item"$'\n'* ]] || { SELECTED+=("$item") ; taken+=$item$'\n' ; }
            done
            if (( ! found )); then
                for item in "${items[@]}"; do
                    [[ $item == "$name"/* ]] || continue
                    if [[ $item == *.gpg ]] && (( ! secrets )); then left=$(( left + 1 )) ; continue ; fi
                    found=1
                    [[ $taken == *$'\n'"$item"$'\n'* ]] || { SELECTED+=("$item") ; taken+=$item$'\n' ; }
                done
            fi
            (( found || ! left )) || die "$how: only secrets under '$name' ($left); add --secrets to take them."
            (( found ))           || die "$how: '$name' is not an item or a folder of items."
            (( ! left )) || printf "folio %s: left out %d secret(s) under '%s'; add --secrets to take them.\n" \
                                   "$how" "$left" "$name" >&2
        done
    else
        section "Which items?"
        for (( i = 0; i < ${#items[@]}; i++ )); do
            printf '%4d) %s\n' $(( i + 1 )) "$(item-label "${items[i]}")" >&2
        done
        while :; do
            answer=$(ask-text "Numbers or ranges, e.g. 1 3 5-7, or all") || exit 1
            picks=$(parse-picks "${#items[@]}" "$answer") && break
            echo "Not a choice: '$answer'." >&2
        done
        for i in $picks; do SELECTED+=("${items[i - 1]}") ; done
    fi
}

# parse-picks <count> <answer>: the numbers (1..<count>) an answer like "1 3 5-7" or "all" picks,
# one per line, in order, each once. Fails when it picks nothing or anything out of range.
function parse-picks() {
    local count=$1 words word from to i picked=" "
    IFS=' ,' read -r -a words <<< "$2"
    for word in "${words[@]}"; do
        case $word in
            all)                     from=1 to=$count ;;
            *[!0-9-]*|-*|*-|*-*-*)   return 1 ;;
            *-*)                     from=$(( 10#${word%-*} )) to=$(( 10#${word#*-} )) ;;
            *)                       from=$(( 10#$word )) to=$from ;;
        esac
        (( 1 <= from && from <= to && to <= count )) || return 1
        for (( i = from; i <= to; i++ )); do [[ $picked == *" $i "* ]] || picked+="$i " ; done
    done
    [[ $picked != " " ]] || return 1
    printf '%s' "${picked# }" | tr ' ' '\n' | sort -n
}

# item-label <file>: "(S)<name>" for <name>.gpg, "(T)<name>" for <name>.txt — as
# `folio ls --flat`.
function item-label() {
    case $1 in
        *.gpg) echo "(S)${1%.gpg}" ;;
        *)     echo "(T)${1%.txt}" ;;
    esac
}

#== Command: Text ==============================================================

Text() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        ls)       TextLs        "$@" ;;
        find)     TextFind      "$@" ;;
        grep)     TextGrep      "$@" ;;
        show)     TextShow      "$@" ;;
        insert)   TextInsert    "$@" ;;
        edit)     TextEdit      "$@" ;;
        generate) TextGenerate  "$@" ;;
        rm)       TextRm        "$@" ;;
        mv)       TextMv        "$@" ;;
        cp)       TextCp        "$@" ;;
        "")       echo "Usage: folio text <ls|find|grep|show|insert|edit|generate|rm|mv|cp> [args...]" >&2 ; return 1 ;;
        *)        echo "folio text: unknown command: $category"                                        >&2 ; return 1 ;;
    esac
}

# A text is a plain file in the store, laid out like the secrets: <name>.txt next to <name>.gpg,
# with <name>.txt.sig — a detached signature by the store's key, so a changed text can be told.

# save-text <name> <commit-message> < content: write, sign and commit <name>.txt.
# The text and its signature are written beside the old ones and swapped in only once signing
# worked, so a failed signature leaves the old text as it was.
function save-text() {
    local name=$1 message=$2 file=$STORE_PATH/$1.txt key
    umask "${PASSWORD_STORE_UMASK:-077}"
    key=$(head -n 1 "$STORE_PATH/.gpg-id")
    mkdir -p "$(dirname "$file")"
    cat > "$file.new"
    if ! gpg --quiet --yes --local-user "$key" --detach-sign --output "$file.sig.new" "$file.new"; then
        rm -f "$file.new" "$file.sig.new"
        die "signing failed; nothing was saved."
    fi
    mv "$file.new" "$file" && mv "$file.sig.new" "$file.sig"

    git -C "$STORE_PATH" add -- "$name.txt" "$name.txt.sig"
    git -C "$STORE_PATH" diff --cached --quiet || git -C "$STORE_PATH" commit --quiet -m "$message"
}

# verify-text <name>: die unless <name>.txt.sig is there, matches, and is by the store's key (the
# first in .gpg-id) — i.e. the text was not changed outside EnvFolio. Needs no passphrase.
function verify-text() {
    local name=$1 file=$STORE_PATH/$1.txt store_key signer check
    check="Uncommitted change:  git -C $STORE_PATH diff -- $name.txt${EXTRA_LINE}"
    check+="Its history:         git -C $STORE_PATH log -p -- $name.txt${EXTRA_LINE}"
    check+="If the text is right, sign it again:  folio insert text -f -m $name < $file"
    [[ -f $file.sig ]] || die "'$name' has no signature.${EXTRA_LINE}$check"
    # VALIDSIG's last field is the signing key's primary fingerprint; gpg prints it for a good one only.
    store_key=$(gpg --list-keys --with-colons "$(head -n 1 "$STORE_PATH/.gpg-id")" 2>/dev/null \
        | awk -F: '$1 == "fpr" { print $10; exit }')
    signer=$(gpg --status-fd 1 --verify "$file.sig" "$file" 2>/dev/null | awk '$2 == "VALIDSIG" { print $NF }')
    [[ -n $signer && $signer == "$store_key" ]] \
        || die "the signature of '$name' does not verify with the store's key.${EXTRA_LINE}$check"
}

# --- text ls ------------------------------------------------------------------

function text-ls-help() {
    cat <<'EOF'
Usage: folio ls text [--flat] [--plain] [<subfolder>]

List the texts in the EnvFolio store as a tree — names only. Give a subfolder to list only what is
under it.

Options:
      --flat          Full names, one per line, sorted, instead of a tree.
      --plain         No colour, even on a screen.
  -h, --help          Show this help and stop.
EOF
}

# folio ls text [<subfolder>]
# As `ls secret`: `pass ls`, for the texts. Only a folder; a text is shown by `show text`.
TextLs() {
    case ${1:-} in -h|--help) text-ls-help ; return 0 ;; esac
    require-store
    list-store txt "Text Store" "ls text" "$@"
}

# --- text find ----------------------------------------------------------------

function text-find-help() {
    cat <<'EOF'
Usage: folio find text [--plain] <part>...

List the texts whose names contain any of the parts (ignoring case), as a tree — names only.

Options:
      --plain         No colour, even on a screen.
  -h, --help          Show this help and stop.
EOF
}

# folio find text [--plain] <part>...
# As `find secret`: `pass find`, for the texts.
TextFind() {
    local arg terms
    local parts=()
    for arg in "$@"; do
        case $arg in
            -h|--help) text-find-help ; return 0 ;;
            --plain)   PLAIN=1 ;;
            *)         parts+=("$arg") ;;
        esac
    done
    set -- ${parts[@]+"${parts[@]}"}
    (( $# > 0 )) || die "Usage: folio find text [--plain] <part>..."
    require-store
    terms="*$(printf '%s*|*' "$@")"
    printf 'Search Terms: %s\n' "$*"
    store-tree txt "$STORE_PATH" -P "${terms%|*}" --matchdirs --ignore-case
}

# --- text grep ----------------------------------------------------------------

function text-grep-help() {
    cat <<'EOF'
Usage: folio grep text [<grep-option>...] <pattern>

Print the lines of every text that match <pattern>, under each text's name.

Options:
  <grep-option>       Any option of grep, e.g. -i to ignore case, -v to invert the match.
  -h, --help          Show this help and stop (not grep's -h).
EOF
}

# folio grep text [<grep-option>...] <pattern>
# As `pass grep`, over the texts: the same loop, reading each .txt instead of decrypting a .gpg.
TextGrep() {
    local arg file found dir
    for arg in "$@"; do case $arg in --) break ;; -h|--help) text-grep-help ; return 0 ;; esac ; done
    (( $# > 0 )) || die "Usage: folio grep text [<grep-option>...] <pattern>"
    require-store
    while IFS= read -r -d '' file; do
        found=$(grep --color=always "$@" < "$file") || continue
        file=${file%.txt} ; file=${file#"$STORE_PATH"/}
        dir="${file%/*}/" ; [[ $dir == "$file/" ]] && dir=""
        printf '\e[94m%s\e[1m%s\e[0m:\n' "$dir" "${file##*/}"
        printf '%s\n' "$found"
    done < <(find -L "$STORE_PATH" -path '*/.git' -prune -o -name '*.txt' -print0)
}

# --- text show ----------------------------------------------------------------

function text-show-help() {
    cat <<'EOF'
Usage: folio show text [-c|--clip[=<line>]] <name>

Show a text: check its signature, then print it. A text whose signature is missing, does not
match, or is not by the store's key is not shown — it was changed outside EnvFolio.
With --clip, copy its first line to the clipboard instead. A text is not a secret, so the
clipboard is not cleared afterwards.

Options:
  -c, --clip[=<line>] Copy the first line — or line <line> — to the clipboard; print nothing.
  -h, --help          Show this help and stop.
EOF
}

# folio show text [-c|--clip[=<line>]] <name>
# Only a text that verifies is shown: signed (<name>.txt.sig) by the store's key, unchanged since.
# --clip picks a line as `pass show --clip` does.
TextShow() {
    local clip="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)  text-show-help ; return 0 ;;
            -c|--clip)  clip=1 ;;
            -c[0-9]*)   clip=${arg#-c} ;;
            --clip=*)   clip=${arg#*=} ;;
            --)         names+=("$@") ; break ;;
            -*)         die "show text: unknown option: $arg" ;;
            *)          names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 )) || die "Usage: folio show text [-c|--clip[=<line>]] <name>"
    local name=${names[0]} line copy
    [[ $name != -* && /$name/ != */../* ]] || die "show text: '$name' is not a valid name."
    [[ -z $clip || $clip =~ ^[1-9][0-9]*$ ]] || die "show text: '$clip' is not a line number."
    require-store
    [[ -f $STORE_PATH/$name.txt ]] || die "show text: '$name' is not a text in the store."
    verify-text "$name"
    [[ -n $clip ]] || { cat "$STORE_PATH/$name.txt" ; return ; }

    line=$(tail -n "+$clip" "$STORE_PATH/$name.txt" | head -n 1)
    [[ -n $line ]] || die "show text: '$name' has no text at line $clip."
    # The same tool ensure-requirements checks for.
    if   [[ $(uname -s) == Darwin    ]]; then copy=(pbcopy)
    elif [[ -n ${WAYLAND_DISPLAY:-}  ]]; then copy=(wl-copy)
    elif [[ -n ${DISPLAY:-}          ]]; then copy=(xclip -selection clipboard)
    else die "show text: no clipboard: no X11 or Wayland display."
    fi
    # stdout away: a clipboard tool that stays to serve the copy must not hold `$(folio ...)`
    # open.
    printf '%s' "$line" | "${copy[@]}" >/dev/null || die "show text: could not copy to the clipboard."
    echo "Copied $name to clipboard. A text is not a secret: the clipboard is not cleared."
}

# --- text insert --------------------------------------------------------------

function text-insert-help() {
    cat <<'EOF'
Usage: folio insert text [-m|--multiline] [-f|--force] [-t|--text <text>] [--store-passphrase-fd <n>]
                         <name>

Add a text to the EnvFolio store — kept plain, not encrypted — and sign it with the store's key
(gpg may ask for the key's passphrase). The text is asked for once, with echo; piped in, it is
the first line. Texts are not secrets: never put a secret here.

Options:
  -t, --text <text>   The text itself, instead of asking.
  -m, --multiline     The text is several lines; end it with Ctrl-D. Piped in, all of stdin.
  -f, --force         Overwrite an existing text without asking (only asked at a terminal).
  --store-passphrase-fd <n>
                      The store key's passphrase (to sign), from the first line of file
                      descriptor <n>, instead of gpg's prompt.
  -h, --help          Show this help and stop.
EOF
}

# folio insert text [-m|--multiline] [-f|--force] [-t|--text <text>] <name>
# Like `pass insert`, but the text is written plain and signed, not encrypted.
TextInsert() {
    local multiline=0 force=0 given=0 text="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)      text-insert-help ; return 0 ;;
            -m|--multiline) multiline=1 ;;
            -f|--force)     force=1 ;;
            -t|--text)      (( $# > 0 )) || die "$arg needs a value." ; text=$1 ; given=1 ; shift ;;
            --text=*)       text=${arg#*=} ; given=1 ;;
            --)             names+=("$@") ; break ;;
            -*)             die "insert text: unknown option: $arg" ;;
            *)              names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 )) || die "Usage: folio insert text [-m|--multiline] [-f|--force] [-t|--text <text>] <name>"
    local name=${names[0]} file content
    # As pass's check_sneaky_paths: no way out of the store.
    [[ -n $name && $name != */ && /$name/ != */../* ]] || die "insert text: '$name' is not a valid name."
    require-store
    file=$STORE_PATH/$name.txt

    if [[ -e $file ]] && (( ! force )) && [[ -t 0 ]]; then
        confirm "An entry already exists for $name. Overwrite it?" || exit 1
    fi

    if (( given )); then
        content=$text$'\n'
    elif (( multiline )); then
        [[ -t 0 ]] && printf 'Enter contents of %s and press Ctrl+D when finished:\n\n' "$name" >&2
        content=$(cat ; printf .) ; content=${content%.}   # the dot keeps trailing newlines
    else
        [[ -t 0 ]] && printf 'Enter text for %s: ' "$name" >&2
        IFS= read -r text || [[ -n $text ]] || die "insert text: no text given."
        content=$text$'\n'
    fi

    printf '%s' "$content" | save-text "$name" "Add given text for $name to store."
}

# --- text edit ----------------------------------------------------------------

function text-edit-help() {
    cat <<'EOF'
Usage: folio edit text [--store-passphrase-fd <n>] <name>

Edit a text in $EDITOR (vi if unset), or add it if it is new; then sign and commit it. The text's
signature is checked first: a text changed outside EnvFolio is not opened.

Options:
  --store-passphrase-fd <n>
                      The store key's passphrase (to sign), from the first line of file
                      descriptor <n>, instead of gpg's prompt.
  -h, --help          Show this help and stop.
EOF
}

# folio edit text <name>
# As `pass edit`: edit a copy, keep it only if it changed. A text is checked first, so editing never
# signs a text that was changed outside EnvFolio.
TextEdit() {
    case ${1:-} in -h|--help) text-edit-help ; return 0 ;; esac
    (( $# == 1 )) || die "Usage: folio edit text <name>"
    local name=${1%/} file tmp_dir tmp_file action=Add editor=${EDITOR:-vi}
    [[ -n $name && $name != -* && /$name/ != */../* ]] || die "edit text: '$name' is not a valid name."
    require-store
    file=$STORE_PATH/$name.txt
    tmp_dir=$(mktemp -d)
    remove-on-exit "$tmp_dir"
    tmp_file=$tmp_dir/${name//\//-}.txt

    if [[ -f $file ]]; then
        verify-text "$name"
        cp "$file" "$tmp_file"
        action=Edit
    fi
    # Unquoted, as pass does: EDITOR may carry arguments, e.g. "code --wait".
    # shellcheck disable=SC2086
    $editor "$tmp_file"
    [[ -f $tmp_file ]] || die "Text not saved."
    [[ -f $file ]] && cmp -s "$file" "$tmp_file" && die "Text unchanged."
    save-text "$name" "$action text for $name using $editor." < "$tmp_file"
}

# --- text generate ------------------------------------------------------------

function text-generate-help() {
    cat <<'EOF'
Usage: folio generate text [-n|--no-symbols] [-i|--in-place|-f|--force] [--store-passphrase-fd <n>]
                           <name> [<length>]

Generate a random text (25 characters unless <length> is given), save and sign it, and print it.
It is a text, kept plain — for a random password, use `folio generate secret`.

Options:
  -n, --no-symbols    Letters and digits only.
  -i, --in-place      Replace only the first line of an existing text; keep the rest.
  -f, --force         Overwrite an existing text without asking (only asked at a terminal).
  --store-passphrase-fd <n>
                      The store key's passphrase (to sign), from the first line of file
                      descriptor <n>, instead of gpg's prompt.
  -h, --help          Show this help and stop.
EOF
}

# folio generate text [-n|--no-symbols] [-i|--in-place|-f|--force] <name> [<length>]
# As `pass generate`, for a text: the same characters and length, then saved and signed.
TextGenerate() {
    local chars=${PASSWORD_STORE_CHARACTER_SET:-[:punct:][:alnum:]} inplace=0 force=0 args=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)       text-generate-help ; return 0 ;;
            -n|--no-symbols) chars=${PASSWORD_STORE_CHARACTER_SET_NO_SYMBOLS:-[:alnum:]} ;;
            -i|--in-place)   inplace=1 ;;
            -f|--force)      force=1 ;;
            --)              args+=("$@") ; break ;;
            -*)              die "generate text: unknown option: $arg" ;;
            *)               args+=("$arg") ;;
        esac
    done
    (( (${#args[@]} == 1 || ${#args[@]} == 2) && !(inplace && force) )) \
        || die "Usage: folio generate text [-n|--no-symbols] [-i|--in-place|-f|--force] <name> [<length>]"
    local name=${args[0]} length=${args[1]:-${PASSWORD_STORE_GENERATED_LENGTH:-25}} file text
    [[ -n $name && $name != */ && /$name/ != */../* ]] || die "generate text: '$name' is not a valid name."
    [[ $length =~ ^[0-9]+$ && $length -gt 0 ]] || die "generate text: the length must be a number above 0."
    require-store
    file=$STORE_PATH/$name.txt

    if [[ -e $file ]] && (( ! inplace && ! force )) && [[ -t 0 ]]; then
        confirm "An entry already exists for $name. Overwrite it?" || exit 1
    fi
    read -r -n "$length" text < <(LC_ALL=C tr -dc "$chars" < /dev/urandom 2>/dev/null)
    [[ ${#text} -eq $length ]] || die "generate text: could not generate a text from /dev/urandom."

    if (( inplace )) && [[ -f $file ]]; then
        # The rest of the text is kept, so it must be the one EnvFolio signed.
        verify-text "$name"
        { printf '%s\n' "$text" ; tail -n +2 "$file" ; } \
            | save-text "$name" "Replace generated text for $name." || exit 1
    else
        printf '%s\n' "$text" | save-text "$name" "Add generated text for $name." || exit 1
    fi
    printf 'The generated text for %s is:\n%s\n' "$name" "$text"
}

# --- text rm ------------------------------------------------------------------

function text-rm-help() {
    cat <<'EOF'
Usage: folio rm text [-r|--recursive] [-f|--force] <name>

Remove a text, or every text in a folder with --recursive (secrets in it are kept). At a
terminal, asks first unless --force; from a script or pipe, it does not ask.
The removed text stays in the store's git history.

Options:
  -r, --recursive     Remove every text in a folder.
  -f, --force         Do not ask.
  -h, --help          Show this help and stop.
EOF
}

# folio rm text [-r|--recursive] [-f|--force] <name>
# As `pass rm`, for texts: <name> is a text, or — ending in / or not a text — a folder.
TextRm() {
    local recursive=0 force=0 names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)      text-rm-help ; return 0 ;;
            -r|--recursive) recursive=1 ;;
            -f|--force)     force=1 ;;
            --)             names+=("$@") ; break ;;
            -*)             die "rm text: unknown option: $arg" ;;
            *)              names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 )) || die "Usage: folio rm text [-r|--recursive] [-f|--force] <name>"
    local name=${names[0]} path=${names[0]%/} folder=0
    [[ -n $path && /$path/ != */../* ]] || die "rm text: '$name' is not a valid name."
    require-store

    if [[ -f $STORE_PATH/$path.txt && ! ( $name == */ && -d $STORE_PATH/$path ) ]]; then
        folder=0
    elif [[ -d $STORE_PATH/$path ]]; then
        (( recursive )) || die "rm text: '$path' is a folder; use -r to remove the texts in it."
        folder=1
    else
        die "rm text: '$name' is not in the store."
    fi
    (( force )) || [[ ! -t 0 ]] || confirm "Are you sure you would like to delete $path?" || exit 1

    if (( folder )); then
        find "$STORE_PATH/$path" -type f \( -name '*.txt' -o -name '*.txt.sig' \) -exec rm -f -- {} +
        find "$STORE_PATH/$path" -depth -type d -empty -exec rmdir -- {} \;
        # git's * matches across folders: every text under <path>.
        git -C "$STORE_PATH" rm -r -q --cached --ignore-unmatch -- "$path/*.txt" "$path/*.txt.sig"
    else
        rm -f -- "$STORE_PATH/$path.txt" "$STORE_PATH/$path.txt.sig"
        git -C "$STORE_PATH" rm -q --cached --ignore-unmatch -- "$path.txt" "$path.txt.sig"
    fi
    rmdir -p "$(dirname "$STORE_PATH/$path")" 2>/dev/null
    git -C "$STORE_PATH" diff --cached --quiet || git -C "$STORE_PATH" commit --quiet -m "Remove $path from store."
}

# --- text mv / cp -------------------------------------------------------------

function text-mv-help() {
    cat <<'EOF'
Usage: folio mv text [-f|--force] <old-name> <new-name>

Rename or move a text, or every text in a folder (secrets in it stay where they are). At a
terminal, asks before overwriting unless --force; from a script or pipe, it overwrites.

Options:
  -f, --force         Overwrite without asking.
  -h, --help          Show this help and stop.
EOF
}

function text-cp-help() {
    cat <<'EOF'
Usage: folio cp text [-f|--force] <old-name> <new-name>

Copy a text, or every text in a folder (secrets in it are not copied). At a terminal, asks before
overwriting unless --force; from a script or pipe, it overwrites.

Options:
  -f, --force         Overwrite without asking.
  -h, --help          Show this help and stop.
EOF
}

TextMv() { text-copy-move mv "$@" ; }
TextCp() { text-copy-move cp "$@" ; }

# text-copy-move <mv|cp> [-f|--force] <old-name> <new-name>
# As `pass mv` / `pass cp`, for texts. A signature covers the text, not its name, so it moves with
# it and still verifies.
function text-copy-move() {
    local how=$1 force=0 names=() arg ; shift
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)  "text-$how-help" ; return 0 ;;
            -f|--force) force=1 ;;
            --)         names+=("$@") ; break ;;
            -*)         die "$how text: unknown option: $arg" ;;
            *)          names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 2 )) || die "Usage: folio $how text [-f|--force] <old-name> <new-name>"
    local old=${names[0]} new=${names[1]} src=${names[0]%/} dest
    [[ -n $src     && /$src/ != */../* ]] || die "$how text: '$old' is not a valid name."
    [[ -n ${new%/} && /$new/ != */../* ]] || die "$how text: '$new' is not a valid name."
    require-store

    # The names to carry over: each old one in from[], its new one in to[].
    local from=() to=() file rel i
    if [[ -f $STORE_PATH/$src.txt && ! ( $old == */ && -d $STORE_PATH/$src ) ]]; then
        # One text; into <new> when that is a folder (and not also a text), as mv/cp do.
        dest=${new%/}
        [[ $new == */ || ( -d $STORE_PATH/$dest && ! -f $STORE_PATH/$dest.txt ) ]] && dest=$dest/${src##*/}
        from=("$src") ; to=("$dest")
    elif [[ -d $STORE_PATH/$src ]]; then
        # Every text in a folder; into <new> when that folder exists already, as mv/cp do.
        dest=${new%/}
        [[ -d $STORE_PATH/$dest ]] && dest=$dest/${src##*/}
        while IFS= read -r -d '' file; do
            rel=${file#"$STORE_PATH/$src"/} ; rel=${rel%.txt}
            from+=("$src/$rel") ; to+=("$dest/$rel")
        done < <(find "$STORE_PATH/$src" -type f -name '*.txt' -print0)
        (( ${#from[@]} > 0 )) || die "$how text: '$old' holds no texts."
    else
        die "$how text: '$old' is not in the store."
    fi

    for (( i = 0; i < ${#from[@]}; i++ )); do
        [[ ${from[i]} != "${to[i]}" ]] || continue
        if [[ -e $STORE_PATH/${to[i]}.txt ]] && (( ! force )) && [[ -t 0 ]]; then
            confirm "An entry already exists for ${to[i]}. Overwrite it?" || continue
        fi
        mkdir -p "$(dirname "$STORE_PATH/${to[i]}")"
        for file in "${from[i]}.txt" "${from[i]}.txt.sig"; do
            [[ -e $STORE_PATH/$file ]] && "$how" -f -- "$STORE_PATH/$file" "$STORE_PATH/${to[i]}${file#"${from[i]}"}"
        done
        if [[ $how == mv ]]; then
            git -C "$STORE_PATH" rm -q --cached --ignore-unmatch -- "${from[i]}.txt" "${from[i]}.txt.sig"
            rmdir -p "$(dirname "$STORE_PATH/${from[i]}")" 2>/dev/null
        fi
        git -C "$STORE_PATH" add -- "${to[i]}.txt"
        [[ -e $STORE_PATH/${to[i]}.txt.sig ]] && git -C "$STORE_PATH" add -- "${to[i]}.txt.sig"
    done
    local verb=Copy ; [[ $how == mv ]] && verb=Rename
    git -C "$STORE_PATH" diff --cached --quiet || git -C "$STORE_PATH" commit --quiet -m "$verb $old to $new."
}

#== Command: Secret ============================================================

Secret() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    # Every secret command needs a ready store — except asking for its help.
    case " $* " in
        *" -h "*|*" --help "*) ;;
        *) [[ -z $category ]] || require-store ;;
    esac
    case "$category" in
        ls)       SecretLs        "$@" ;;
        find)     SecretFind      "$@" ;;
        grep)     SecretGrep      "$@" ;;
        show)     SecretShow      "$@" ;;
        insert)   SecretInsert    "$@" ;;
        edit)     SecretEdit      "$@" ;;
        generate) SecretGenerate  "$@" ;;
        rm)       SecretRm        "$@" ;;
        mv)       SecretMv        "$@" ;;
        cp)       SecretCp        "$@" ;;
        "")       echo "Usage: folio secret <ls|find|grep|show|insert|edit|generate|rm|mv|cp> [args...]" >&2 ; return 1 ;;
        *)        echo "folio secret: unknown command: $category"                                        >&2 ; return 1 ;;
    esac
}

