# folio show secret [-c|--clip[=<line>]] <name>
# Only an entry goes through: given a folder, `pass show` would list it.
SecretShow() {
    local clip=() names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)                   secret-show-help ; return 0 ;;
            -c|-c[0-9]*|--clip|--clip=*) clip=("$arg") ;;
            -q*|--qrcode*)               die "show secret: --qrcode is not offered." ;;
            --)                          names+=("$@") ; break ;;
            -*)                          die "show secret: unknown option: $arg" ;;
            *)                           names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 ))              || die "Usage: folio show secret [-c|--clip[=<line>]] <name>"
    [[ -f $STORE_PATH/${names[0]}.gpg ]] || die "show secret: '${names[0]}' is not a secret in the store."
    pass show "${clip[@]}" -- "${names[0]}"
