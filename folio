#== Command: Exec ==============================================================

function run-exec-help() {
    cat <<'HELP'
Usage: folio exec [-s|--secrets] [-a|--all] [-n|--names|--debug|--confirm] [--plain]
                  [--use <@namespace>]... [--vars <file>]... [--store-passphrase-fd <n>]
                  [--from <file> [--file-passphrase-fd <n>]] <entry>... -- <command> [<arg>...]

Run a command with entries from the store as environment variables. Texts load by default;
secrets only with --secrets. Values are never printed.

An <entry> is a text or secret name, a folder (every entry under it), or VAR=<name> to pick
the variable's name. Otherwise the name comes from the entry's path: a top folder starting with @
(a namespace) is removed, / turns into _, and it is uppercased (@nawa/gh/token -> GH_TOKEN).
--use @prod takes every entry under @prod as if @prod/ were not in its path: @prod/server/user
is server/user, everywhere, also to a vars file. Only namespaces peel, from the front:
--use @app2/@prod. The entries, --all and --use are taken in the order typed, and the last one
wins: in `server --use @prod`, @prod's server/user wins; in `--use @prod server`, server's does.
Then each VAR=<name>, wherever it is typed, takes <name> as it is after them (else from the
store) and overrides them all; its entry keeps its own variable too.

A vars file (--vars) sets variables, one line each:
  VAR=<value>         Text, with ${NAME} (from the environment) and @{name} (a text or secret)
                      put in. ${NAME:-<fallback>} and @{name:-<fallback>} when it is unset or
                      missing; a fallback is a value too, so they chain.
  @{name}, @{folder/*}
                      An entry, or every entry under a folder, named by its path as above.
Blank lines and # comments are left out; nothing in it runs. It is made after the entries,
--all and --use, and they only feed it: ${NAME} sees them, but the command gets only what the
vars files set. `folio check vars` checks one without a store; --names shows what it gives.

Options:
  -s, --secrets       Also load secrets.
  -a, --all           Load every entry outside the @namespaces, where it is typed among the
                      entries. <entry> is then optional.
  -n, --names         Only show which variable would get which entry, and stop: nothing is read,
                      nothing runs.
      --debug         Show the same on stderr, then go on.
      --confirm       Show the same on stderr, and go on only when you say yes (asked on the
                      terminal, not stdin). No value is read, and the store key is not
                      unlocked, before the yes; a --from file is opened first, to show its names.
      --plain         With --names, --debug or --confirm: mark secrets (S) and texts (T), with no
                      colour, even on a screen.
  --use <@namespace>  Take every entry under <@namespace> (e.g. @prod, or @app2/@prod), named
                      without it, where it is typed among the entries; can be given more than
                      once. <entry> is then optional.
                      Experimental: it may change in a later version.
  --vars <file>       Set the variables a vars file says (e.g. prod-deploy.vars); can be given
                      more than once. <entry> is then optional.
  --from <file>       Take the entries from a file made by `folio export`, not from the store,
                      which is then not needed. gpg asks for the file's passphrase, or uses your
                      key the file is locked to. Nothing is kept: the file is opened in a private
                      temporary folder, removed before the command starts.
  --file-passphrase-fd <n>
                      With --from: the file's passphrase, from the first line of file descriptor
                      <n>, e.g. --file-passphrase-fd 3 3< pass.txt.
  --store-passphrase-fd <n>
                      Without --from: the store key's passphrase (to read the secrets), from the
                      first line of file descriptor <n>, instead of gpg's prompt.
  -h, --help          Show this help and stop.
HELP
}

function run-shell-help() {
    cat <<'HELP'
Usage: folio shell [-s|--secrets] [-a|--all] [-n|--names|--debug|--confirm] [--plain]
                   [--use <@namespace>]... [--vars <file>]... [--store-passphrase-fd <n>]
                   [--from <file> [--file-passphrase-fd <n>]] <entry>...

Start your shell ($SHELL) with entries from the store as environment variables, and say which
names were loaded (never their values). FOLIO_SHELL=1 is set. Type `exit` to leave.
Entries, --use, vars files and variable names are as in `folio exec`.

Options:
  -s, --secrets       Also load secrets.
  -a, --all           Load every entry outside the @namespaces, where it is typed among the
                      entries. <entry> is then optional.
  -n, --names         Only show which variable would get which entry, and stop: nothing is read,
                      nothing runs.
      --debug         Show the same on stderr, then go on.
      --confirm       Show the same on stderr, and go on only when you say yes (asked on the
                      terminal, not stdin). No value is read, and the store key is not
                      unlocked, before the yes; a --from file is opened first, to show its names.
      --plain         With --names, --debug or --confirm: mark secrets (S) and texts (T), with no
                      colour, even on a screen.
  --use <@namespace>  Take every entry under <@namespace>, named without it, as in `folio exec`;
                      can be given more than once. <entry> is then optional.
                      Experimental: it may change in a later version.
  --vars <file>       Set the variables a vars file says, as in `folio exec`; can be given more
                      than once. <entry> is then optional.
  --from <file>       Take the entries from a file made by `folio export`, as in `folio exec`.
  --file-passphrase-fd <n>
                      With --from: the file's passphrase, from the first line of file descriptor <n>.
  --store-passphrase-fd <n>
                      Without --from: the store key's passphrase, as in `folio exec`.
  -h, --help          Show this help and stop.
HELP
}

Exec()  { exec-with-entries exec  "$@" ; }
Shell() { exec-with-entries shell "$@" ; }

VAR_NAME_PATTERN='^[A-Za-z_][A-Za-z0-9_]*$'
# Where the entries come from, in messages: the store, or with --from, the export.
ENTRIES_IN="the store"

# exec-with-entries <exec|shell> [-s|--secrets] [--use <@namespace>]... [--vars <file>]... [--from <file> [--file-passphrase-fd <n>]]
#                   <entry>... [-- <command> [<arg>...]]
# Read every entry first, then export them all at once and exec: no `pass` or `gpg` call made
# while reading ever sees a value already loaded. With --from, the entries come from an export
# file instead of the store, which is then not needed at all.
function exec-with-entries() {
    # The entries, --all ("") and --use (--use=<@namespace>) in the order typed: the last one wins.
    local how=$1 secrets=0 only_names=0 debug=0 confirm=0 dashes=0 from_file="" passphrase_fd="" entries=() arg ; shift
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)    "run-$how-help" ; return 0 ;;
            -s|--secrets) secrets=1 ;;
            -a|--all)     entries+=("") ;;
            -n|--names)   only_names=1 ;;
            --debug)      debug=1 ;;
            --confirm)    debug=1 confirm=1 ;;
            --plain)      PLAIN=1 ;;
            --from|--file-passphrase-fd|--vars|--use)
                          [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                          case $arg in
                              --from) from_file=$1 ;;
                              --vars) read-vars-file "$how" "$1" ;;
                              --use)  entries+=("--use=${1%/}") ;;
                              *)      passphrase_fd=$1 ;;
                          esac
                          shift ;;
            --vars=*)          read-vars-file "$how" "${arg#*=}" ;;
            --use=*)           arg=${arg#--use=} ; entries+=("--use=${arg%/}") ;;
            --from=*)          from_file=${arg#*=} ;;
            --file-passphrase-fd=*) passphrase_fd=${arg#*=} ;;
            --)           dashes=1 ; break ;;
            -*)           die "$how: unknown option: $arg" ;;
            *)            entries+=("$arg") ;;
        esac
    done
    local from_usage="[--use <@namespace>]... [--vars <file>]... [--store-passphrase-fd <n>] [--from <file> [--file-passphrase-fd <n>]]"
    (( ! (only_names && debug) )) \
        || die "$how: --names only shows the names; --debug and --confirm show them and go on."
    # --debug and --confirm show the names on stderr: marked for that screen, not stdout's.
    (( ! debug )) || SCREEN_FD=2
    set-marks    # for --names, here: what it shows of a vars file is made in $(…)
    local given=$(( ${#entries[@]} + ${#VARS_KIND[@]} ))
    if [[ $how == exec ]]; then
        (( given > 0 && (only_names || (dashes && $# > 0)) )) \
            || die "Usage: folio exec [-s|--secrets] [-a|--all] [-n|--names|--debug|--confirm] [--plain] $from_usage <entry>... -- <command> [<arg>...]"
    else
        (( given > 0 && ! dashes )) \
            || die "Usage: folio shell [-s|--secrets] [-a|--all] [-n|--names|--debug|--confirm] [--plain] $from_usage <entry>..."
        set -- "${SHELL:-/bin/sh}"
    fi
    if [[ -n $from_file ]]; then
        [[ -z $STORE_PASSPHRASE_FD ]] || die "$how: --store-passphrase-fd is for the store; --from does not use it."
        open-export-for "$how" "$from_file" "$passphrase_fd"
        FROM_EXPORT=1
    else
        [[ -z $passphrase_fd ]] || die "$how: --file-passphrase-fd is for opening a --from file."
        # The key is unlocked below, once a value is to be read: not for --names, nor before
        # --confirm's yes.
        check-store
    fi
    # With a --use, every entry is read from a view: the store (or export) with the layers laid
    # over it, in the order typed.
    make-view "$how" "$secrets" ${entries[@]+"${entries[@]}"}
    check-vars-entries "$how" "$secrets"
    # The vars files' values are made line by line, reading entries as they go. So first a dry
    # run, as --names does it: it reads no value, and stops at an entry that is not there before
    # any value is read. It runs in a subshell, so nothing it sets is kept. What it says goes to
    # the screen only when it fails; when it does not, the real run below says the same notes.
    # With --debug, that dry run also shows the names, as --names does, straight to stderr (fd 3);
    # the notes it says are kept, and shown only when it fails. With --confirm, no value is read and
    # the store key is not unlocked until the user says yes (with --from, the file is open already:
    # its names are needed to show them).
    if (( debug )); then
        local names_errors
        if ! names_errors=$(
                {
                    load-entries "$how" "$secrets" 1 ${entries[@]+"${entries[@]}"}
                    print-entry-names >&3
                } 3>&2 2>&1
            ); then
            printf '%s\n' "$names_errors" >&2
            exit 1
        fi
        if (( confirm )); then
            local question="run $1?" ; [[ $how == exec ]] || question="start $1?"
            confirm-on-tty "folio $how: $question" || die "Cancelled."
        fi
    elif (( ! only_names && ${#VARS_KIND[@]} > 0 )); then
        local dry_run_errors
        if ! dry_run_errors=$(
                {
                    load-entries "$how" "$secrets" 1 ${entries[@]+"${entries[@]}"}
                } 2>&1
            ); then
            printf '%s\n' "$dry_run_errors" >&2
            exit 1
        fi
    fi
    (( only_names )) || unlock-store-key
    load-entries "$how" "$secrets" "$only_names" ${entries[@]+"${entries[@]}"}
    (( only_names )) && { print-entry-names ; return 0 ; }

    local pairs=() i file value texts=0 values=0
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        file=${EXEC_FILES[i]}
        case $file in
            =*)    value=${VAR_VALUES[${file#=}]} values=$(( values + 1 )) ;;
            *.txt) read-entry-value "$how" "$file" ; value=$ENTRY_VALUE texts=$(( texts + 1 )) ;;
            *)     read-entry-value "$how" "$file" ; value=$ENTRY_VALUE ;;
        esac
        pairs+=("${EXEC_VARS[i]}=$value")
    done
    unset value ENTRY_VALUE VAR_VALUES
    # Every value is read: the unpacked export and its key go now, as exec runs no EXIT trap.
    remove-now

    if [[ $how == shell ]]; then
        local names
        names=$(printf ', %s' "${EXEC_VARS[@]}")
        local others="" ; (( values == 0 )) || others=", from vars files: $values"
        printf "folio shell: loaded %s (texts: %d, secrets: %d%s). Type 'exit' to leave.\n" \
            "${names#, }" "$texts" $(( ${#EXEC_VARS[@]} - texts - values )) "$others" >&2
        export FOLIO_SHELL=1
    fi
    if [[ -n $CALLER_STORE_DIR_SET ]]; then export PASSWORD_STORE_DIR=$CALLER_STORE_DIR
    else unset PASSWORD_STORE_DIR
    fi
    # Arrays would swallow a loaded name of theirs (export makes it element 0, never exported).
    set -- "${pairs[@]}" -- "$@"
    unset pairs entries EXEC_VARS EXEC_FILES INPUT_VARS INPUT_FILES STORE_PASSPHRASE
    export-and-exec "$@"
}

# open-export-for <exec|shell> <file> <passphrase-fd>: open the export <file> for exec or shell,
# and read the entries from it from here on (STORE_PATH is its unpacked items). The passphrase is
# the first line of fd <passphrase-fd>, if given; otherwise gpg asks for it, or uses your key the
# file is locked to.
function open-export-for() {
    local how=$1 file=$2 fd=$3 passphrase=""
    check-export-file "$file"
    if [[ -n $fd ]]; then
        check-passphrase-fd --file-passphrase-fd "$fd"
        read-passphrase-fd "$fd"
        passphrase=$PASSPHRASE
        unset PASSPHRASE
    elif
 is-passphrase-locked "$file"; then
        info "folio $how: gpg asks for the passphrase of $(tilde-path "$file")." >&2
    fi
    open-export "$file" "$passphrase" quiet
    unset passphrase
    STORE_PATH=$EXPORT_ROOT ENTRIES_IN="the export"
}

# export-and-exec <var>=<value>... -- <command> [<arg>...]
# Export each, check that the command will really get it, then exec. Only positional parameters,
# so no loaded name can clobber what this needs; the check catches the names bash keeps for
# itself (RANDOM, UID, ...).
function export-and-exec() {
    # The command gets the environment EnvFolio was started with, not a GPG_TTY set-gpg-tty added.
    (( ! GPG_TTY_SET )) || unset GPG_TTY
    while [[ $1 != -- ]]; do
        set -- "${1%%=*}" "$@"
        # shellcheck disable=SC2163  # $2 is <var>=<value>, exported as written
        if ! export -- "$2" 2>/dev/null \
            || [[ $(declare -p -- "$1" 2>/dev/null) != "declare -x $1="* || ${!1} != "${2#*=}" ]]; then
            die "could not set $1: bash or EnvFolio keeps that name for itself. Load it under another name with VAR=<name>."
        fi
        shift 2
    done
    shift
    exec "$@"
}

# load-entries <exec|shell> <secrets:0|1> <names:0|1> <entry>...: EXEC_VARS[i] <- EXEC_FILES[i]
# is what the command gets. First the entries, --all and --use, in the order typed; then the vars
# files, over them. With vars files, the entries only feed them — INPUT_VARS/INPUT_FILES, which
# ${NAME} sees — and the command gets only what the vars files set.
function load-entries() {
    local how=$1 secrets=$2 names=$3
    shift 3
    EXEC_VARS=() EXEC_FILES=() VAR_VALUES=() INPUT_VARS=() INPUT_FILES=()
    (( $# == 0 )) || resolve-entries "$how" "$secrets" "$@"
    if (( ${#VARS_KIND[@]} > 0 )); then
        INPUT_VARS=(${EXEC_VARS[@]+"${EXEC_VARS[@]}"}) INPUT_FILES=(${EXEC_FILES[@]+"${EXEC_FILES[@]}"})
        EXEC_VARS=() EXEC_FILES=()
        apply-vars "$how" "$secrets" "$names"
    fi
    (( ${#EXEC_VARS[@]} > 0 )) || die "$how: nothing to load."
}

# resolve-entries <exec|shell> <secrets:0|1> <entry>...
# Work out which variable gets which entry, into EXEC_VARS[i] <- EXEC_FILES[i] (<name>.txt or
# <name>.gpg), over what is there already. Every entry but VAR=<name> is named by its path, a
# later one overriding an earlier one. An empty entry is the store's root (--all): every entry
# outside the @namespaces. --use=<@namespace>: every entry under it, named by its path with the
# namespace peeled off. Then each VAR=<name>, over them all: <name> as it is after every other
# entry (with a --use, in the view), or else in the store. Its entry keeps its own name too.
function resolve-entries() {
    local how=$1 secrets=$2 entry var name exp_vars=() exp_files=() i
    shift 2
    for entry in "$@"; do
        [[ $entry == --use=* ]] && continue
        is-explicit "$entry" || continue
        var=${entry%%=*} name=${entry#*=}
        [[ $var =~ $VAR_NAME_PATTERN ]] || die "$how: '$var' is not a valid variable name."
        entry-file "$how" "$secrets" "$name" || die "$how: '$name' is not a text or secret in $ENTRIES_IN."
        exp_vars+=("$var") ; exp_files+=("$ENTRY_FILE")
    done

    # With a view (--use), an entry or folder takes the items it has in the source — not the ones
    # a --use laid there too — each read from the view, where the last layer laid it.
    local source=${VIEW_SOURCE:-$STORE_PATH}
    for entry in "$@"; do
        if [[ $entry == --use=* ]]; then
            start-selection "--use ${entry#--use=}" "${entry#--use=}"
            add-used "$how" "$secrets" "${entry#--use=}"
            continue
        fi
        is-explicit "$entry" && continue
        if [[ -n $entry ]]; then start-selection "'$entry'" ; else start-selection "--all" ; fi
        if [[ -n $entry ]] && STORE_PATH=$source entry-file "$how" "$secrets" "$entry"; then
            add-derived "$how" "$ENTRY_FILE"
        else
            STORE_PATH=$source add-folder "$how" "$secrets" "$entry"
        fi
    done

    for (( i = 0; i < ${#exp_vars[@]}; i++ )); do set-entry-var "${exp_vars[i]}" "${exp_files[i]}" ; done
}

# add-folder <how> <secrets> <folder>: every entry under <folder>, named by its path. An empty
# <folder> is the store's root (--all): every entry outside the @namespaces. Stop when there is
# none to load.
function add-folder() {
    local how=$1 secrets=$2 entry=$3 file found=0
    if [[ -z $entry || -d $STORE_PATH/$entry ]]; then
        while IFS= read -r file; do
            file=${file#"$STORE_PATH"/}
            [[ -n $entry || $file != @* ]] || continue
            if [[ $file == *.gpg && -f $STORE_PATH/${file%.gpg}.txt ]]; then
                die "$how: '${file%.gpg}' is both a text and a secret; give one VAR=<name> or rename one."
            fi
            found=1
            add-derived "$how" "$file"
        done < <(entries-under "$secrets" "$STORE_PATH${entry:+/${entry%/}}")
        (( secrets )) || note-skipped-secrets "$how" "$entry" "$found"
    fi
    if (( ! found )); then
        [[ -n $entry ]] && die "$how: '$entry' has no entries to load."
        die "$how: $ENTRIES_IN has no entries to load."
    fi
}

# add-used <how> <secrets> <@namespace>: every entry used-items finds, named by its path in the
# view (@prod/server/user -> server/user -> SERVER_USER).
function add-used() {
    local how=$1 secrets=$2 prefix=$3 file
    used-items "$how" "$secrets" "$prefix"
    for file in "${USED_ITEMS[@]}"; do
        if [[ $file == *.gpg && -f $VIEW_SOURCE/$prefix/${file%.gpg}.txt ]]; then
            die "$how: '$prefix/${file%.gpg}' is both a text and a secret; give one VAR=<name> or rename one."
        fi
        add-derived "$how" "$file"
    done
}

# used-items <how> <secrets> <@namespace>: USED_ITEMS gets every item under <@namespace> in the
# source, as it is named in the view — <@namespace> peeled off (<name>.txt or <name>.gpg). Its
# secrets only with <secrets>, as in a folder. One a later layer laid over with the other kind is
# left to that layer.
function used-items() {
    local how=$1 secrets=$2 prefix=$3 file
    USED_ITEMS=()
    while IFS= read -r file; do
        file=${file#"$VIEW_SOURCE/$prefix"/}
        [[ -f $STORE_PATH/$file ]] && USED_ITEMS+=("$file")
    done < <(entries-under "$secrets" "$VIEW_SOURCE/$prefix")
    (( secrets )) || STORE_PATH=$VIEW_SOURCE note-skipped-secrets "$how" "$prefix" "${#USED_ITEMS[@]}"
    (( ${#USED_ITEMS[@]} > 0 )) || die "$how: '$prefix' has no entries to load."
}

# --- The view (--use) ---------------------------------------------------------

# make-view <how> <secrets:0|1> <entry>...: with a --use among the entries, read every entry from a
# view from here on — STORE_PATH (and pass's PASSWORD_STORE_DIR) is a private temporary copy of the
# source (the store, or an opened export), its .git left out, with each layer laid over it in the
# order given, the last one winning:
#   ""                 (--all) every item outside the @namespaces, where it is
#   <name>, <folder>   the item, or every item under the folder, where it is
# A VAR=<name> is no layer: it picks from the view once it is made (resolve-entries).
#   --use=<@ns>[/<@ns>]...  every item under it, with that much peeled off the front of its path
# A folder's or a --use's secrets are laid only with <secrets>, as only then are they taken: so
# one left out never covers a text of the same name.
# Only files are copied: a secret stays encrypted, and nothing is read or decrypted. VIEW_FROM[i]
# says which item in the source the item VIEW_PATHS[i] in the view was laid from. The view is
# removed when EnvFolio exits (or, before an exec, by remove-now). Without a --use: nothing.
VIEW_SOURCE="" VIEW_PATHS=() VIEW_FROM=()
function make-view() {
    local how=$1 secrets=$2 entry="" view file name prefix
    shift 2
    for entry in "$@"; do [[ $entry == --use=* ]] && break ; done
    [[ $entry == --use=* ]] || return 0

    VIEW_SOURCE=$STORE_PATH
    view=$(umask 077 && mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$view"
    while IFS= read -r file; do
        file=${file#./}
        mkdir -p "$view/$(dirname "$file")"
        cp -- "$VIEW_SOURCE/$file" "$view/$file"
    done < <(cd "$VIEW_SOURCE" && find . -name .git -prune -o -type f -print)

    for entry in "$@"; do
        if [[ $entry == --use=* ]]; then
            prefix=${entry#--use=}
            check-use-prefix "$how" "$prefix"
            while IFS= read -r file; do
                name=${file#"$VIEW_SOURCE"/} name=${name%.*}
                lay-in-view "$view" "$name" "${name#"$prefix"/}"
            done < <(entries-under "$secrets" "$VIEW_SOURCE/$prefix")
            continue
        fi
        is-explicit "$entry" && continue
        name=${entry%/}
        if [[ -n $name && ( -f $VIEW_SOURCE/$name.txt || -f $VIEW_SOURCE/$name.gpg ) ]]; then
            lay-in-view "$view" "$name" "$name"
        elif [[ -z $name || -d $VIEW_SOURCE/$name ]]; then
            while IFS= read -r file; do
                file=${file#"$VIEW_SOURCE"/}
                [[ -n $name || $file != @* ]] || continue
                lay-in-view "$view" "${file%.*}" "${file%.*}"
            done < <(entries-under "$secrets" "$VIEW_SOURCE${name:+/$name}")
        fi
        # Anything else is not there: resolve-entries says so.
    done
    STORE_PATH=$view
    export PASSWORD_STORE_DIR=$view
}

# check-use-prefix <how> <prefix>: die unless <prefix> is one or more namespaces from the front —
# @app2/@prod, never @app2/server — and is there in the source.
function check-use-prefix() {
    local how=$1 prefix=$2 rest=$2/ part
    [[ -n $prefix ]] || die "$how: --use needs a namespace, e.g. --use @prod."
    while [[ -n $rest ]]; do
        part=${rest%%/*} rest=${rest#*/}
        [[ $part == @?* ]] || die "$how: --use $prefix: '$part' is not a namespace (one starting with @)."
    done
    [[ -d $VIEW_SOURCE/$prefix ]] || die "$how: --use $prefix: there is no '$prefix' in $ENTRIES_IN."
}

# lay-in-view <view> <src> <dst>: copy the item named <src> in the source — its .txt and .txt.sig,
# its .gpg, whichever it has — to the name <dst> in <view>, over whatever item was there.
function lay-in-view() {
    local view=$1 src=$2 dst=$3 ext i
    mkdir -p "$view/$(dirname "$dst")"
    rm -f -- "$view/$dst.txt" "$view/$dst.txt.sig" "$view/$dst.gpg"
    for ext in .txt .txt.sig .gpg; do
        [[ ! -f $VIEW_SOURCE/$src$ext ]] || cp -- "$VIEW_SOURCE/$src$ext" "$view/$dst$ext"
    done
    for (( i = 0; i < ${#VIEW_PATHS[@]}; i++ )); do
        [[ ${VIEW_PATHS[i]} == "$dst" ]] && { VIEW_FROM[i]=$src ; return 0 ; }
    done
    VIEW_PATHS+=("$dst") VIEW_FROM+=("$src")
}

# view-from <name>: where the item <name> in the view was laid from, when that is another name;
# else nothing.
function view-from() {
    local i
    for (( i = 0; i < ${#VIEW_PATHS[@]}; i++ )); do
        [[ ${VIEW_PATHS[i]} == "$1" && ${VIEW_FROM[i]} != "$1" ]] && { echo "${VIEW_FROM[i]}" ; return 0 ; }
    done
    return 0
}

# print-entry-names: what --names shows — each variable and the entry it would get, in order,
# marked (entry-mark), and where a --use laid it from; for one a vars file sets, how its value is
# made. Then, with vars files, the entries that only feed them. Nothing is read or decrypted.
function print-entry-names() {
    local i width=0
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        (( ${#EXEC_VARS[i]} > width )) && width=${#EXEC_VARS[i]}
    done
    for (( i = 0; i < ${#INPUT_VARS[@]}; i++ )); do
        (( ${#INPUT_VARS[i]} > width )) && width=${#INPUT_VARS[i]}
    done
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        print-entry-name "$width" "${EXEC_VARS[i]}" "${EXEC_FILES[i]}"
    done
    (( ${#INPUT_VARS[@]} > 0 )) || return 0
    echo "Only for the vars files (the command does not get these):"
    for (( i = 0; i < ${#INPUT_VARS[@]}; i++ )); do
        print-entry-name "$width" "${INPUT_VARS[i]}" "${INPUT_FILES[i]}"
    done
}

# print-entry-name <width> <var> <file>: one line of print-entry-names.
function print-entry-name() {
    local width=$1 var=$2 file=$3 from
    # Set by a vars file: its value as it would be made, each part shown by where it is from.
    if [[ $file == =* ]]; then
        printf '%-*s <- %s\n' "$width" "$var" "${VAR_VALUES[${file#=}]}"
        return 0
    fi
    from=$(view-from "${file%.*}")
    printf '%-*s <- %s%s\n' "$width" "$var" "$(entry-mark "$file")" "${from:+  (--use: $from)}"
}

# entry-mark <name>.gpg|<name>.txt: the name marked as set-marks says — "🔑<name>" in yellow on a
# screen that draws emoji, "<name>(S)" elsewhere; for a text, 📄, green and (T).
function entry-mark() {
    local name=${1%.*} on=$TEXT_ON mark=$TEXT_MARK
    [[ $1 != *.gpg ]] || on=$SECRET_ON mark=$SECRET_MARK
    if (( EMOJI )); then echo "$on$mark$name$COLOR_OFF"
    else                 echo "$on$name$mark$COLOR_OFF"
    fi
}

# is-explicit <entry>: true for VAR=<name> (no / or [ before the =).
function is-explicit() { [[ $1 == *=* && ${1%%=*} != *[/[]* ]] ; }

# entry-file <how> <secrets> <name>: set ENTRY_FILE to the one entry <name> is, or return 1 when
# it is none (e.g. a folder). Refuse a secret without --secrets, and a name that is both kinds.
function entry-file() {
    local how=$1 secrets=$2 name=$3
    [[ -n ${name%/} && $name != -* && /$name/ != */../* && /$name/ != */./* ]] \
        || die "$how: '$name' is not a valid name."
    local txt=$STORE_PATH/$name.txt gpg=$STORE_PATH/$name.gpg
    if [[ -f $gpg ]] && (( secrets )); then
        [[ ! -f $txt ]] || die "$how: '$name' is both a text and a secret; give one VAR=<name> or rename one."
        ENTRY_FILE=$name.gpg
    elif [[ -f $txt ]]; then
        ENTRY_FILE=$name.txt
    elif [[ -f $gpg ]]; then
        die "$how: '$name' is a secret; add --secrets to load it."
    else
        return 1
    fi
}

# entries-under <secrets> <folder>: the texts (and with secrets, the secrets) under <folder>,
# sorted, leaving out hidden ones like .git.
function entries-under() {
    local kinds=(-name '*.txt')
    (( $1 )) && kinds+=(-o -name '*.gpg')
    find "$2" -mindepth 1 -name '.*' -prune -o -type f \( "${kinds[@]}" \) -print | LC_ALL=C sort
}

# note-skipped-secrets <how> <folder> <found:0|1>: say on stderr how many secrets were left out
# for want of --secrets (names and values never shown). With nothing else found, that is the error.
# An empty <folder> is the store's root (--all), its @namespaces left out.
function note-skipped-secrets() {
    local how=$1 entry=$2 found=$3 file count=0 where
    while IFS= read -r file; do
        [[ -n $entry || ${file#"$STORE_PATH"/} != @* ]] && count=$(( count + 1 ))
    done < <(find "$STORE_PATH${entry:+/${entry%/}}" -mindepth 1 -name '.*' -prune -o -type f -name '*.gpg' -print)
    (( count > 0 )) || return 0
    where="under '$entry'" ; [[ -n $entry ]] || where="in $ENTRIES_IN"
    (( found )) || die "$how: only secrets $where ($count); add --secrets to load them."
    printf "folio %s: left out %d secret(s) %s; add --secrets to load them.\n" "$how" "$count" "$where" >&2
}

# add-derived <how> <file>: name <file> by its path — @nawa/gh/token.gpg -> GH_TOKEN — or, when
# that is not a valid variable name, warn and leave it out. Only a top @folder is a namespace.
function add-derived() {
    local how=$1 name=${2%.*} var
    var=${name}
    [[ $var == @*/* ]] && var=${var#*/}
    var=$(printf '%s' "${var//\//_}" | LC_ALL=C tr '[:lower:]' '[:upper:]')
    if [[ $var =~ $VAR_NAME_PATTERN ]]; then
        check-selection-var "$how" "$var" "$name"
        set-entry-var "$var" "$2"
    elif [[ $name == @*/@?*/* ]]; then
        note-nested-namespace "$how" "$name"
    else
        printf "folio %s: warning: '%s' would be %s, not a valid variable name; left out. Use VAR=%s.\n" \
            "$how" "$name" "$var" "$name" >&2
    fi
}

# One selection — an entry, a folder, --all, a --use, a vars file's @{…} line — at a time: what it
# is called in messages, the namespace a --use peeled off (else ""), and the variables it set so far
# (SELECTION_VARS[i] from the item SELECTION_NAMES[i]). A later selection may set a variable an
# earlier one did — that is how they layer — but within one, two items for one variable is a
# clash: which one won would be down to the order of their names, not to anything typed.
SELECTION="" SELECTION_PREFIX="" SELECTION_VARS=() SELECTION_NAMES=()

# start-selection <label> [<@namespace>]: the items from here on are this selection's.
function start-selection() {
    SELECTION=$1 SELECTION_PREFIX=${2:-} SELECTION_VARS=() SELECTION_NAMES=()
}

# check-selection-var <how> <var> <name>: die when an item before <name> in this selection set
# <var> too; else note that <name> set it.
function check-selection-var() {
    local how=$1 var=$2 name=$3 i other hint="give one VAR=<name>, or rename one"
    for (( i = 0; i < ${#SELECTION_VARS[@]}; i++ )); do
        [[ ${SELECTION_VARS[i]} == "$var" ]] || continue
        other=${SELECTION_NAMES[i]}
        # Under a --use, two deeper namespaces (@prod/…, @staging/…): peel one of them too.
        if [[ -n $SELECTION_PREFIX && $other == @*/* && $name == @*/* ]]; then
            hint="pick one, e.g. --use $SELECTION_PREFIX/${other%%/*}"
        fi
        die "$how: $SELECTION: '${SELECTION_PREFIX:+$SELECTION_PREFIX/}$other' and '${SELECTION_PREFIX:+$SELECTION_PREFIX/}$name' would both be $var; $hint."
    done
    SELECTION_VARS+=("$var") SELECTION_NAMES+=("$name")
}

# note-nested-namespace <how> <name>: <name> is under a namespace inside a namespace
# (@app2/@prod/server/user would be @PROD_SERVER_USER), so it is left out. Say so once for that
# namespace — the @folders <name> starts with — and that --use loads what is under it.
NOTED_NAMESPACES=" "
function note-nested-namespace() {
    local how=$1 rest=${2%/*}/ prefix=""
    while [[ $rest == @?*/* ]]; do prefix+=${prefix:+/}${rest%%/*} rest=${rest#*/} ; done
    [[ $NOTED_NAMESPACES != *" $prefix "* ]] || return 0
    NOTED_NAMESPACES+="$prefix "
    printf "folio %s: '%s' is a namespace inside a namespace: its entries are left out. To load them, add --use %s.\n" \
        "$how" "$prefix" "$prefix" >&2
}

# set-entry-var <var> <file>: <var> gets <file>, replacing what it had.
function set-entry-var() {
    local i
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        [[ ${EXEC_VARS[i]} == "$1" ]] && { EXEC_FILES[i]=$2 ; return 0 ; }
    done
    EXEC_VARS+=("$1") ; EXEC_FILES+=("$2")
}

# read-entry-value <how> <file>: ENTRY_VALUE gets the value of <file> (<name>.txt or <name>.gpg),
# from the store or, with --from, the export. A text is checked against its signature first.
FROM_EXPORT=""
function read-entry-value() {
    local how=$1 file=$2
    if [[ $file == *.txt ]]; then
        if [[ -n $FROM_EXPORT ]]; then verify-export-text "$how" "${file%.txt}" "$STORE_PATH"
        else                         verify-text "${file%.txt}"
        fi
        ENTRY_VALUE=$(cat "$STORE_PATH/$file")
    elif [[ -n $FROM_EXPORT ]]; then
        ENTRY_VALUE=$(GNUPGHOME=$EXPORT_HOME gpg --batch --quiet --decrypt "$STORE_PATH/$file" 2>/dev/null) \
            || die "$how: could not decrypt '${file%.gpg}' in the export."
    else
        ENTRY_VALUE=$(pass show -- "${file%.gpg}") || die "$how: could not decrypt '${file%.gpg}'."
    fi
}

#== Command: Vars ==============================================================

# A vars file (exec/shell --vars) says which variables to set, one line each:
#   VAR=<value>          Text, with ${NAME} (the environment) and @{name} (a text or secret) put
#                        in; ${NAME:-<fallback>}, @{name:-<fallback>} when unset / missing, the
#                        fallback a value too (so they chain, either way round).
#   @{name}, @{folder/*} An entry, or every entry under a folder, named by its path.
# Blank lines and # comments are left out. Nothing in it is ever run: it is read a character at a
# time, never given to eval, and $( ) and ` are refused. A mistake stops everything, saying where.

Vars() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        check) VarsCheck "$@" ;;
        "")    echo "Usage: folio vars <check> [args...]" >&2 ; return 1 ;;
        *)     echo "folio vars: unknown command: $category" >&2 ; return 1 ;;
    esac
}

# --- vars check ---------------------------------------------------------------

function vars-check-help() {
    cat <<'EOF'
Usage: folio check vars <file>...

Check vars files — the ones `folio exec --vars` and `folio shell --vars` read — for mistakes:
every line is a VAR=<value> or an @{…} of its own, every ${…} and @{…} is whole, nothing would
run. Every mistake is shown with its file and line, not only the first. Needs no store, and
reads nothing from one: whether the entries are there, and where each variable would come from,
is what `folio exec --names --vars <file>` shows.

Options:
  -h, --help          Show this help and stop.
EOF
}

# folio check vars <file>...
VarsCheck() {
    local file failed=0 count
    case ${1:-} in -h|--help) vars-check-help ; return 0 ;; esac
    (( $# > 0 )) || die "Usage: folio check vars <file>..."
    for file in "$@"; do
        count=${#VARS_KIND[@]}
        if read-vars-file "check vars" "$file" each; then
            echo "$file: fine ($(( ${#VARS_KIND[@]} - count )) line(s) to load)."
        else
            failed=1
        fi
    done
    return $failed
}

# --- Reading a vars file ------------------------------------------------------

VARS_KIND=() VARS_NAME=() VARS_TEXT=() VARS_AT=()

# read-vars-file <how> <file> [each]: add the lines of a vars file to VARS_KIND (var or entries),
# VARS_NAME (the variable, or the @{…} entry), VARS_TEXT (the value as written) and VARS_AT
# (<file>:<line>). Only what is written is checked, so no store is needed. A mistake stops
# everything, saying where — or, with each, is told and the next line read; then it fails at the end.
function read-vars-file() {
    local how=$1 file=$2 each=${3:-} line number=0 failed=0 status
    if [[ ! -f $file || ! -r $file ]]; then
        [[ -n $each ]] || die "$how: cannot read the vars file $(tilde-path "$file")."
        printf 'folio: %s: cannot read the vars file %s.\n' "$how" "$(tilde-path "$file")" >&2
        return 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        number=$(( number + 1 ))
        parse-vars-line "$line" ; status=$?
        (( status == 2 )) && continue
        if (( status == 1 )); then
            [[ -n $each ]] || die "$how: $file:$number: $SCAN_ERROR"
            printf 'folio: %s: %s:%d: %s\n' "$how" "$file" "$number" "$SCAN_ERROR" >&2
            failed=1
            continue
        fi
        VARS_KIND+=("$LINE_KIND") VARS_NAME+=("$LINE_NAME") VARS_TEXT+=("$LINE_TEXT") VARS_AT+=("$file:$number")
    done < "$file"
    return $failed
}

# parse-vars-line <line>: LINE_KIND, LINE_NAME and LINE_TEXT for one line. Returns 2 for a line
# with nothing on it (blank, or a comment), 1 with SCAN_ERROR for a mistake.
function parse-vars-line() {
    local line=${1%$'\r'} rest after
    line=${line#"${line%%[![:blank:]]*}"}
    [[ -z $line || $line == \#* ]] && return 2
    if [[ $line == @\{* ]]; then
        rest=${line#@\{}
        [[ $rest == *\}* ]] || { SCAN_ERROR="the @{ is not closed with }." ; return 1 ; }
        LINE_NAME=${rest%%\}*} after=${rest#*\}} LINE_KIND=entries LINE_TEXT=""
        after=${after#"${after%%[![:blank:]]*}"}
        [[ $LINE_NAME != *:-* ]] \
            || { SCAN_ERROR="@{$LINE_NAME} on a line of its own has no variable to fall back for; write VAR=@{$LINE_NAME}." ; return 1 ; }
        [[ -z $after || $after == \#* ]] \
            || { SCAN_ERROR="only a comment can follow @{$LINE_NAME} on its line." ; return 1 ; }
        check-vars-name "${LINE_NAME%/\*}"
        return
    fi
    [[ $line == *=* ]] || { SCAN_ERROR="not VAR=<value>, nor @{<entry>}: '$line'." ; return 1 ; }
    LINE_NAME=${line%%=*} LINE_TEXT=${line#*=} LINE_KIND=var
    [[ $LINE_NAME =~ $VAR_NAME_PATTERN ]] \
        || { SCAN_ERROR="'$LINE_NAME' is not a variable name (VAR=<value>, no blanks before the =)." ; return 1 ; }
    SCAN_MODE=check
    scan-value "$LINE_TEXT"
}

# check-vars-name <name>: fail, with SCAN_ERROR, for what cannot be an entry's name.
function check-vars-name() {
    [[ -n ${1%/} && $1 != -* && /$1/ != */../* && /$1/ != */./* && $1 != *[*{}]* ]] && return 0
    SCAN_ERROR="'$1' is not an entry name." ; return 1
}

# --- Making a value -----------------------------------------------------------

# scan-value <text>: read a VAR=<value>'s value into SCAN_OUT. SCAN_MODE says what for:
#   check  only see that it is well written, collecting the @{…} names in SCAN_NAMES — and in
#          SCAN_OPTIONAL, 1 for one that has a fallback or is in one (it may not be needed), else 0;
#   eval   make the value: look each ${…} and @{…} up, a fallback only when needed;
#   names  the same, but each part shows where it is from ([$HOME], [gh/token(S)]): no value read.
# Fails with SCAN_ERROR.
function scan-value() {
    SCAN_TEXT=$1 SCAN_POS=0 SCAN_LEN=${#1} SCAN_NAMES=() SCAN_OPTIONAL=() SCAN_DEPTH=0
    scan-text ""
}

# scan-text <end>: read SCAN_TEXT from SCAN_POS on, up to its end (<end> empty) or the } that
# closes a fallback (<end> }), into SCAN_OUT. Outside quotes, # after a blank starts a comment
# (#ff0000 is a value),
# and the blanks around the value are left out. 'single' quotes keep all as it is; in "double"
# ones, ${…} and @{…} are still put in; \ keeps the character after it as it is.
# shellcheck disable=SC2016  # the ${…} in the messages are what to write, not to expand
function scan-text() {
    # blank: the character just read was a blank as it is (not quoted, not after a \).
    local end=$1 out="" keep=0 c next quote="" part blank=0 after_blank
    if [[ -z $end ]]; then
        while [[ ${SCAN_TEXT:SCAN_POS:1} == [[:blank:]] ]]; do SCAN_POS=$(( SCAN_POS + 1 )) blank=1 ; done
    fi
    while (( SCAN_POS < SCAN_LEN )); do
        c=${SCAN_TEXT:SCAN_POS:1} next=${SCAN_TEXT:SCAN_POS+1:1}
        after_blank=$blank blank=0
        if [[ -n $quote ]]; then
            if [[ $c == '"' ]]; then quote= ; SCAN_POS=$(( SCAN_POS + 1 )) ; keep=${#out} ; continue ; fi
        elif [[ $c == "'" ]]; then
            part=${SCAN_TEXT:SCAN_POS+1}
            [[ $part == *"'"* ]] || { SCAN_ERROR="a ' is not closed." ; return 1 ; }
            part=${part%%"'"*}
            out+=$part ; keep=${#out} ; SCAN_POS=$(( SCAN_POS + ${#part} + 2 ))
            continue
        elif [[ $c == '"' ]]; then
            quote='"' ; SCAN_POS=$(( SCAN_POS + 1 )) ; continue
        elif [[ -n $end && $c == "}" ]]; then
            SCAN_POS=$(( SCAN_POS + 1 )) ; SCAN_OUT=$out ; return 0
        elif [[ -z $end && $c == "#" ]] && (( after_blank )); then
            break
        fi
        case $c in
            \\) [[ -n $next ]] || { SCAN_ERROR='a \ ends the line; write \\ for a \ itself.' ; return 1 ; }
                out+=$next ; keep=${#out} ; SCAN_POS=$(( SCAN_POS + 2 )) ; continue ;;
            \$) [[ $next == "{" ]] \
                    || { SCAN_ERROR='a $ starts ${NAME} or ${NAME:-<fallback>}; write \$ for a $ itself.' ; return 1 ; }
                SCAN_POS=$(( SCAN_POS + 2 ))
                scan-placeholder env || return 1
                out+=$SCAN_OUT ; keep=${#out} ; continue ;;
            @)  if [[ $next == "{" ]]; then
                    SCAN_POS=$(( SCAN_POS + 2 ))
                    scan-placeholder entry || return 1
                    out+=$SCAN_OUT ; keep=${#out} ; continue
                fi ;;
            \`) SCAN_ERROR='a ` is refused: nothing in a vars file runs.' ; return 1 ;;
        esac
        [[ -z $quote && $c == [[:blank:]] ]] && blank=1
        out+=$c ; SCAN_POS=$(( SCAN_POS + 1 ))
    done
    [[ -z $quote ]] || { SCAN_ERROR='a " is not closed.' ; return 1 ; }
    [[ -z $end ]]   || { SCAN_ERROR='a ${…} or @{…} is not closed with }.' ; return 1 ; }
    part=${out:keep} ; part=${part%"${part##*[![:blank:]]}"}
    SCAN_OUT=${out:0:keep}$part
}

# scan-placeholder <env|entry>: read a ${…} or @{…} (just after its {) into SCAN_OUT.
function scan-placeholder() {
    local kind=$1 mode=$SCAN_MODE name="" c="" brace="\${" fallback=0 found=0 value=""
    [[ $kind == entry ]] && brace="@{"
    while (( SCAN_POS < SCAN_LEN )); do
        c=${SCAN_TEXT:SCAN_POS:1}
        [[ $c == "}" || ${SCAN_TEXT:SCAN_POS:2} == ":-" ]] && break
        name+=$c ; SCAN_POS=$(( SCAN_POS + 1 ))
    done
    (( SCAN_POS < SCAN_LEN )) || { SCAN_ERROR="$brace$name is not closed with }." ; return 1 ; }
    if [[ $kind == env ]]; then
        [[ $name =~ $VAR_NAME_PATTERN ]] \
            || { SCAN_ERROR="\${${name}…}: only \${NAME} and \${NAME:-<fallback>}, NAME a variable name." ; return 1 ; }
    else
        check-vars-name "$name" || return 1
    fi
    if [[ $c == "}" ]]; then SCAN_POS=$(( SCAN_POS + 1 )) ; else SCAN_POS=$(( SCAN_POS + 2 )) fallback=1 ; fi
    if [[ $kind == entry && $mode == check ]]; then
        SCAN_NAMES+=("$name") SCAN_OPTIONAL+=("$(( fallback || SCAN_DEPTH > 0 ))")
    fi
    if [[ $mode == eval || $mode == names ]] && "look-up-$kind" "$name"; then
        found=1 value=$LOOKED_UP
    fi
    if (( fallback )); then
        # Read even when not needed, to get past it; only made when needed.
        (( found )) && SCAN_MODE=skip
        SCAN_DEPTH=$(( SCAN_DEPTH + 1 ))
        scan-text "}" || { SCAN_MODE=$mode ; return 1 ; }
        SCAN_MODE=$mode SCAN_DEPTH=$(( SCAN_DEPTH - 1 ))
        (( found )) || value=$SCAN_OUT
    elif (( ! found )) && [[ $kind == entry && ( $mode == eval || $mode == names ) ]]; then
        SCAN_ERROR="'$name' is not a text or secret in $ENTRIES_IN, and there is no fallback." ; return 1
    elif (( ! found )) && [[ $mode == names ]]; then
        value="[\$$name (unset)]"
    fi
    SCAN_OUT=$value
}

# look-up-env <name>: LOOKED_UP gets ${name}: from a variable set before — by an earlier line, else
# by the entries, --all and --use that feed the vars files — else from the environment EnvFolio
# was started with. Fails when unset or empty.
function look-up-env() {
    local i
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        [[ ${EXEC_VARS[i]} == "$1" ]] || continue
        if [[ $SCAN_MODE == names ]]; then LOOKED_UP="[\$$1]" ; return 0 ; fi
        case ${EXEC_FILES[i]} in
            =*) LOOKED_UP=${VAR_VALUES[${EXEC_FILES[i]#=}]} ;;
            *)  read-entry-value "$VARS_HOW" "${EXEC_FILES[i]}" ; LOOKED_UP=$ENTRY_VALUE ;;
        esac
        [[ -n $LOOKED_UP ]] ; return
    done
    for (( i = 0; i < ${#INPUT_VARS[@]}; i++ )); do
        [[ ${INPUT_VARS[i]} == "$1" ]] || continue
        if [[ $SCAN_MODE == names ]]; then LOOKED_UP="[\$$1 <- $(entry-mark "${INPUT_FILES[i]}")]" ; return 0 ; fi
        read-entry-value "$VARS_HOW" "${INPUT_FILES[i]}" ; LOOKED_UP=$ENTRY_VALUE
        [[ -n $LOOKED_UP ]] ; return
    done
    # printenv, not ${!name}: that would see EnvFolio's own variables.
    if [[ $1 == PASSWORD_STORE_DIR ]]; then LOOKED_UP=$CALLER_STORE_DIR
    else                                    LOOKED_UP=$(printenv "$1") || return 1
    fi
    [[ -n $LOOKED_UP ]] || return 1
    [[ $SCAN_MODE == names ]] && LOOKED_UP="[\$$1]"
    return 0
}

# look-up-entry <name>: LOOKED_UP gets the value of the text or secret <name>. Fails when there is
# none (check-vars-entries already refused a secret without --secrets).
function look-up-entry() {
    local file
    if [[ -f $STORE_PATH/$1.gpg ]] && (( VARS_SECRETS )); then file=$1.gpg
    elif [[ -f $STORE_PATH/$1.txt ]]; then                   file=$1.txt
    else return 1
    fi
    if [[ $SCAN_MODE == names ]]; then
        LOOKED_UP="[$(entry-mark "$file")]"
        return 0
    fi
    read-entry-value "$VARS_HOW" "$file"
    LOOKED_UP=$ENTRY_VALUE
}

# check-vars-entries <how> <secrets>: before anything is read, stop at an entry the vars files
# name that is a secret without --secrets, or both a text and a secret — wherever it is, a
# fallback not needed today too — at an @{folder/*} holding secrets without --secrets, and at an
# @{…} line's entry or folder that is not there.
function check-vars-entries() {
    local how=$1 secrets=$2 i name count
    for (( i = 0; i < ${#VARS_KIND[@]}; i++ )); do
        if [[ ${VARS_KIND[i]} == entries ]]; then
            name=${VARS_NAME[i]}
            if [[ $name == */\* ]]; then
                name=${name%/\*}
                [[ -d $STORE_PATH/$name ]] || die "$how: ${VARS_AT[i]}: '$name' is not a folder in $ENTRIES_IN."
                # The file asks for all of it: secrets without --secrets stop it (typed, they are
                # left out with a note).
                if (( ! secrets )); then
                    count=$(find "$STORE_PATH/$name" -mindepth 1 -name '.*' -prune -o -type f -name '*.gpg' -print | wc -l)
                    count=${count//[[:blank:]]/}
                    (( count == 0 )) \
                        || die "$how: ${VARS_AT[i]}: '$name' has $count secret(s); add --secrets to load them."
                fi
            else
                [[ -f $STORE_PATH/$name.txt || -f $STORE_PATH/$name.gpg ]] \
                    || die "$how: ${VARS_AT[i]}: '$name' is not a text or secret in $ENTRIES_IN."
                [[ -f $STORE_PATH/$name.txt ]] || (( secrets )) \
                    || die "$how: ${VARS_AT[i]}: '$name' is a secret; add --secrets to load it."
            fi
            continue
        fi
        SCAN_MODE=check
        scan-value "${VARS_TEXT[i]}"
        for name in ${SCAN_NAMES[@]+"${SCAN_NAMES[@]}"}; do
            if [[ -f $STORE_PATH/$name.gpg && ! -f $STORE_PATH/$name.txt ]] && (( ! secrets )); then
                die "$how: ${VARS_AT[i]}: '$name' is a secret; add --secrets to load it."
            fi
            if [[ -f $STORE_PATH/$name.gpg && -f $STORE_PATH/$name.txt ]] && (( secrets )); then
                die "$how: ${VARS_AT[i]}: '$name' is both a text and a secret; rename one."
            fi
        done
    done
}

# apply-vars <how> <secrets> <names:0|1>: set what the vars files say, line by line, into
# EXEC_VARS/EXEC_FILES; a VAR=<value> as =<i>, its value made now into VAR_VALUES[i] (with names,
# how it would be made). A later line overrides an earlier one; ${NAME} sees the earlier ones.
function apply-vars() {
    local how=$1 secrets=$2 i name count
    VARS_HOW=$how VARS_SECRETS=$secrets
    for (( i = 0; i < ${#VARS_KIND[@]}; i++ )); do
        name=${VARS_NAME[i]}
        if [[ ${VARS_KIND[i]} == entries ]]; then
            start-selection "${VARS_AT[i]}"
            if [[ $name == */\* ]]; then add-folder "$how" "$secrets" "${name%/\*}"
            else entry-file "$how" "$secrets" "$name" ; add-derived "$how" "$ENTRY_FILE"
            fi
            continue
        fi
        if (( $3 )); then SCAN_MODE="names" ; else SCAN_MODE="eval" ; fi
        scan-value "${VARS_TEXT[i]}" || die "$how: ${VARS_AT[i]}: $SCAN_ERROR"
        VAR_VALUES+=("$SCAN_OUT")
        set-entry-var "$name" "=$(( ${#VAR_VALUES[@]} - 1 ))"
    done
    unset SCAN_OUT LOOKED_UP ENTRY_VALUE
}

# vars-items <how> <secrets>: VARS_ITEMS gets the file of every item the vars files name
# (<name>.txt or <name>.gpg), in order; one named twice is there twice. Only names are looked at:
# nothing is read or decrypted. For export, which takes them all, not only the ones needed here
# today. Stops as check-vars-entries does (a secret without --secrets, wherever it is), and at an
# @{…} that is not there with nothing to fall back to; one that has a fallback, or is in one, is
# left out with a note.
function vars-items() {
    local how=$1 secrets=$2 i j name file
    VARS_ITEMS=()
    check-vars-entries "$how" "$secrets"
    for (( i = 0; i < ${#VARS_KIND[@]}; i++ )); do
        name=${VARS_NAME[i]}

        # An @{folder/*} line: every item under the folder.
        if [[ ${VARS_KIND[i]} == entries && $name == */\* ]]; then
            while IFS= read -r file; do
                VARS_ITEMS+=("${file#"$STORE_PATH"/}")
            done < <(entries-under "$secrets" "$STORE_PATH/${name%/\*}")
            continue
        fi

        # An @{name} line: that item (check-vars-entries made sure it is there).
        if [[ ${VARS_KIND[i]} == entries ]]; then
            entry-file "$how" "$secrets" "$name"
            VARS_ITEMS+=("$ENTRY_FILE")
            continue
        fi

        # A VAR=<value> line: every @{…} in the value, also in a fallback.
        SCAN_MODE=check
        scan-value "${VARS_TEXT[i]}"
        for (( j = 0; j < ${#SCAN_NAMES[@]}; j++ )); do
            name=${SCAN_NAMES[j]}
            if [[ -f $STORE_PATH/$name.gpg ]] && (( secrets )); then
                VARS_ITEMS+=("$name.gpg")
            elif [[ -f $STORE_PATH/$name.txt ]]; then
                VARS_ITEMS+=("$name.txt")
            elif (( SCAN_OPTIONAL[j] )); then
                printf "folio %s: %s: '%s' is not a text or secret in the store; left out (it has a fallback or is one).\n" \
                    "$how" "${VARS_AT[i]}" "$name" >&2
            else
                die "$how: ${VARS_AT[i]}: '$name' is not a text or secret in the store, and there is no fallback."
            fi
        done
    done
}

#== Command: Completion ========================================================

function completion-help() {
    cat <<'EOF'
Usage: folio completion bash|zsh

Print the script that makes Tab complete folio's commands, their options, and the names of texts
and secrets — names only: nothing is read or decrypted. Load it from your shell's startup file:

  bash, in ~/.bashrc:   eval "$(folio completion bash)"
  zsh,  in ~/.zshrc:    eval "$(folio completion zsh)"

Options:
  -h, --help          Show this help and stop.
EOF
}

# folio completion bash|zsh
Completion() {
    case ${1:-} in
        -h|--help) completion-help ;;
        bash)      completion-bash ;;
        zsh)       completion-zsh  ;;
        "")        die "completion: which shell? Put \`eval \"\$(folio completion bash)\"\` in ~/.bashrc," \
                       "or \`eval \"\$(folio completion zsh)\"\` in ~/.zshrc." ;;
        *)         die "completion: there is none for '$1'; there is for bash and zsh." ;;
    esac
}

# The script for bash: plain bash 3.2 (no compopt, no bash-completion package). It asks
# `folio __complete` what fits, as the zsh one does.
function completion-bash() {
    cat <<'EOF'
# Tab completion for folio (EnvFolio), from `folio completion bash`.
_folio() {
    local line cur trim how item folio
    local -a words
    COMPREPLY=()
    # The words up to the cursor, split at blanks only: COMP_WORDS also splits at = and :.
    line=${COMP_LINE:0:COMP_POINT}
    IFS=$' \t' read -r -a words <<< "$line"
    [[ $line == *[[:blank:]] || ${#words[@]} -eq 0 ]] && words+=("")
    cur=${words[${#words[@]}-1]}
    folio=${words[0]}
    [[ $folio == '~/'* ]] && folio=$HOME/${folio#'~/'}
    # bash replaces only what follows the last = or : in the word, so that much is cut off.
    trim=${cur%"${cur##*[=:]}"}
    how=
    while IFS= read -r item; do
        if [[ -z $how ]]; then how=$item ; continue ; fi
        item=${item%%$'\t'*}
        COMPREPLY+=("${item#"$trim"}")
    done < <("$folio" __complete "${words[@]:1}" 2>/dev/null)
    case $how in
        files)    while IFS= read -r item; do COMPREPLY+=("$item"); done < <(compgen -f -- "$cur") ;;
        dirs)     while IFS= read -r item; do COMPREPLY+=("$item"); done < <(compgen -d -- "$cur") ;;
        commands) while IFS= read -r item; do COMPREPLY+=("$item"); done < <(compgen -c -- "$cur") ;;
    esac
}
complete -o filenames -F _folio folio
EOF
}

# The script for zsh: its own completion system, with a description beside each choice.
function completion-zsh() {
    cat <<'EOF'
# Tab completion for folio (EnvFolio), from `folio completion zsh`.
_folio() {
    local how line word desc folio=${words[1]}
    local -a lines plain folders
    [[ $folio == '~/'* ]] && folio=$HOME/${folio#'~/'}
    lines=( "${(@f)$("$folio" __complete "${(@)words[2,CURRENT]}" 2>/dev/null)}" )
    how=${lines[1]}
    case $how in
        files)    _files ;;
        dirs)     _files -/ ;;
        commands) _command_names -e ;;
        words)
            for line in "${(@)lines[2,-1]}"; do
                word=${line%%$'\t'*} desc=${line#*$'\t'}
                [[ $line == *$'\t'* ]] || desc=
                word=${word//:/\\:}
                if [[ $word == */ ]]; then folders+=( "$word${desc:+:$desc}" )
                else                      plain+=( "$word${desc:+:$desc}" ) ; fi
            done
            (( ${#plain} ))   && _describe -t values 'folio' plain
            (( ${#folders} )) && _describe -t folders 'folder' folders -S ''
            ;;
    esac
    return 0
}
# -i: skip completion files zsh does not trust, rather than ask (no one may be there to answer).
(( $+functions[compdef] )) || { autoload -Uz compinit && compinit -i ; }
compdef _folio folio
EOF
}

# folio __complete <word>...: what Tab can put for the last word (maybe empty), given the words
# after `folio` before it. Asked by the scripts of `folio completion`, not by a person. The first
# line says how: words, files, dirs, commands or none. For words, each follows on a line of its
# own as <word><tab><description>; a word ending in / is a folder, so no space goes after it.
# Options come from each command's help (its Options:), so one completes once it is documented;
# what a command's other arguments are is in completion-args.
function complete-words() {
    local words=("$@") cur key at=1 options value="" dashes=-1 count=0 last="" i word kind
    local -a kinds
    (( ${#words[@]} > 0 )) || words=("")
    # --fresh-passphrase goes with every command, anywhere: the words before the last are taken without it.
    for (( i = ${#words[@]} - 2; i >= 0; i-- )); do
        [[ ${words[i]} == --fresh-passphrase ]] && words=("${words[@]:0:i}" "${words[@]:i+1}")
    done
    cur=${words[${#words[@]}-1]}
    if (( ${#words[@]} == 1 )); then complete-commands "" "$cur" ; return 0 ; fi
    key=${words[0]}
    if [[ $key == text || $key == secret || $key == vars ]]; then
        if (( ${#words[@]} == 2 )); then complete-commands "$key" "$cur" ; return 0 ; fi
        key="$key ${words[1]}" at=2
    elif (( ${#words[@]} == 2 )) && is-action "$key"; then
        # The kinds it is for; ls also lists both together, so its folders too.
        if [[ $key == ls ]]; then
            { complete-commands ls "$cur" ; complete-entries all "$cur" folders | tail -n +2 ; }
        else
            complete-commands "$key" "$cur"
        fi
        return 0
    elif is-action-first "$key" "${words[1]}"; then
        key="${words[1]} $key" at=2
    fi
    kind=$(completion-args "$key") || { echo none ; return 0 ; }
    read -r -a kinds <<< "$kind"
    options=$(help-options "$key")

    for (( i = at; i < ${#words[@]} - 1; i++ )); do
        word=${words[i]}
        if [[ -n $value ]]; then value= ; continue ; fi        # the value of the option before it
        if (( dashes >= 0 )); then dashes=$(( dashes + 1 )) ; continue ; fi
        case $word in
            --)  dashes=0 ;;
            -?*) value=$(option-value "$word" "$options") ;;
            *)   count=$(( count + 1 )) last=$word ;;
        esac
    done
    if [[ $value == namespaces ]]; then complete-namespaces "$cur" ; return 0 ; fi
    if [[ -n $value ]]; then echo "$value" ; return 0 ; fi
    if (( dashes >= 0 )); then
        # After `--`: exec's command and its arguments; for the others, more of the same arguments.
        if [[ $key == exec ]]; then
            if (( dashes == 0 )); then echo commands ; else echo files ; fi
            return 0
        fi
        count=$(( count + dashes ))
    elif [[ $cur == -* ]]; then
        complete-options "$cur" "$options" ; return 0
    fi

    # The kind of the argument at <count>; the last kind, marked ..., stands for all the rest.
    if (( count < ${#kinds[@]} )); then kind=${kinds[count]}
    else kind=${kinds[${#kinds[@]}-1]} ; [[ $kind == *... ]] || kind=none ; fi
    case ${kind%...} in
        none|files|dirs) echo "${kind%...}" ;;
        text)            complete-entries txt "$cur" ;;
        secret)          complete-entries gpg "$cur" ;;
        entry)
            # VAR=<name> picks the variable's name: complete the name after the =.
            if [[ $cur == *=* ]]; then complete-entries all "${cur#*=}" "" "${cur%%=*}="
            else                       complete-entries all "$cur" ; fi ;;
        text-folder)     complete-entries txt "$cur" folders ;;
        secret-folder)   complete-entries gpg "$cur" folders ;;
        entry-folder)    complete-entries all "$cur" folders ;;
        shell)           printf 'words\nbash\tFor bash\nzsh\tFor zsh\n' | complete-matching "$cur" ;;
        help)
            if (( count == 0 )); then complete-commands "" "$cur"
            elif (( count == 1 )) && { [[ $last == text || $last == secret || $last == vars ]] || is-action "$last" ; }; then
                complete-commands "$last" "$cur"
            else echo none ; fi ;;
        *)               echo none ;;
    esac
}

# complete-namespaces <cur>: as complete-entries does for folders, but only the namespaces (@…),
# deeper ones too (@app2/@prod/), for --use.
function complete-namespaces() {
    local line word
    complete-entries all "$1" folders | {
        IFS= read -r line && echo "$line"
        while IFS= read -r line; do
            word=${line%%$'\t'*} word=${word%/}
            [[ ${word##*/} == @* ]] && echo "$line"
        done
        return 0
    }
}

# completion-args <command>: the kinds of its arguments, in order; one marked ... stands for all
# the rest. Fails for a command it does not know. Kinds: none, files, dirs, text, secret, entry
# (either, or a folder of them), text-folder, secret-folder, entry-folder, shell, help.
# A new command needs a line here: tests/completion/completion.bats fails until it has one.
# <command> is the kind first (text show), as the code takes it; show text is taken as that too.
function completion-args() {
    local command=$1
    is-action-first "${command%% *}" "${command#* }" && command="${command#* } ${command%% *}"
    case $command in
        init|path|version)            echo none ;;
        backup|restore)               echo files ;;
        import)                       echo "files none..." ;;
        export|exec|shell)            echo "entry..." ;;
        ls)                           echo entry-folder ;;
        completion)                   echo shell ;;
        help)                         echo "help..." ;;
        "text ls")                    echo text-folder ;;
        "text find"|"text grep")      echo none ;;
        "text show"|"text insert"|"text edit"|"text rm") echo text ;;
        "text generate")              echo "text none" ;;
        "text mv"|"text cp")          echo "text text" ;;
        "secret ls")                  echo secret-folder ;;
        "secret find"|"secret grep")  echo none ;;
        "secret show"|"secret insert"|"secret edit"|"secret rm") echo secret ;;
        "secret generate")            echo "secret none" ;;
        "secret mv"|"secret cp")      echo "secret secret" ;;
        "vars check")                 echo "files..." ;;
        *)                            return 1 ;;
    esac
}

# complete-matching <cur>: pass on the header line, then the <word><tab><description> lines whose
# word starts with <cur>.
function complete-matching() {
    local line
    IFS= read -r line && echo "$line"
    while IFS= read -r line; do
        [[ ${line%%$'\t'*} == "$1"* ]] && echo "$line"
    done
    return 0
}

# complete-commands <group> <cur>: the commands in `folio help` that start with <cur>, each with its
# description from there. A kind's command (show text) is offered a word at a time: without
# <group>, its action (show, described "text|secret"); with <group>, what goes after it — a
# kind's actions (text: ls, find, …) or an action's kinds (show: text, secret).
function complete-commands() {
    local group=$1 line name desc in=0 i k kind action kinds seen=" " singles=" " kind_actions=" "
    local -a names=() descs=()
    while IFS= read -r line; do
        [[ $line == Commands:* ]] && { in=1 ; continue ; }
        [[ -z $line ]] && in=0
        [[ $in == 1 && $line == "  "[a-z]* ]] || continue
        line=${line#  } name=${line%%  *}
        desc=${line#"$name"} ; desc=${desc#"${desc%%[! ]*}"}
        name=${name%% \[*}                                       # "help [command]"
        if [[ $name == *" "* ]]; then
            # Kept as <kind>:<action>, whichever way round `folio help` lists it.
            is-action-first "${name%% *}" "${name#* }" && name="${name#* } ${name%% *}"
            name=${name/ /:} ; kind_actions+="$name "
        else
            singles+="$name "
        fi
        names+=("$name") descs+=("$desc")
    done < <(folio-help)
    {
        echo words
        for (( i = 0; i < ${#names[@]}; i++ )); do
            name=${names[i]} desc=${descs[i]}
            if [[ $name == *:* ]]; then
                kind=${name%:*} action=${name#*:}
                if   [[ $group == "$kind" ]];   then name=$action
                elif [[ $group == "$action" ]]; then name=$kind
                elif [[ -n $group || $singles == *" $action "* ]]; then continue   # ls: its own line
                else
                    name=$action kinds=""
                    for k in text secret vars; do [[ $kind_actions == *" $k:$action "* ]] && kinds+="${kinds:+|}$k" ; done
                    desc=$kinds
                fi
            elif [[ -n $group ]]; then
                continue
            fi
            [[ $seen == *" $name "* ]] && continue
            seen+="$name "
            printf '%s\t%s\n' "$name" "$desc"
        done
    } | complete-matching "$2"
}

# help-options <command>: its options, from the Options: of its help, one line each:
# <option><tab><what its value is: files, dirs, none, or - when it takes none><tab><description>.
# Then --fresh-passphrase, which every command takes.
function help-options() {
    local line row="" in=0
    while IFS= read -r line; do
        if [[ $line == Options:* ]]; then in=1 ; continue ; fi
        (( in )) || continue
        [[ -z $line ]] && break
        if [[ $line == "  -"* || $line == "      -"* ]]; then
            [[ -z $row ]] || help-option-lines "$row" ""
            row=${line#"${line%%-*}"}
        elif [[ -n $row ]]; then
            help-option-lines "$row" "${line#"${line%%[! ]*}"}"
            row=
        fi
    done < <(Help "$@" 2>/dev/null)
    [[ -z $row ]] || help-option-lines "$row" ""
    printf '%s\t-\t%s\n' --fresh-passphrase "Have gpg-agent forget the store key's passphrase at the start and the end"
}

# help-option-lines <row> <next line>: help-options' lines for one row of Options:, e.g.
# "-o, --output <file>|<folder>  Write to…". The description is the rest of the row — or the next
# line, when the row has none — cut to its first sentence.
function help-option-lines() {
    local token value=- desc=""
    local -a tokens names=()
    read -r -a tokens <<< "${1//, / }"
    for token in "${tokens[@]}"; do
        if [[ -n $desc ]]; then desc+=" $token" ; continue ; fi
        case $token in
            -*)                   names+=("${token%%\[*}") ;;     # --clip[=<line>]: its value is optional
            "<file>"*|"<key>"*)   value=files ;;
            "<folder>"*)          value=dirs ;;
            "<@namespace>"*)      value=namespaces ;;
            "<"*)                 value=none ;;
            *)                    desc=$token ;;
        esac
    done
    [[ -n $desc ]] || desc=$2
    desc=${desc%%. *} ; desc=${desc%%; *} ; desc=${desc%, e.g.} ; desc=${desc%[.,]}
    for token in "${names[@]}"; do printf '%s\t%s\t%s\n' "$token" "$value" "$desc" ; done
}

# option-value <word> <options>: how to complete the value <word> takes (files, dirs or none), or
# nothing when it takes none — or has it already, after =.
function option-value() {
    local name value rest
    [[ $1 == *=* ]] && return 0
    while IFS=$'\t' read -r name value rest; do
        [[ $name == "$1" && $value != - ]] && { echo "$value" ; return 0 ; }
    done <<< "$2"
}

# complete-options <cur> <options>: the options that start with <cur>. Only the long ones for - or
# --; a short one (-c) completes only as itself.
function complete-options() {
    local name value desc
    echo words
    while IFS=$'\t' read -r name value desc; do
        [[ -n $name && $name == "$1"* ]] || continue
        [[ $1 != - && $1 != --* || $name == --* ]] || continue
        printf '%s\t%s\n' "$name" "$desc"
    done <<< "$2"
}

# complete-entries <txt|gpg|all> <cur> [folders] [<prefix>]: the texts (txt), secrets (gpg) or both
# whose names start with <cur>, a level at a time: what is deeper shows as its folder ("web/").
# A folder that is the only choice is opened, so Tab goes on into it. With folders, only folders.
# <prefix> goes in front of each (VAR= for exec). Names only: no file is read.
function complete-entries() {
    local kind=$1 cur=$2 folders=${3:-} prefix=${4:-} found more
    found=$(store-names-at "$kind" "$cur" "$folders")
    # One folder and nothing else: what is in it instead.
    while [[ -z $folders && -n $found && $found != *$'\n'* && ${found%%$'\t'*} == */ ]]; do
        more=$(store-names-at "$kind" "${found%%$'\t'*}" "")
        [[ -n $more ]] || break
        found=$more
    done
    echo words
    [[ -n $found ]] && printf '%s\n' "$found" | while IFS= read -r more; do printf '%s%s\n' "$prefix" "$more" ; done
    return 0
}

# store-names-at <txt|gpg|all> <cur> [folders]: complete-entries' lines for one level, sorted, a
# name that is both a text and a secret once ("text, secret").
function store-names-at() {
    local kind=$1 cur=$2 folders=${3:-} file name rest what
    [[ -d $STORE_PATH ]] || return 0
    find -L "$STORE_PATH" -mindepth 1 -name '.*' -prune -o -type f \( -name '*.gpg' -o -name '*.txt' \) -print \
        | while IFS= read -r file; do
            name=${file#"$STORE_PATH"/}
            case $kind:$name in
                gpg:*.gpg|all:*.gpg) name=${name%.gpg} what=secret ;;
                txt:*.txt|all:*.txt) name=${name%.txt} what=text   ;;
                *)                   continue ;;
            esac
            [[ $name == "$cur"* ]] || continue
            rest=${name#"$cur"}
            if [[ $rest == */* ]]; then printf '%s\t%s\n' "$cur${rest%%/*}/" folder
            elif [[ -z $folders ]]; then printf '%s\t%s\n' "$name" "$what"
            fi
        done \
        | LC_ALL=C sort -u \
        | awk -F'\t' '$1 == last { kinds = kinds ", " $2 ; next }
                      NR > 1     { print last "\t" kinds }
                                 { last = $1 ; kinds = $2 }
                      END        { if (NR) print last "\t" kinds }'
}

#== Common Functions ===========================================================

# --- Passphrases --------------------------------------------------------------

# check-passphrase-fd <option> <fd>: die unless <fd> is a file descriptor number that is open.
function check-passphrase-fd() {
    [[ $2 =~ ^[0-9]+$ ]]          || die "$1 needs a file descriptor number, not '$2'."
    { : <&"$2" ; } 2>/dev/null    || die "$1 $2: no such file descriptor is open."
}

# read-passphrase-fd <fd>: set PASSPHRASE to the first line of fd <fd>, then close it (unless it is
# stdin, stdout or stderr), so nothing EnvFolio starts — the command `folio exec` runs — gets it.
# Dies when the line is empty.
function read-passphrase-fd() {
    PASSPHRASE=""
    IFS= read -rs -u "$1" PASSPHRASE || true
    (( $1 <= 2 )) || eval "exec $1<&-"    # <fd> is digits only (check-passphrase-fd)
    [[ -n $PASSPHRASE ]] || die "No passphrase on file descriptor $1."
}

# take-store-passphrase-fd [args...]: take --store-passphrase-fd <n> (or =<n>) out of the args
# (up to a --), checked, into STORE_PASSPHRASE_FD; the rest go into ARGS.
STORE_PASSPHRASE_FD="" STORE_PASSPHRASE=""
function take-store-passphrase-fd() {
    local arg
    ARGS=()
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            --)  ARGS+=("$arg" "$@") ; break ;;
            --store-passphrase-fd)
                 [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                 STORE_PASSPHRASE_FD=$1 ; shift ;;
            --store-passphrase-fd=*)
                 STORE_PASSPHRASE_FD=${arg#*=} ;;
            *)   ARGS+=("$arg") ;;
        esac
    done
    [[ -z $STORE_PASSPHRASE_FD ]] || check-passphrase-fd --store-passphrase-fd "$STORE_PASSPHRASE_FD"
}

# load-store-passphrase: with --store-passphrase-fd, read the store key's passphrase into
# STORE_PASSPHRASE — once: the fd is closed after.
function load-store-passphrase() {
    [[ -n $STORE_PASSPHRASE_FD && -z $STORE_PASSPHRASE ]] || return 0
    read-passphrase-fd "$STORE_PASSPHRASE_FD"
    STORE_PASSPHRASE=$PASSPHRASE
    unset PASSPHRASE
}

# unlock-store-key: with --store-passphrase-fd, hand the store key's passphrase to gpg-agent once,
# by signing and decrypting a word with it (gpg's loopback mode). The agent keeps it for its cache
# time, as when it is typed, so the gpg calls after — pass's too — ask nothing. Signing and
# decrypting use different subkeys: each is unlocked. A wrong passphrase stops here, before
# anything changes.
STORE_UNLOCKED=0
function unlock-store-key() {
    [[ -n $STORE_PASSPHRASE_FD ]] && (( ! STORE_UNLOCKED )) || return 0
    local key unlock=(gpg --batch --quiet --pinentry-mode loopback --passphrase-fd 3)
    load-store-passphrase
    key=$(head -n 1 "$STORE_PATH/.gpg-id")
    # The passphrase reaches gpg on fd 3 (printf is a builtin: never in argv).
    if ! printf 'folio\n' | "${unlock[@]}" --local-user "$key" --sign > /dev/null \
             3< <(printf '%s\n' "$STORE_PASSPHRASE") \
       || ! printf 'folio\n' | gpg --batch --quiet --trust-model always --encrypt --recipient "$key" \
             | "${unlock[@]}" --decrypt > /dev/null 3< <(printf '%s\n' "$STORE_PASSPHRASE"); then
        die "The passphrase on file descriptor $STORE_PASSPHRASE_FD does not unlock the store's key $key."
    fi
    STORE_UNLOCKED=1
}

# --- Fresh passphrase ---------------------------------------------------------

# With --fresh-passphrase (or FOLIO_FRESH_PASSPHRASE=1), gpg-agent forgets the store key's
# passphrase when the command starts — so it is asked, or taken from --store-passphrase-fd, even
# when the agent had it — and again when it ends: in the EXIT trap, and for exec and shell just
# before the command starts, every value read by then (remove-now). At the end, it also forgets a
# key that it did not have before the command and has after (the key a --from file is locked to).
# During the command the agent keeps them as usual, so one is asked once. gpg-agent keeps a
# passphrase per keygrip: of each key, and of each of its subkeys. The passphrases that lock a
# backup or an export are not kept at all (--no-symkey-cache). Other keys are left as they were —
# though gpg-agent tries the passphrases it has on a key it has none for, so one with the same
# passphrase still unlocks the store key (MANUAL: Leave no passphrase behind).
FRESH_PASSPHRASE=0 FRESH_STORE_PATH="" FRESH_CACHED=""

# take-fresh-passphrase [args...]: take --fresh-passphrase out of the args (up to a --) into
# FRESH_PASSPHRASE, also set by FOLIO_FRESH_PASSPHRASE=1; the rest go into ARGS.
function take-fresh-passphrase() {
    local arg
    case ${FOLIO_FRESH_PASSPHRASE:-} in
        ""|0) ;;
        1)    FRESH_PASSPHRASE=1 ;;
        *)    die "FOLIO_FRESH_PASSPHRASE is 1 (on) or 0 (off), not '$FOLIO_FRESH_PASSPHRASE'." ;;
    esac
    ARGS=()
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            --)                 ARGS+=("$arg" "$@") ; break ;;
            --fresh-passphrase) FRESH_PASSPHRASE=1 ;;
            *)                  ARGS+=("$arg") ;;
        esac
    done
}

# start-fresh-passphrase: with --fresh-passphrase, have gpg-agent forget the store key's passphrase
# now, and once more when EnvFolio exits. The store is kept by its path now: STORE_PATH points at an
# export or a view for a while.
function start-fresh-passphrase() {
    (( FRESH_PASSPHRASE )) || return 0
    command -v gpg-connect-agent >/dev/null 2>&1 \
        || die "--fresh-passphrase needs gpg-connect-agent (it comes with gpg), to have gpg-agent forget a passphrase."
    FRESH_STORE_PATH=$STORE_PATH
    local grips
    grips=$(store-keygrips)
    # shellcheck disable=SC2086  # keygrips are hex, one word each
    forget-keygrips $grips || die "gpg-agent did not forget the store key's passphrase; nothing was done."
    FRESH_CACHED=" $(cached-keygrips | tr '\n' ' ')"
    trap remove-now EXIT
}

# forget-passphrases: have gpg-agent forget the store key's passphrase, and those of the keys it did
# not have at the start; warn when it does not.
function forget-passphrases() {
    local grip grips
    grips=$(store-keygrips)
    for grip in $(cached-keygrips); do
        [[ $FRESH_CACHED == *" $grip "* ]] || grips+=" $grip"
    done
    # shellcheck disable=SC2086  # keygrips are hex, one word each
    forget-keygrips $grips || printf 'folio: gpg-agent may still have a passphrase: it did not forget it.\n' >&2
}

# store-keygrips: the keygrips of the store's keys (each one in its .gpg-id) and of their subkeys —
# two for a post-quantum subkey (ML-KEM and ECC), which gpg lists as one, joined by a comma.
function store-keygrips() {
    local id ids=()
    [[ -f $FRESH_STORE_PATH/.gpg-id ]] || return 0
    while IFS= read -r id; do [[ -n $id ]] && ids+=("$id") ; done < "$FRESH_STORE_PATH/.gpg-id"
    (( ${#ids[@]} > 0 )) || return 0
    gpg --list-keys --with-keygrip --with-colons -- "${ids[@]}" 2>/dev/null | awk -F: '$1 == "grp" { gsub(",", "\n", $10) ; print $10 }'
}

# agent-is-running: whether gpg-agent runs (none started: one that is not running keeps nothing).
function agent-is-running() {
    gpg-connect-agent --no-autostart 'getinfo version' /bye 2>/dev/null | grep -q '^OK'
}

# cached-keygrips: the keygrips gpg-agent has a passphrase for (KEYINFO's 7th field is 1).
function cached-keygrips() {
    agent-is-running || return 0
    gpg-connect-agent --no-autostart 'keyinfo --list' /bye 2>/dev/null \
        | awk '$1 == "S" && $2 == "KEYINFO" && $7 == "1" { print $3 }'
}

# forget-keygrips <keygrip>...: have gpg-agent forget the passphrase of each; fail when it does not.
function forget-keygrips() {
    local grip failed=0
    agent-is-running || return 0
    for grip in "$@"; do
        gpg-connect-agent --no-autostart "clear_passphrase --mode=normal $grip" /bye 2>/dev/null \
            | grep -q '^OK' || failed=1
    done
    return "$failed"
}

# --- Pass ---------------------------------------------------------------------

# call-pass <help-function> <pass-command> [args...]
# Show EnvFolio's help on -h/--help (before any --); otherwise hand everything to `pass <command>`,
# dropping what was typed before, as EnvFolio's own prompts do: pass may ask (rm, an overwrite).
function call-pass() {
    local help=$1 command=$2 arg ; shift 2
    for arg in "$@"; do
        case $arg in
            --)        break ;;
            -h|--help) "$help" ; return 0 ;;
        esac
    done
    drop-typeahead
    pass "$command" "$@"
}

# list-store <gpg|txt|all> <title> <command> [--flat] [--plain] [<subfolder>]: what `folio ls`, `ls text`
# and `ls secret` share — the tree under <title>, or with --flat, the full names one per line.
function list-store() {
    local kind=$1 title=$2 command=$3 flat=0 args=() arg ; shift 3
    for arg in "$@"; do
        case $arg in
            --flat)  flat=1 ;;
            --plain) PLAIN=1 ;;
            *)       args+=("$arg") ;;
        esac
    done
    set -- "${args[@]}"
    (( $# <= 1 )) || die "Usage: folio $command [--flat] [--plain] [<subfolder>]"
    [[ $# -eq 0 || ( $1 != -* && /$1/ != */../* && -d $STORE_PATH/$1 ) ]] \
        || die "$command: '$1' is not a folder in the store."
    if (( flat )); then store-flat "$kind" "$STORE_PATH${1:+/${1%/}}" ; return ; fi
    echo "$title"
    [[ $# -eq 0 ]] || echo "${1%/}"
    store-tree "$kind" "$STORE_PATH/${1:-}"
}

# store-flat <gpg|txt|all> <folder>: as store-tree, but full names one per line, sorted. With all,
# each name gets its mark (set-marks) in front. Follows links, as tree -l does; hidden ones (.git)
# left out.
function store-flat() {
    local kind=$1 file
    set-marks
    find -L "$2" -mindepth 1 -name '.*' -prune -o -type f \( -name '*.gpg' -o -name '*.txt' \) -print \
        | LC_ALL=C sort \
        | while IFS= read -r file; do
            file=${file#"$STORE_PATH"/}
            case $kind:$file in
                gpg:*.gpg) echo "$SECRET_ON${file%.gpg}$COLOR_OFF" ;;
                txt:*.txt) echo "$TEXT_ON${file%.txt}$COLOR_OFF" ;;
                all:*.gpg) echo "$SECRET_ON$SECRET_MARK${file%.gpg}$COLOR_OFF" ;;
                all:*.txt) echo "$TEXT_ON$TEXT_MARK${file%.txt}$COLOR_OFF" ;;
            esac
        done
}

# store-tree <gpg|txt|all> <folder> [tree-option...]: the secrets (gpg), the texts (txt) or both
# (all) under <folder> as a tree, names only. pass's own `tree` line (ls, find), plus leaving out
# signatures, the other kind, and folders left empty. With all, each name gets its mark in front.
# Marks and colours as set-marks says; tree colours (its folders) only when there are colours.
function store-tree() {
    local kind=$1 folder=$2 others color=-n s='' t='' esc=$'\e' ; shift 2
    case $kind in
        gpg) others='*.txt|*.txt.sig' ;;
        txt) others='*.gpg|*.txt.sig' ;;
        all) others='*.txt.sig'       ;;
    esac
    set-marks
    [[ $kind != all ]] || s="$SECRET_MARK" t="$TEXT_MARK"
    [[ -z $COLOR_OFF ]] || color=-C
    # "├── name.gpg" -> "├── (S)name", tree's own colour for the name swapped for ours; tree draws
    # "|-- " instead outside UTF-8. A real ESC, not \x1B, which BSD sed (macOS) does not know.
    tree -N "$color" -l --noreport -I "$others" --prune "$@" "$folder" | tail -n +2 \
        | sed -E -e "s/^(.*(── |-- ))($esc\[[0-9;]*m)?(.*)\.gpg($esc\[[0-9;]*m)?( ->.*)?\$/\1$SECRET_ON$s\4$COLOR_OFF\6/" \
                 -e "s/^(.*(── |-- ))($esc\[[0-9;]*m)?(.*)\.txt($esc\[[0-9;]*m)?( ->.*)?\$/\1$TEXT_ON$t\4$COLOR_OFF\6/"
}

# --plain: (S)/(T) and no colour, even on a screen.
PLAIN=0
# on-screen: stdout (or SCREEN_FD, where the marks are shown) is a terminal.
SCREEN_FD=1
function on-screen() { [[ -t $SCREEN_FD ]] ; }
# use-color: true when stdout is a screen that shows colour — a terminal, not TERM=dumb, and no
# NO_COLOR (https://no-color.org) or --plain.
function use-color() { (( ! PLAIN )) && on-screen && [[ -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]] ; }
# use-emoji: true when stdout is a screen that draws emoji — a terminal, a UTF-8 locale, not
# TERM=dumb or the Linux console (TERM=linux), no --plain, and the terminal says so when asked
# (terminal-draws-emoji, asked once: its answer is kept in DRAWS_EMOJI).
DRAWS_EMOJI=''
function use-emoji() {
    (( ! PLAIN )) && on-screen && [[ ${TERM:-dumb} != dumb && $TERM != linux ]] || return 1
    case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;; *) return 1 ;; esac
    if [[ -z $DRAWS_EMOJI ]]; then
        if terminal-draws-emoji; then DRAWS_EMOJI=1; else DRAWS_EMOJI=0; fi
    fi
    (( DRAWS_EMOJI ))
}
# terminal-draws-emoji: ask the terminal (TTY_PATH) whether it draws an emoji as one, two cells
# wide: write 🔑 at the start of the line, ask where the cursor is (ESC[6n, answered ESC[<row>;<col>R),
# then wipe the line. Column 3: yes. Another column (drawn narrow, or as its bytes), no terminal, or
# no answer within a second: no. What was typed before is dropped, so it cannot pass for the answer.
# The wait is read's own -t: with -d, read sets the terminal to wait for a key, whatever stty says.
TTY_PATH=/dev/tty    # the terminal asked; tests point it elsewhere
# shellcheck disable=SC2094  # a terminal is read and written both: that is how it is asked
function terminal-draws-emoji() {
    local reply=''
    drop-typeahead
    printf '\r🔑\e[6n'
    IFS= read -r -s -d R -t 1 reply
    printf '\r\e[K'
    [[ $reply == *\;3 ]]
} 2>/dev/null <"$TTY_PATH" >"$TTY_PATH"
# set-marks: how a secret and a text are marked, for this stdout — SECRET_MARK and TEXT_MARK (🔑
# and 📄 on a screen that draws emoji, else (S) and (T)), SECRET_ON and TEXT_ON (yellow and green
# on a screen with colour, else nothing) and COLOR_OFF. Call it outside $(…), where stdout is not
# the screen.
function set-marks() {
    SECRET_MARK='(S)' TEXT_MARK='(T)' SECRET_ON='' TEXT_ON='' COLOR_OFF='' EMOJI=0
    if use-emoji; then SECRET_MARK='🔑' TEXT_MARK='📄' EMOJI=1; fi
    if use-color; then SECRET_ON=$'\e[33m' TEXT_ON=$'\e[32m' COLOR_OFF=$'\e[0m'; fi
}

# --- Requirements -------------------------------------------------------------

# Ensure that all the dependency are there. Show when at lease one is missing.
function ensure-requirements() {
    local failed=0

    has-dependency() { command -v "${1// /}" >/dev/null 2>&1 ; }
    # lines <cmd> <reason> <install> [optional]: a missing optional one is marked, but doesn't fail.
    lines() {
        local cmd="$1" reason="$2" install="$3" optional="${4:-}"
        local icon=$'\e[32m✓\e[0m'
        if ! has-dependency "$cmd"; then
            if [[ -n $optional ]]; then icon=$'\e[33m-\e[0m'; else icon=$'\e[31m✗\e[0m' ; failed=1 ; fi
        fi
        echo "| $icon $cmd  | $reason | $install |"
        echo "+------------+--------------------+---------------------------+"
    }

    echo "Dependencies"
    echo "+------------+--------------------+---------------------------+"
    echo "| Dependency | Description        | Brew install command      |"
    echo "+------------+--------------------+---------------------------+"
    lines     "pass   " "Password manager  " "brew install pass        "
    lines     "gpg    " "Encrypts the store" "brew install gnupg       "
    lines     "git    " "Syncs the store   " "brew install git         "
    lines     "tree   " "Lists the store   " "brew install tree        "

    # tar and gzip also open an export for exec and shell --from.
    if [[ ${1:-} =~ ^(backup|restore|import|export)$ || ( ${1:-} =~ ^(exec|shell)$ && " $* " == *" --from"* ) ]]; then
        lines     "tar    " "Packs backups     " "brew install gnu-tar     "
        lines     "gzip   " "Compresses backups" "brew install gzip        "
    fi

    # Clipboard: only the tool `show -c` and `generate -c` use on this platform; none without a display.
    if [[ "$*" =~ ^(secret|text)\ (show|generate)\ (.*\ )?(--clip|-[a-z]*c) ]]; then
        if   [[ "$(uname -s)" == "Darwin" ]]; then : # pbcopy - should be built-in in Mac.
        elif [[ -n "${WAYLAND_DISPLAY:-}" ]]; then lines "wl-copy" "Clipboard copy    " "brew install wl-clipboard"
        elif [[ -n "${DISPLAY:-}"         ]]; then lines "xclip  " "Clipboard copy    " "brew install xclip       "
        fi
    fi

    echo ""
    echo "Use other package manager if brew is not present."

    return "$failed"
}

# --- Output -------------------------------------------------------------------

function info() { printf '%s\n' "$*"; }
function die()  { printf 'folio: %s\n' "$*" >&2; exit 1; }
# set-gpg-tty: gpg's pinentry asks for a passphrase on the terminal GPG_TTY names, else on the one
# gpg's stdin is — none when stdin is a pipe or a file (`echo x | folio insert text x`, a
# --file-passphrase-stdin), and then gpg stops with "Inappropriate ioctl for device". So, unless it
# is set already, point it at the terminal stderr (else stdout) is. Its own name (/dev/pts/3), not
# /dev/tty: gpg-agent, which opens it, has no terminal of its own. Only the terminal's path: no
# passphrase goes through it.
GPG_TTY_SET=0
function set-gpg-tty() {
    [[ -z ${GPG_TTY:-} ]] || return 0
    local fd terminal=""
    for fd in 2 1; do
        [[ -t $fd ]] || continue
        terminal=$(tty <&"$fd" 2>/dev/null) && break
        terminal=""
    done
    [[ -n $terminal && $terminal != /dev/tty ]] || return 0
    GPG_TTY=$terminal GPG_TTY_SET=1
    export GPG_TTY
}
# remove-on-exit <path>...: remove these when EnvFolio exits, however it exits. The gpg-agent of a
# new-gpg-home is stopped first.
REMOVE_ON_EXIT=() GPG_HOMES=()
function remove-on-exit() {
    REMOVE_ON_EXIT+=("$@")
    trap remove-now EXIT
}
# remove-now: remove them already — before an `exec`, after which no EXIT trap runs. With
# --fresh-passphrase, gpg-agent forgets the passphrases then too.
function remove-now() {
    local h
    for h in "${GPG_HOMES[@]}"; do GNUPGHOME=$h gpgconf --kill gpg-agent; done 2>/dev/null
    (( ${#REMOVE_ON_EXIT[@]} == 0 )) || rm -rf -- "${REMOVE_ON_EXIT[@]}"
    REMOVE_ON_EXIT=() GPG_HOMES=()
    (( ! FRESH_PASSPHRASE )) || forget-passphrases
}
# new-gpg-home <folder>: a GnuPG home of its own, for an export's key; gone when EnvFolio exits.
function new-gpg-home() {
    mkdir -m 700 "$1" || die "Cannot make a temporary folder."
    GPG_HOMES+=("$1")
    remove-on-exit "$1"
}

# section lines up: ==| Title |=====…
function section() {
    local title="==| $* |" width=72 fill
    fill=$(( width - ${#title} ))
    (( fill >= 3 )) || fill=3
    printf '\n%s%s\n' "$title" "$(printf '%*s' "$fill" '' | tr ' ' '=')" >&2;
}
# section end: ======…  (same width as section)
function section-end() {
    printf '%s\n\n' "$(printf '%*s' 72 '' | tr ' ' '=')" >&2;
}

function show-answer() {
    local spaces="${3:-}"
    printf '✓ %s:%s %s\n' "$1" "$spaces" "$2" >&2;
}

# <path> with $HOME shown as ~, for display.
function tilde-path() {
    # shellcheck disable=SC2088  # a literal ~ is the point: this path is for display only
    case $1 in
        "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
        *)         printf '%s\n' "$1" ;;
    esac
}

# --- Input --------------------------------------------------------------------

# Every prompt goes through the functions below (plain bash). Prompts go to stderr; only the answer
# goes to stdout, so `$(ask-...)` captures just the answer. Each drops what was typed before it
# showed (drop-typeahead), so only what is typed at the prompt answers it.

# drop-typeahead: at a terminal, throw away what was typed before a prompt shows — an extra Enter,
# the newline at the end of a paste — so that it cannot answer the prompt. stdin from a pipe or a
# file is left alone: it holds the answers. For /dev/tty: drop-typeahead < /dev/tty. With -icanon
# and min 0 time 0, a read returns at once with what is waiting, or with nothing: it never waits.
function drop-typeahead() {
    [[ -t 0 ]] || return 0
    local saved dropped
    saved=$(stty -g 2>/dev/null) || return 0
    stty -icanon min 0 time 0 2>/dev/null || return 0
    # shellcheck disable=SC2034  # dropped is read only to be thrown away
    while IFS= read -r dropped; do :; done
    stty "$saved" 2>/dev/null
    unset dropped
}

# ask-text <header> [placeholder] [guess]: prints the answer; an empty answer keeps the guess.
function ask-text() {
    local header="$1"
    local placeholder="${2:-}"
    local guess_value="${3:-}"
    local value hint
    hint=${guess_value:-$placeholder}
    drop-typeahead
    printf '\n%s%s: ' "$header" "${hint:+ [$hint]}" >&2
    IFS= read -r value || die "Cancelled."
    [[ -n $value ]] || value=$guess_value
    printf '%s\n' "$value"
}

# ask-path <header> [placeholder] [guess]: as ask-text, for a file or folder. At a terminal, Tab
# completes names (readline: `read -e`, which draws the prompt itself). A leading ~ is the home folder.
function ask-path() {
    local header="$1"
    local placeholder="${2:-}"
    local guess_value="${3:-}"
    local value hint prompt
    hint=${guess_value:-$placeholder}
    prompt="$header${hint:+ [$hint]}: "
    drop-typeahead
    if [[ -t 0 ]]; then
        printf '\n' >&2
        IFS= read -e -r -p "$prompt" value || { echo >&2 ; die "Cancelled." ; }
    else
        printf '\n%s' "$prompt" >&2
        IFS= read -r value || die "Cancelled."
    fi
    # readline puts a space after a name it completes.
    while [[ $value == *" " ]]; do value=${value% } ; done
    [[ -n $value ]] || value=$guess_value
    # shellcheck disable=SC2088  # a literal ~ typed in is matched here, and made $HOME
    case $value in
        "~")   value=$HOME ;;
        "~/"*) value=$HOME/${value#"~/"} ;;
    esac
    printf '%s\n' "$value"
}

# ask-choice [--default <n>] <header> <option>...: prints the chosen option; fails on cancel
# (Ctrl-D). With --default, a bare Enter picks option <n>; without, it asks again.
function ask-choice() {
    local default="" header answer i
    [[ $1 != --default ]] || { default=$2 ; shift 2 ; }
    header=$1 ; shift
    drop-typeahead
    printf '%s\n' "$header" >&2
    for (( i = 1; i <= $#; i++ )); do printf '%d) %s\n' "$i" "${!i}" >&2 ; done
    local prompt="Pick a number (Ctrl-D cancels): "
    [[ -z $default ]] || prompt="Pick a number (Enter for $default, Ctrl-D cancels): "
    while printf '%s' "$prompt" >&2 && IFS= read -r answer; do
        [[ -n $answer ]] || answer=$default
        if [[ $answer =~ ^[0-9]+$ ]] && (( answer >= 1 && answer <= $# )); then
            printf '%s\n' "${!answer}"
            return 0
        fi
    done
    echo >&2
    return 1
}

# confirm <question>: succeeds on yes. Anything else — and the default — is no.
function confirm() {
    local answer
    drop-typeahead
    printf '%s [y/N] ' "$1" >&2
    IFS= read -r answer || { echo >&2; return 1; }
    [[ $answer == [yY]* ]]
}

# confirm-on-tty <question>: confirm, asked and answered on the terminal — never stdin, which may be
# for the command that runs next. Dies when there is no terminal.
function confirm-on-tty() {
    local answer
    { : < /dev/tty ; } 2>/dev/null || die "--confirm needs a terminal to ask on."
    drop-typeahead < /dev/tty
    printf '%s [y/N] ' "$1" > /dev/tty
    IFS= read -r answer < /dev/tty || { echo > /dev/tty ; return 1 ; }
    [[ $answer == [yY]* ]]
}

# acknowledge <line>...: tell the user what comes next, and wait for Enter. Dies on cancel (Ctrl-D).
# Read silently: a passphrase typed here by mistake is never shown, and is dropped.
function acknowledge() {
    local answer
    drop-typeahead
    printf '\n' >&2
    printf '%s\n' "$@" >&2
    printf 'Press Enter to continue (Ctrl-D cancels): ' >&2
    IFS= read -rs answer || { echo >&2 ; die "Cancelled." ; }
    unset answer
    echo >&2
}

# show-box <line>...: the lines in a rounded box.
function show-box() {
    local line width=0 border
    for line in "$@"; do (( ${#line} > width )) && width=${#line}; done
    border=$(printf '%*s' $(( width + 2 )) '')
    border=${border// /─}
    printf '╭%s╮\n' "$border"
    for line in "$@"; do printf '│ %s%*s │\n' "$line" $(( width - ${#line} )) ''; done
    printf '╰%s╯\n' "$border"
}

# --- User + Key ---------------------------------------------------------------

# Best guess at the user's name
function guess-name() {
    # Git
    local line name=${GIT_AUTHOR_NAME:-$(git config --global user.name 2>/dev/null)}

    # /etc/passwd (Linux, WSL, and some macOS accounts)
    if [[ -z $name ]]; then
        line=$(grep "^$(id -un):" /etc/passwd 2>/dev/null)
        line=${line#*:*:*:*:}  # drop user:pass:uid:gid:
        line=${line%%:*}       # drop :home:shell
        name=${line%%,*}       # drop ,office,phone
    fi

    # macOS Directory Services
    if [[ -z $name && $(uname -s) == Darwin ]]; then
        name=$(id -F 2>/dev/null)
    fi

    printf '%s\n' "$name"
}

# Best guess at the user's email
function guess-email() {
    local email=${GIT_AUTHOR_EMAIL:-}
    [[ -n $email ]] || email=$(git config --global user.email 2>/dev/null || true)
    [[ -n $email ]] || email=${EMAIL:-}
    printf '%s\n' "$email"
}

# One line per secret key: "<fingerprint><TAB><first user id>".
function list-secret-keys() {
    # [<id>] limits the list to the keys gpg matches with it (fingerprint, key id, email, ...).
    gpg --list-secret-keys --with-colons "$@" 2>/dev/null | awk -F: '
        $1 == "sec"                 { want_fpr = 1; want_uid = 1; fpr = ""; next }
        $1 == "fpr" && want_fpr     { fpr = $10; want_fpr = 0; next }
        $1 == "uid" && want_uid     { print fpr "\t" $10; want_uid = 0 }
    '
}

# The fingerprint of the one secret key matching <id>; fails when none or several match.
function find-key() {
    local matches
    matches=$(list-secret-keys "$1")
    [[ -n $matches ]] || die "No secret key matches '$1'."
    if (( $(printf '%s\n' "$matches" | wc -l) > 1 )); then
        die "More than one secret key matches '$1'; use its fingerprint:${EXTRA_LINE}$(printf '%s\n' "$matches" | awk -F'\t' '{ print "    " $1 "  " $2 }')"
    fi
    printf '%s\n' "${matches%%$'\t'*}"
}

# generate-key <name> <email> <passphrase-on-stdin> <algo>: a new key of gpg's <algo> — pqc or
# default (see key-kind-label). Its passphrase is the first line of stdin when <passphrase-on-stdin>
# is 1; otherwise gpg's own prompt (pinentry) asks. Its expiry is gpg's default.
# Prints the new key's fingerprint.
function generate-key() {
    local uid="$1 <$2>" passphrase_on_stdin=$3 algo=$4 status finger_print

    info "Generating key ..." >&2
    # gpg's normal output goes to the terminal (stderr); its machine-readable status lines (fd 3)
    # are captured so we get the fingerprint without guessing which key is new.
    if (( passphrase_on_stdin )); then
        status=$(gpg --batch --pinentry-mode loopback --passphrase-fd 0 \
                     --status-fd 3 --quick-generate-key --yes "$uid" "$algo" 3>&1 1>&2) \
            || die "Creating the key failed."
    else
        status=$(gpg --batch --status-fd 3 --quick-generate-key --yes "$uid" "$algo" 3>&1 1>&2) \
            || die "Creating the key failed."
    fi
    finger_print=$(printf '%s\n' "$status" | awk '$2 == "KEY_CREATED" { print $4 }')
    # gpg exits 0 when the user answers No to its own "Continue?", and simply makes no key.
    [[ -n $finger_print ]] || die "Cancelled — no key was created."

    printf '%s\n' "$finger_print"
}

# One line per public key that can encrypt — not expired, revoked, disabled or invalid:
# "<fingerprint><TAB><first user id>".
function list-public-keys() {
    gpg --list-keys --with-colons 2>/dev/null | awk -F: '
        $1 == "pub"             { ok = ($2 !~ /[eridn]/ && $12 ~ /E/ && $12 !~ /D/)
                                  want_fpr = ok; want_uid = ok; fpr = ""; next }
        $1 == "fpr" && want_fpr { fpr = $10; want_fpr = 0; next }
        $1 == "uid" && want_uid { print fpr "\t" $10; want_uid = 0 }
    '
}

# Pick a public key from the keyring to lock a file to. Prints its fingerprint, or nothing for
# "A key file (.asc), or another key id" — and when the keyring has none to offer.
function pick-public-key() {
    local other="A key file (.asc), or another key id" line choices=() choice
    # Shown as "<user id>  [<fingerprint>]"; the fingerprint is read back from the brackets.
    while IFS= read -r line; do
        choices+=("${line#*$'\t'}  [${line%%$'\t'*}]")
    done < <(list-public-keys)
    (( ${#choices[@]} > 0 )) || return 0
    echo >&2
    choice=$(ask-choice "Which public key?" "${choices[@]}" "$other") || die "Cancelled."
    [[ $choice != "$other" ]] || return 0
    choice=${choice##*[}
    printf '%s\n' "${choice%]}"
}

# The two kinds of new key, as gpg 2.5.21 and later make them for `pqc` and `default`. `pqc` is
# ML-KEM (Kyber) together with an elliptic curve: safe while either one holds.
PQC_KEY_LABEL="Post-quantum (recommended) — ML-KEM-768 + Brainpool P-256, Brainpool P-384"
CLASSICAL_KEY_LABEL="Classical — X25519, Ed25519"
# Where the README says how to get a gpg that can use a post-quantum key.
PQC_GPG_HELP="To update gpg: https://github.com/NawaMan/EnvFolio#updating-gpg-for-post-quantum-keys"

# key-kind-label <algo>: how a new key of gpg's <algo> (pqc or default) is shown once picked.
function key-kind-label() {
    if [[ $1 == pqc ]]; then
        printf '%s\n' "${PQC_KEY_LABEL/ (recommended)/}"
    elif gpg-has-pqc; then
        printf '%s\n' "$CLASSICAL_KEY_LABEL"
    else
        printf '%s\n' "gpg's default"
    fi
}

# Ask which kind of key to make; prints gpg's algorithm for it: pqc or default. Dies on cancel.
function ask-key-kind() {
    local choice
    echo >&2
    choice=$(ask-choice --default 1 "Which kind of key?" "$PQC_KEY_LABEL" "$CLASSICAL_KEY_LABEL") || die "Cancelled."
    if [[ $choice == "$PQC_KEY_LABEL" ]]; then echo pqc; else echo default; fi
}

# Pick the key for the store: an existing one, or a new one. Prints the fingerprint, or nothing for
# a new key. Always a list, even for one key: confirm reports cancel the same as No, which would
# turn a cancel into "create a new key".
function select-key() {
    local create_new_key="Create a new key" line choices=() choice key
    # Shown as "<user id>  [<fingerprint>]"; the fingerprint is read back from the brackets.
    while IFS= read -r line; do
        choices+=("${line#*$'\t'}  [${line%%$'\t'*}]")
    done < <(list-secret-keys)
    choices+=("${create_new_key}")

    # No existing keys: nothing to choose, a new key it is.
    (( ${#choices[@]} > 1 )) || return 0
    echo >&2
    choice=$(ask-choice "Which GPG key should encrypt the store?" "${choices[@]}") \
        || die "Cancelled."
    [[ $choice != "${create_new_key}" ]] || return 0
    key=${choice##*[}
    printf '%s\n' "${key%]}"
}

# Whether this gpg makes post-quantum keys that EnvFolio can also back up and restore: Kyber (ML-KEM)
# is among its public-key algorithms (gpg 2.5+), and it is 2.5.21 or later — the first that imports
# a Kyber secret key with --batch, as restore and import do.
function gpg-has-pqc() {
    local algos major minor patch
    algos=$(gpg --with-colons --list-config pubkeyname 2>/dev/null)
    [[ ";${algos#cfg:pubkeyname:};" == *";Kyber;"* ]] || return 1
    IFS=. read -r major minor patch <<< "$(gpg-version)"
    major=${major%%[!0-9]*} minor=${minor%%[!0-9]*} patch=${patch%%[!0-9]*}
    (( ${major:-0} > 2 || (${major:-0} == 2 && ${minor:-0} > 5)
       || (${major:-0} == 2 && ${minor:-0} == 5 && ${patch:-0} >= 21) ))
}

# This gpg's version, e.g. 2.4.4.
function gpg-version() {
    local version
    version=$(gpg --with-colons --list-config version 2>/dev/null)
    printf '%s\n' "${version#cfg:version:}"
}

# has-pqc-key <file>: whether <file> holds a post-quantum key (an exported key, as a backup's
# key.asc) or is locked to one (an export). Kyber is algo 8 in the key's packets; any gpg lists
# them, also one that cannot use Kyber. With --list-only nothing is decrypted, and nothing asked.
function has-pqc-key() {
    gpg --batch --list-only --list-packets "$1" 2>/dev/null | awk '
        /^:(public|secret) sub key packet:/ { sub_key = 1 ; next }
        sub_key && /algo 8,/                 { found = 1 }
        /^:pubkey enc packet:.* algo 8,/     { found = 1 }
                                             { sub_key = 0 }
        END { exit !found }'
}

# The kind of encryption of the key with fingerprint <fpr>: "post-quantum (<algo>)" when one of its
# usable encryption keys is Kyber (gpg's algo 8), else "classical (<algo>)", e.g. "classical (cv25519)".
function key-kind() {
    gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '
        ($1 == "pub" || $1 == "sub") && $12 ~ /e/ && $2 !~ /[eridn]/ {
            name = ($17 != "" ? $17 : ($4 == 16 ? "elg" : "rsa") $3)
            if ($4 == 8) pq = name; else if (classic == "") classic = name
        }
        END { if (pq != "") print "post-quantum (" pq ")"; else if (classic != "") print "classical (" classic ")" }'
}

# The first user id ("Name <email>") of the key with fingerprint <fpr>.
function key-uid() {
    gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '$1 == "uid" { print $10; exit }'
}

# The expiry date (YYYY-MM-DD, UTC) of the key with fingerprint <fpr>; nothing when it never expires.
function key-expiry() {
    local epoch
    epoch=$(gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '$1 == "pub" { print $7; exit }')
    [[ -n $epoch ]] || return 0
    # GNU date takes -d @<epoch>; BSD (macOS) date takes -r <epoch>.
    date -u -d "@$epoch" +%F 2>/dev/null || date -u -r "$epoch" +%F
}

