# demo.vars: the variables for the items demo-data.sh makes. Pick the environment with --use:
#
#   folio exec --secrets --use @first-app/@prod    --vars test-helpers/demo.vars -- env
#   folio exec --secrets --use @first-app/@staging --vars test-helpers/demo.vars -- env
#
# DB_HOST is the environment's db/host, peeled by --use.

GH_TOKEN=@{gh/token}
DB_URL=pg://@{db/user}:@{db/pass}@${DB_HOST}/app
LOG_LEVEL=info
