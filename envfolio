function text-cp-help() {
    cat <<'EOF'
Usage: envfolio text cp [-f|--force] <old-name> <new-name>

Copy a text, or every text in a folder (secrets in it are not copied). At a terminal, asks before
overwriting unless --force; from a script or pipe, it overwrites.

Options:
  -f, --force         Overwrite without asking.
  -h, --help          Show this help and stop.
EOF
}

TextMv() { text-copy-move mv "$@" ; }
TextCp() { text-copy-move cp "$@" ; }

# text-copy-move <mv|cp> [-f|--force] <old-name> <new-name>
# As `pass mv` / `pass cp`, for texts. A signature covers the text, not its name, so it moves with
# it and still verifies.
function text-copy-move() {
    local how=$1 force=0 names=() arg ; shift
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)  "text-$how-help" ; return 0 ;;
            -f|--force) force=1 ;;
            --)         names+=("$@") ; break ;;
            -*)         die "text $how: unknown option: $arg" ;;
            *)          names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 2 )) || die "Usage: envfolio text $how [-f|--force] <old-name> <new-name>"
    local old=${names[0]} new=${names[1]} src=${names[0]%/} dest
    [[ -n $src     && /$src/ != */../* ]] || die "text $how: '$old' is not a valid name."
    [[ -n ${new%/} && /$new/ != */../* ]] || die "text $how: '$new' is not a valid name."
    require-store

    # The names to carry over: each old one in from[], its new one in to[].
    local from=() to=() file rel i
    if [[ -f $STORE_PATH/$src.txt && ! ( $old == */ && -d $STORE_PATH/$src ) ]]; then
        # One text; into <new> when that is a folder (and not also a text), as mv/cp do.
        dest=${new%/}
        [[ $new == */ || ( -d $STORE_PATH/$dest && ! -f $STORE_PATH/$dest.txt ) ]] && dest=$dest/${src##*/}
        from=("$src") ; to=("$dest")
    elif [[ -d $STORE_PATH/$src ]]; then
        # Every text in a folder; into <new> when that folder exists already, as mv/cp do.
        dest=${new%/}
        [[ -d $STORE_PATH/$dest ]] && dest=$dest/${src##*/}
        while IFS= read -r -d '' file; do
            rel=${file#"$STORE_PATH/$src"/} ; rel=${rel%.txt}
            from+=("$src/$rel") ; to+=("$dest/$rel")
        done < <(find "$STORE_PATH/$src" -type f -name '*.txt' -print0)
        (( ${#from[@]} > 0 )) || die "text $how: '$old' holds no texts."
    else
        die "text $how: '$old' is not in the store."
    fi

    for (( i = 0; i < ${#from[@]}; i++ )); do
        [[ ${from[i]} != "${to[i]}" ]] || continue
        if [[ -e $STORE_PATH/${to[i]}.txt ]] && (( ! force )) && [[ -t 0 ]]; then
            confirm "An entry already exists for ${to[i]}. Overwrite it?" || continue
        fi
        mkdir -p "$(dirname "$STORE_PATH/${to[i]}")"
        for file in "${from[i]}.txt" "${from[i]}.txt.sig"; do
            [[ -e $STORE_PATH/$file ]] && "$how" -f -- "$STORE_PATH/$file" "$STORE_PATH/${to[i]}${file#"${from[i]}"}"
        done
        if [[ $how == mv ]]; then
            git -C "$STORE_PATH" rm -q --cached --ignore-unmatch -- "${from[i]}.txt" "${from[i]}.txt.sig"
            rmdir -p "$(dirname "$STORE_PATH/${from[i]}")" 2>/dev/null
        fi
        git -C "$STORE_PATH" add -- "${to[i]}.txt"
        [[ -e $STORE_PATH/${to[i]}.txt.sig ]] && git -C "$STORE_PATH" add -- "${to[i]}.txt.sig"
    done
    local verb=Copy ; [[ $how == mv ]] && verb=Rename
    git -C "$STORE_PATH" diff --cached --quiet || git -C "$STORE_PATH" commit --quiet -m "$verb $old to $new."
}

#== Command: Secret ============================================================

Secret() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    # Every secret command needs a ready store — except asking for its help.
    case " $* " in
        *" -h "*|*" --help "*) ;;
        *) [[ -z $category ]] || require-store ;;
    esac
    case "$category" in
        ls)       SecretLs        "$@" ;;
        find)     SecretFind      "$@" ;;
        grep)     SecretGrep      "$@" ;;
        show)     SecretShow      "$@" ;;
        insert)   SecretInsert    "$@" ;;
        edit)     SecretEdit      "$@" ;;
        generate) SecretGenerate  "$@" ;;
        rm)       SecretRm        "$@" ;;
        mv)       SecretMv        "$@" ;;
        cp)       SecretCp        "$@" ;;
        "")       echo "Usage: envfolio secret <ls|find|grep|show|insert|edit|generate|rm|mv|cp> [args...]" >&2 ; return 1 ;;
        *)        echo "envfolio secret: unknown command: $category"                                        >&2 ; return 1 ;;
    esac
}

