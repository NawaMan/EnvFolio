#!/usr/bin/env bash

#== Doc ========================================================================
#
# EnvFolio — a command-line tool for keeping texts and secrets, built on `pass`.
#
# Usage: envfolio <command> [args...]        (`envfolio help` lists the commands)
#   envfolio store  init | path | backup | restore | export | import
#   envfolio text   ls | find | grep | show | insert | edit | generate | rm | mv | cp
#   envfolio secret ls | find | grep | show | insert | edit | generate | rm | mv | cp
#   envfolio ls | exec | shell | version | help [command]
#
# Environment:
#   ENVFOLIO_STORE_DIR  The EnvFolio store (default ~/.envfolio). Laid out like a pass store, but
#                       kept apart from your own ~/.password-store.
#
# Every command, with examples: MANUAL.md

#== Settings ===================================================================

# Set by the release: `<major>.<minor>.<patch>` in a release, `<next>--rc` on main between releases.
# The release workflow (.github/workflows/release.yml) reads and bumps this exact line.
APP_VERSION=0.4.0--rc

STORE_PATH=${ENVFOLIO_STORE_DIR:-$HOME/.envfolio}
# Always absolute: `pass` loops forever on a relative PASSWORD_STORE_DIR whose folder doesn't exist
# yet (its set_git keeps stripping "/…" off a path that has none left).
[[ $STORE_PATH == /* ]] || STORE_PATH=$PWD/$STORE_PATH

# The caller's own PASSWORD_STORE_DIR (set or not), put back for the command `envfolio exec` runs.
CALLER_STORE_DIR_SET=${PASSWORD_STORE_DIR+set}
CALLER_STORE_DIR=${PASSWORD_STORE_DIR-}

# The EnvFolio store is laid out like a pass store, but lives in its own place so it never touches
# the user's own ~/.password-store. Every `pass` call goes there.
export PASSWORD_STORE_DIR="$STORE_PATH"

# gpg's passphrase prompt needs the terminal, also when its stdin is a pipe or a file (as pass does).
[[ -n ${GPG_TTY:-} ]] || ! tty -s || { GPG_TTY=$(tty) ; export GPG_TTY ; }

#== Main =======================================================================

Main() {
    # Quiet when all is there; otherwise show the table and stop.
    if ! ensure-requirements "$@" >/dev/null; then ensure-requirements "$@" ; return 1 ; fi

    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        store)   Store  "$@" ;;
        text)    Text   "$@" ;;
        secret)  Secret "$@" ;;
        ls)      Ls     "$@" ;;
        exec)    Exec   "$@" ;;
        shell)   Shell  "$@" ;;
        version) Version "$@" ;;
        help)    Help   "$@" ;;
        "")      echo   "Usage: envfolio <version|help|store|text|secret|ls|exec|shell> [args...]" >&2 ; return 1 ;;
        *)       echo   "envfolio: unknown command: $category"                        >&2 ; return 1 ;;
    esac
}

Version() {
    echo "EnvFolio $APP_VERSION"
}

# envfolio help [command...]
Help() {
    case "$*" in
        "")                envfolio-help            ;;
        "store init")      store-init-help      ;;
        "store path")      store-path-help      ;;
        "store backup")    store-backup-help    ;;
        "store restore")   store-restore-help   ;;
        "store export")    store-export-help    ;;
        "store import")    store-import-help    ;;
        "ls")              list-help            ;;
        "exec")            run-exec-help        ;;
        "shell")           run-shell-help       ;;
        "text ls")         text-ls-help         ;;
        "text find")       text-find-help       ;;
        "text grep")       text-grep-help       ;;
        "text show")       text-show-help       ;;
        "text insert")     text-insert-help     ;;
        "text edit")       text-edit-help       ;;
        "text generate")   text-generate-help   ;;
        "text rm")         text-rm-help         ;;
        "text mv")         text-mv-help         ;;
        "text cp")         text-cp-help         ;;
        "secret ls")       secret-ls-help       ;;
        "secret find")     secret-find-help     ;;
        "secret grep")     secret-grep-help     ;;
        "secret show")     secret-show-help     ;;
        "secret insert")   secret-insert-help   ;;
        "secret edit")     secret-edit-help     ;;
        "secret generate") secret-generate-help ;;
        "secret rm")       secret-rm-help       ;;
        "secret mv")       secret-mv-help       ;;
        "secret cp")       secret-cp-help       ;;
        *)                 echo "envfolio help: no help for '$*' yet." >&2 ; return 1 ;;
    esac
}

function envfolio-help() {
    cat <<'EOF'
Usage: envfolio <command> [args...]

Commands:
  store init        Create the EnvFolio store
  store path        Print the store's folder
  store backup      Save the store and its key into one file
  store restore     Bring the store and its key back from a backup
  store export      Copy some items into one locked file, with a key of its own
  store import      Bring items from an export into the store (made if missing)
  text ls           List texts
  text find         Find texts by name
  text grep         Find texts by value
  text show         Show a text (its signature checked), or copy it to the clipboard
  text insert       Add a text (plain, signed)
  text edit         Edit a text in $EDITOR
  text generate     Generate a random text
  text rm           Remove a text
  text mv           Rename or move a text
  text cp           Copy a text
  secret ls         List secrets
  secret find       Find secrets by name
  secret grep       Find secrets by value
  secret show       Show a secret, or copy it to the clipboard
  secret insert     Add a secret
  secret edit       Edit a secret in $EDITOR
  secret generate   Generate a random secret
  secret rm         Remove a secret
  secret mv         Rename or move a secret
  secret cp         Copy a secret
  ls                List texts and secrets together
  exec              Run a command with entries as environment variables
  shell             Start a shell with entries as environment variables
  version           Print EnvFolio's version
  help [command]    Show help, e.g. `envfolio help store init`

The store is $ENVFOLIO_STORE_DIR, default ~/.envfolio. EnvFolio warns when that folder is someone
else's or open to other users.
Details and examples: MANUAL.md
EOF
}

#== Common Constants ===========================================================

EXTRA_LINE=$'\n'

#== Command: Store =============================================================

Store() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        path)    StorePath     "$@" ;;
        init)    StoreInit     "$@" ;;
        backup)  StoreBackup   "$@" ;;
        restore) StoreRestore  "$@" ;;
        export)  StoreExport   "$@" ;;
        import)  StoreImport   "$@" ;;
        "")      echo "Usage: envfolio store <init|path|backup|restore|export|import> [args...]" >&2 ; return 1 ;;
        *)       echo "envfolio store: unknown command: $category"                               >&2 ; return 1 ;;
    esac
}

# --- store path ---------------------------------------------------------------

function store-path-help() {
    cat <<'EOF'
Usage: envfolio store path

Print the EnvFolio store's folder: $ENVFOLIO_STORE_DIR, default ~/.envfolio. Works without a store.

Options:
  -h, --help          Show this help and stop.
EOF
}

# envfolio store path
StorePath() {
    case ${1:-} in -h|--help) store-path-help ; return 0 ;; esac
    (( $# == 0 )) || die "Usage: envfolio store path"
    echo "${STORE_PATH}"
}

# Whether the store is ready to use. Prints nothing; the caller acts on the return code:
#   0 - ready: the folder has a non-empty .gpg-id (written by `pass init`) and a git history
#   1 - missing: no folder at all
#   2 - not ready: the folder exists but lacks one of those (another folder, or an unfinished init)
function store-exists() {
    [[ -d $STORE_PATH          ]] || return 1
    [[ -s $STORE_PATH/.gpg-id  ]] || return 2
    [[ -e $STORE_PATH/.git     ]] || return 2
    return 0
}

# Whether $1 is a folder with nothing in it, dotfiles included. Such a folder is as good as none
# for `store init` and `store restore`: the store is made inside it.
function is-empty-dir() {
    [[ -d $1 && -z $(ls -A "$1") ]]
}

# Whether only its owner can get into folder $1: no group or other bits in its `ls -ldL` mode,
# which reads the same on Linux and macOS (stat's flags do not).
function is-private-dir() {
    local mode
    mode=$(ls -ldL "$1" 2>/dev/null) || return 1
    [[ ${mode:4:6} == ------ ]]
}

# Whether the user owns folder $1 (a function, so tests can stand in for another owner).
function is-own-dir() {
    [[ -O $1 ]]
}

# Whether the store's folder exists and is someone else's, or open to other users.
function is-unsafe-store() {
    [[ -d $STORE_PATH ]] || return 1
    ! is-own-dir "$STORE_PATH" || ! is-private-dir "$STORE_PATH"
}

# Warn, as gpg does for its home, when the store's folder is someone else's or other users can get
# into it. EnvFolio makes the folder private (700) when it creates it, but leaves one it was given
# (a bind mount, say) as it is. There is no switch to hide this: it is the user's data.
function warn-unsafe-store() {
    [[ -d $STORE_PATH ]] || return 0
    local owner
    if ! is-own-dir "$STORE_PATH"; then
        # shellcheck disable=SC2012  # one known folder's owner, not a listing of names
        owner=$(ls -ldL "$STORE_PATH" | awk '{ print $3 }')
        printf 'envfolio: warning: %s belongs to %s, not to you: they can read and change your store.\n' \
               "$STORE_PATH" "$owner" >&2
    fi
    if ! is-private-dir "$STORE_PATH"; then
        printf 'envfolio: warning: other users can get into %s. To make it private:\n    chmod 700 %s\n' \
               "$STORE_PATH" "$STORE_PATH" >&2
    fi
}

# For the commands that put items into the store (init, restore, import): with the store's folder
# unsafe, warn, then go on only when the user says so — --allow-unsafe-folder, or yes when asked.
# Once accepted, a later check in the same run (import making the store with init) passes quietly.
# accept-unsafe-store <allowed> <stdin-taken: 1 when stdin carries a passphrase, so cannot answer>
STORE_UNSAFE_ACCEPTED=0
function accept-unsafe-store() {
    local allowed=$1 stdin_taken=$2
    (( ! STORE_UNSAFE_ACCEPTED )) && is-unsafe-store || return 0
    warn-unsafe-store
    STORE_MODE_CHECKED=1
    if (( ! allowed )); then
        (( ! stdin_taken )) \
            || die "Not using $STORE_PATH: stdin carries the passphrase, so EnvFolio cannot ask. Nothing changed." \
                   "Add --allow-unsafe-folder to use it anyway."
        confirm "Use $STORE_PATH anyway?" \
            || die "Not using $STORE_PATH. Nothing changed. Add --allow-unsafe-folder to use it anyway, or run with${EXTRA_LINE}    ENVFOLIO_STORE_DIR=<other-folder>"
    fi
    STORE_UNSAFE_ACCEPTED=1
}

# --- store init ---------------------------------------------------------------

function store-init-usage() {
    cat <<'EOF'
Usage: envfolio store init [--key <id>] [--allow-unsafe-folder]
       envfolio store init [--new-key] [--name <name>] [--email <email>] [--passphrase-stdin|--passphrase-fd <n>]
                           [--allow-unsafe-folder]
EOF
}

function store-init-help() {
    store-init-usage
    cat <<'EOF'

Create the EnvFolio store ($ENVFOLIO_STORE_DIR, default ~/.envfolio): pick or create the GPG key
that encrypts it, run `pass init`, and start the store's git history. A folder made here is private
(700); an existing empty folder is used as it is. When that folder is someone else's or other users
can get in, EnvFolio warns and asks before using it. Anything not given is asked for.

Options:
  --key <id>          Use an existing secret key: fingerprint, key id or email (must match one).
                      No passphrase is needed: the store only encrypts to the key.
  --new-key           Create a new key. Implied by any option below.
  --name <name>       The new key's name.
  --email <email>     The new key's email.
  --passphrase-stdin  Read the new key's passphrase from the first line of stdin.
                      Needs --name and --email. An empty passphrase is refused.
  --passphrase-fd <n> Read the new key's passphrase from the first line of file descriptor <n>,
                      e.g. --passphrase-fd 3 3< pass.txt. stdin stays free, so anything not given
                      is still asked for. An empty passphrase is refused.
  --allow-unsafe-folder
                      Use an existing folder that is someone else's or open to other users without
                      asking (still with the warning).
  -h, --help          Show this help.

--opt=value works as well as --opt value.
Examples: MANUAL.md, section `envfolio store init`.
EOF
}

# envfolio store init [--key <id>] | [--new-key] [--name <name>] [--email <email>]
#                     [--passphrase-stdin|--passphrase-fd <n>] [--allow-unsafe-folder]
# Anything not given is asked for. An existing key needs no passphrase: the store only encrypts to it.
StoreInit() {
    # Process the command-line options
    local key_id="" new_key=0 name="" email="" passphrase_stdin=0 passphrase_fd="" allow_unsafe=0 arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        # --opt=value is the same as --opt value
        if [[ $arg == --*=* ]]; then set -- "${arg#*=}" "$@" ; arg=${arg%%=*} ; fi
        case $arg in
            --key|--name|--email|--passphrase-fd)
                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                case $arg in
                    --key)   key_id=$1 ;;
                    --name)  name=$1   ;;
                    --email) email=$1  ;;
                    --passphrase-fd)
                        [[ $1 =~ ^[0-9]+$ ]] || die "--passphrase-fd needs a file descriptor number, not '$1'."
                        passphrase_fd=$1 ;;
                esac
                shift ;;
            --new-key)          new_key=1          ;;
            --passphrase-stdin) passphrase_stdin=1 ;;
            --allow-unsafe-folder) allow_unsafe=1 ;;
            -h|--help)          store-init-help ; return 0 ;;
            *) die "store init: unknown option: $arg${EXTRA_LINE}$(store-init-usage)" ;;
        esac
    done

    section "Overview"
    cat >&2 <<'EOF'
This creates your EnvFolio store, where your texts and secrets are kept. It needs:
  - A folder for the store.
  - A GPG key to protect it: an existing one, or a new one made from your name and email.
A new key also needs a passphrase. An existing key needs none: the store is only encrypted to it.
EOF

    section "Parameters"

    # Input: the store path — ENVFOLIO_STORE_DIR, default ~/.envfolio (see STORE_PATH at the top)
    show-answer "Store path" "$(tilde-path "$STORE_PATH")"

    local status=0
    # Input: the state of the store folder (ENVFOLIO_STORE_DIR, default ~/.envfolio)
    store-exists || status=$?
    # An empty folder is as good as none: the store is made inside it, its mode left as it is.
    if (( status == 2 )) && is-empty-dir "$STORE_PATH"; then
        # Input: the folder's owner and mode; --allow-unsafe-folder, or a y/N answer on stdin
        accept-unsafe-store "$allow_unsafe" "$passphrase_stdin"
        status=1
    fi
    if (( status == 0 )); then
        die "A EnvFolio store already exists at $STORE_PATH." \
            "To create another one, run with${EXTRA_LINE}    ENVFOLIO_STORE_DIR=<other-folder> $0 store init."
    fi
    if (( status == 2 )); then
        die "$STORE_PATH exists but is not a ready EnvFolio store" \
            "(maybe an earlier \`envfolio store init\` did not finish)." \
            "Remove it and run again, or run with${EXTRA_LINE}    ENVFOLIO_STORE_DIR=<other-folder> $0 store init."
    fi
    if [[ -d $STORE_PATH ]]; then
        info "The store path is available: an empty folder, used as it is." >&2
    else
        info "The store path is available: the folder will be made (private, 700)." >&2
    fi

    # --name / --email / --passphrase-stdin / --passphrase-fd imply --new-key
    [[ -n $name || -n $email || -n $passphrase_fd ]] || (( passphrase_stdin )) && new_key=1
    if [[ -n $key_id ]] && (( new_key )); then
        die "--key cannot be used with --new-key, --name, --email, --passphrase-stdin or --passphrase-fd."
    fi
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--passphrase-stdin and --passphrase-fd cannot be used together."
    fi
    if [[ -n $passphrase_fd ]] && ! { : <&"$passphrase_fd" ; } 2>/dev/null; then
        die "--passphrase-fd $passphrase_fd: no such file descriptor is open."
    fi
    # stdin carries the passphrase, so nothing else can be asked for.
    if (( passphrase_stdin )) && [[ -z $name || -z $email ]]; then
        die "--passphrase-stdin needs --name and --email too."
    fi

    # Input: the key — --key; otherwise picked from the keyring's secret keys, or a new one.
    local key="" passphrase="" uid expiry
    if [[ -n $key_id ]]; then
        key=$(find-key "$key_id") || exit 1
    elif (( ! new_key )); then
        key=$(select-key) || exit 1
        [[ -n $key ]] || new_key=1
    fi
    if (( new_key )); then
        # Input: the new key's name and email — --name / --email, or asked with a guess
        # (git, passwd, EMAIL).
        [[ -n $name  ]] || name=$( ask-text "Your name"  "e.g. Jane Doe"         "$(guess-name)")  || exit 1
        [[ -n $name  ]] || die "A name is needed to create a key."
        show-answer "Name" "$name"
        [[ -n $email ]] || email=$(ask-text "Your email" "e.g. jane@example.com" "$(guess-email)") || exit 1
        [[ -n $email ]] || die "An email is needed to create a key."
        show-answer "Email" "$email"
        # Input: the new key's passphrase — the first line of stdin with --passphrase-stdin, or of
        # fd <n> with --passphrase-fd <n>; otherwise gpg asks for it when it makes the key.
        if (( passphrase_stdin )); then
            IFS= read -rs passphrase || true
            [[ -n $passphrase ]] || die "No passphrase on stdin."
        elif [[ -n $passphrase_fd ]]; then
            IFS= read -rs -u "$passphrase_fd" passphrase || true
            [[ -n $passphrase ]] || die "No passphrase on file descriptor $passphrase_fd."
        fi
        if [[ -n $passphrase ]]; then
            show-answer "Passphrase" "************"
        else
            show-answer "Passphrase" "gpg asks for it when it makes the key"
        fi
    else
        show-answer "Key" "$key"
    fi

    section "Creating"
    info "That is everything needed. Creating the store now." >&2

    if (( new_key )); then
        section "Generating the key."
        if [[ -n $passphrase ]]; then
            # printf is a builtin: the passphrase reaches gpg through a pipe, never through argv.
            key=$(printf '%s\n' "$passphrase" | generate-key "$name" "$email" 1) || exit 1
            unset passphrase
        else
            acknowledge "Next, gpg asks you to choose the new key's passphrase (twice)." \
                        "It protects the key: you need it to read your secrets and to add texts." \
                        "It cannot be reset, so keep it safe."
            key=$(generate-key "$name" "$email" 0) || exit 1
        fi
        section-end
        show-answer "Key" "$key"
    fi
    # Input: the key's user id (it becomes the git author) and its expiry, from the keyring
    uid=$(key-uid "$key")
    [[ -n $uid ]] || die "Cannot find the key $key."
    expiry=$(key-expiry "$key")

    # A folder made here, and the git history, are for the owner only (700).
    umask 077
    mkdir -p "$STORE_PATH" || die "Cannot create $STORE_PATH."

    section "Create the password store"
    # Input: PASSWORD_STORE_DIR, set to the store's folder at startup
    pass init "$key" || die "pass init failed."

    section "Start the store's git history"
    start-store-history "$uid"

    section "Summary"
    store-summary "$key" "$uid" "$expiry"
    echo ""
}

# Start the store's git history, so `pass` commits every change from here on. The repo gets its
# own author (from the key's user id) first: without a global git identity, `pass git init`'s
# first commit — and every later automatic one — would fail.
function start-store-history() {
    local uid=$1
    local name=${uid% <*} email=${uid##*<}
    email=${email%>}

    git -C "$STORE_PATH" init --quiet                || die "Starting the store's git history failed."
    git -C "$STORE_PATH" config user.name  "$name"
    git -C "$STORE_PATH" config user.email "$email"
    pass git init >/dev/null                         || die "Starting the store's git history failed."
    show-answer "History" "$(git -C "$STORE_PATH" log --oneline | wc -l | tr -d ' ') commit(s)"
}

# The closing box: what was set up, and what the user must keep to ever get their passwords back.
function store-summary() {
    local key=$1 uid=$2 expiry=$3 lines
    lines=(
        "Your pass store is ready."
        ""
        "Store:   $(tilde-path "$(StorePath)")"
        "Key:     $key"
        "         $uid"
        "Expires: ${expiry:-never}"
        ""
        "To get your passwords back if this machine is lost, you need both:"
        ""
        "1. Your passphrase — it can't be reset. Memorise it, and keep a written copy offline."
        ""
        "2. A backup of your key and store — one file, made with:"
        "     envfolio store backup"
        "   Keep it somewhere safe and offline, and run it again after you change passwords."
    )
    if [[ -n $expiry ]]; then
        lines+=(
            ""
            "When the key expires ($expiry), pass can't add or change entries until you extend it:"
            "  gpg --quick-set-expire $key 2y"
        )
    fi
    show-box "${lines[@]}"
}

# Die unless the store is ready; commands that read or write items call this first.
# Warns (once) when the store's folder is someone else's or other users can get into it.
STORE_MODE_CHECKED=0
function require-store() {
    store-exists || die "No ready EnvFolio store at $STORE_PATH. Create one with: envfolio store init"
    (( STORE_MODE_CHECKED )) && return 0
    STORE_MODE_CHECKED=1
    warn-unsafe-store
}

# --- store backup -------------------------------------------------------------

# A backup is one file: envfolio-backup.txt (what it holds), key.asc (the store's keys, still
# protected by their passphrase) and the store's folder — without .git unless --history.
BACKUP_SUFFIX=--envfolio.tar.gz
ENCRYPTED_BACKUP_SUFFIX=--envfolio.gpg

function store-backup-usage() {
    echo "Usage: envfolio store backup [--history] [--encrypt [--passphrase-stdin]] [<file>|<folder>]"
}

function store-backup-help() {
    store-backup-usage
    cat <<'EOF'

Save the whole EnvFolio store and its GPG key into one file, to get it all back with
`envfolio store restore` — here or on a new machine. gpg asks for the key's passphrase to export
it; in the backup, the key stays protected by that passphrase.

The file is <file> (--envfolio.tar.gz added when missing), or
backup-<date>-<time>--envfolio.tar.gz in <folder>, default the current one. An existing file is
never replaced.

Options:
  --history           Keep the store's git history too. Without it, a restore starts a new one.
  --encrypt           Encrypt the backup with a passphrase of its own; the file ends in
                      --envfolio.gpg. Without it, the texts and the names of the secrets can be read by anyone
                      who has the file (the secrets themselves stay encrypted).
  --passphrase-stdin  Read that passphrase from the first line of stdin. Needs --encrypt.
                      An empty passphrase is refused.
  -h, --help          Show this help.
EOF
}

# envfolio store backup [--history] [--encrypt [--passphrase-stdin]] [<file>|<folder>]
StoreBackup() {
    local history=0 encrypt=0 passphrase_stdin=0 target=""
    while (( $# > 0 )); do
        case $1 in
            --history)          history=1          ;;
            --encrypt)          encrypt=1          ;;
            --passphrase-stdin) passphrase_stdin=1 ;;
            -h|--help)          store-backup-help ; return 0 ;;
            -*) die "store backup: unknown option: $1${EXTRA_LINE}$(store-backup-usage)" ;;
            *)  [[ -z $target ]] || die "store backup: one file or folder only.${EXTRA_LINE}$(store-backup-usage)"
                target=$1 ;;
        esac
        shift
    done
    (( encrypt || ! passphrase_stdin )) || die "--passphrase-stdin needs --encrypt."
    require-store

    local suffix=$BACKUP_SUFFIX file=${target:-.}
    (( encrypt )) && suffix=$ENCRYPTED_BACKUP_SUFFIX
    [[ -d $file ]] && file=${file%/}/backup-$(date +%Y%m%d-%H%M%S)$suffix
    [[ $file == *"$suffix" ]] || file+=$suffix
    [[ ! -e $file ]]              || die "$file already exists."
    [[ -d $(dirname "$file") ]]   || die "There is no folder $(dirname "$file")."

    local passphrase=""
    if (( passphrase_stdin )); then
        IFS= read -rs passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on stdin."
    fi

    # The store's keys, by primary fingerprint; each must have its secret part here.
    local store id ids=() keys=() key
    store=$(cd "$STORE_PATH" && pwd -P)
    while IFS= read -r id; do [[ -n $id ]] && ids+=("$id") ; done < "$store/.gpg-id"
    while IFS= read -r key; do
        gpg --list-secret-keys "$key" >/dev/null 2>&1 \
            || die "The secret key $key is not in this keyring, so it cannot be backed up."
        keys+=("$key")
    done < <(gpg --list-keys --with-colons -- "${ids[@]}" 2>/dev/null \
                | awk -F: '$1 == "pub" { p = 1 } $1 == "fpr" && p { print $10 ; p = 0 }')
    (( ${#keys[@]} > 0 )) || die "Cannot find the store's key in this keyring."

    umask 077
    local stage
    stage=$(mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$stage" "$file.partial"
    {
        echo "envfolio-backup 1"
        echo "created $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "store ${store##*/}"
        printf 'key %s\n' "${keys[@]}"
    } > "$stage/envfolio-backup.txt"

    section "Export the key (gpg may ask for its passphrase)"
    if ! gpg --armor --output "$stage/key.asc" --export-secret-keys "${keys[@]}" || [[ ! -s $stage/key.asc ]]; then
        die "Exporting the key failed."
    fi
    show-answer "Key" "${keys[*]}"

    section "Pack the backup"
    local pack=(tar -czf -) seal=(cat)
    (( history )) || pack+=(--exclude=.git)
    pack+=(-C "$stage" envfolio-backup.txt key.asc -C "$(dirname "$store")" "${store##*/}")
    if (( encrypt )); then
        seal=(gpg --symmetric --compress-algo none --output -)
        (( passphrase_stdin )) && seal=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${seal[@]:1}")
    fi
    # The passphrase reaches gpg on fd 3 (printf is a builtin: never in argv). COPYFILE_DISABLE
    # keeps macOS tar from adding ._ files.
    COPYFILE_DISABLE=1 "${pack[@]}" | "${seal[@]}" > "$file.partial" 3< <(printf '%s\n' "$passphrase")
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Packing the backup failed."
    unset passphrase
    mv "$file.partial" "$file" || die "Cannot write $file."
    show-answer "File" "$file"

    local lines=(
        "Your EnvFolio store is backed up."
        ""
        "File:      $(tilde-path "$file")"
        "Key:       ${keys[0]}"
        "History:   $( (( history )) && echo "included" || echo "not included (add --history)" )"
        "Encrypted: $( (( encrypt )) && echo "yes" || echo "no (add --encrypt)" )"
        ""
        "To restore it, here or on a new machine:"
        "  envfolio store restore $file"
        "That needs the key's passphrase$( (( encrypt )) && echo ", and the backup's own" )."
        "Keep the file somewhere safe and offline."
    )
    echo ""
    show-box "${lines[@]}"
}

# --- store restore ------------------------------------------------------------

function store-restore-usage() {
    echo "Usage: envfolio store restore [--passphrase-stdin] <file>"
}

function store-restore-help() {
    store-restore-usage
    cat <<'EOF'

Bring back an EnvFolio store from a file made by `envfolio store backup`: import its GPG key
(trusted as your own), and put the store at $ENVFOLIO_STORE_DIR (default ~/.envfolio). A backup
without its git history starts a new one. Refuses when $ENVFOLIO_STORE_DIR is a folder with anything
in it. An existing empty folder is used as it is (a folder made here is private, 700); when it is
someone else's or other users can get in, EnvFolio warns and asks before using it.

Options:
  --passphrase-stdin  Read the passphrase of an encrypted backup (--envfolio.gpg) from the first
                      line of stdin, instead of gpg's prompt.
  --allow-unsafe-folder
                      Use an existing empty folder that is someone else's or open to other users
                      without asking (still with the warning).
  -h, --help          Show this help.
EOF
}

# envfolio store restore [--passphrase-stdin] <file>
StoreRestore() {
    local passphrase_stdin=0 allow_unsafe=0 file=""
    while (( $# > 0 )); do
        case $1 in
            --passphrase-stdin) passphrase_stdin=1 ;;
            --allow-unsafe-folder) allow_unsafe=1 ;;
            -h|--help)          store-restore-help ; return 0 ;;
            -*) die "store restore: unknown option: $1${EXTRA_LINE}$(store-restore-usage)" ;;
            *)  [[ -z $file ]] || die "store restore: one file only.${EXTRA_LINE}$(store-restore-usage)"
                file=$1 ;;
        esac
        shift
    done
    [[ -n $file ]] || die "$(store-restore-usage)"
    [[ -f $file ]] || die "There is no file $file."

    local open=(cat)
    case $file in
        *"$ENCRYPTED_BACKUP_SUFFIX")
            open=(gpg --decrypt --output -)
            (( passphrase_stdin )) && open=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${open[@]:1}") ;;
        *"$BACKUP_SUFFIX")
            (( ! passphrase_stdin )) || die "--passphrase-stdin is only for an encrypted backup ($ENCRYPTED_BACKUP_SUFFIX)." ;;
        *)  die "$file is not an EnvFolio backup: its name ends in neither $BACKUP_SUFFIX nor $ENCRYPTED_BACKUP_SUFFIX." ;;
    esac
    # An empty folder is as good as none: the store is moved inside it (it may be a mount point),
    # its mode left as it is.
    local into=0
    if [[ -e $STORE_PATH ]]; then
        is-empty-dir "$STORE_PATH" \
            || die "$STORE_PATH already exists. Move it away to restore there, or run with${EXTRA_LINE}    ENVFOLIO_STORE_DIR=<other-folder> $0 store restore $file"
        accept-unsafe-store "$allow_unsafe" "$passphrase_stdin"
        into=1
    fi

    local passphrase=""
    if (( passphrase_stdin )); then
        IFS= read -rs passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on stdin."
    fi

    # Unpack next to the store's place, so the last step is one rename.
    local target=${STORE_PATH%/} stage
    umask 077
    mkdir -p "$(dirname "$target")" || die "Cannot create $(dirname "$target")."
    stage=$(mktemp -d "$(dirname "$target")/.envfolio-restore.XXXXXX") || die "Cannot make a temporary folder."
    remove-on-exit "$stage"

    section "Unpack the backup"
    "${open[@]}" < "$file" 3< <(printf '%s\n' "$passphrase") | tar -xzf - -C "$stage"
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Unpacking $file failed."
    unset passphrase

    local field value format="" name="" keys=() key
    [[ -f $stage/envfolio-backup.txt ]] || die "$file is not an EnvFolio backup: it has no envfolio-backup.txt."
    while read -r field value; do
        case $field in
            envfolio-backup) format=$value ;;
            store)       name=$value   ;;
            key)         keys+=("$value") ;;
        esac
    done < "$stage/envfolio-backup.txt"
    [[ $format == 1 ]] || die "$file is an EnvFolio backup of a format this EnvFolio cannot read ($format)."
    [[ -n $name && $name != */* && $name != . && $name != .. && -s $stage/$name/.gpg-id ]] \
        || die "$file has no store in it."
    [[ -s $stage/key.asc && ${#keys[@]} -gt 0 ]] || die "$file has no key in it."
    for key in "${keys[@]}"; do
        [[ $key =~ ^[0-9A-F]{40,64}$ ]] || die "$file names a key that is not a fingerprint: $key"
    done
    show-answer "Store" "$name"

    section "Import the key"
    gpg --batch --quiet --import "$stage/key.asc" || die "Importing the key failed."
    printf '%s:6:\n' "${keys[@]}" | gpg --batch --quiet --import-ownertrust || die "Trusting the key failed."
    for key in "${keys[@]}"; do
        gpg --list-secret-keys "$key" >/dev/null 2>&1 || die "The backup's key.asc has no secret key $key."
    done
    show-answer "Key" "${keys[*]}"

    local uid history="from the backup"
    uid=$(key-uid "${keys[0]}")
    if [[ ! -e $stage/$name/.git ]]; then
        section "Start the store's git history"
        STORE_PATH=$stage/$name PASSWORD_STORE_DIR=$stage/$name start-store-history "$uid"
        history="new (the backup had none)"
    fi

    if (( into )); then
        shopt -s dotglob
        mv "$stage/$name"/* "$target/" || die "Cannot move the store to $target."
        shopt -u dotglob
    else
        mv "$stage/$name" "$target" || die "Cannot move the store to $target."
        chmod 700 "$target"         || die "Cannot make $target private."
    fi

    section "Summary"
    show-box "Your EnvFolio store is restored." \
             "" \
             "Store:   $(tilde-path "$target")" \
             "Key:     ${keys[0]}" \
             "         $uid" \
             "History: $history"
    echo ""
}

# --- store export -------------------------------------------------------------

# An export is one file, always locked: envfolio-export.txt (what it holds), key.asc (a new key made
# for this export only, with no passphrase — the lock on the file protects it) and store/, a pass
# store of the chosen items encrypted and signed with that key. Secrets go from one key to the
# other through a pipe, never through a file.
EXPORT_SUFFIX=.envfolio

function store-export-usage() {
    cat <<'EOF'
Usage: envfolio store export [-s|--secrets] [--to <key>|--passphrase-stdin|--passphrase-fd <n>]
                             [-o|--output <file>|<folder>] [<name>...]
EOF
}

function store-export-help() {
    store-export-usage
    cat <<'EOF'

Copy some items into one file, to bring them into another store with `envfolio store import` — on
a server, in a booth, or on another machine. Your store's key stays here: the items are encrypted
and signed with a new key made for this export only, and the file is locked — with a passphrase,
or with --to, to the public key of where it is going. With neither given, EnvFolio asks which.
gpg may ask for your store key's passphrase to read the secrets.

A <name> is a text or secret, or a folder: every text under it, and its secrets with --secrets.
With no <name>, EnvFolio lists every item and asks which ones.

The file is <file> (.envfolio added when missing), or store-<date>.envfolio in <folder> —
never inside the store. An existing file is never replaced. With no -o, EnvFolio asks, offering
store-<date>.envfolio in the current folder (taken as it is with --passphrase-stdin).

Options:
  -s, --secrets       Take the secrets in a folder too. A secret named on its own always goes.
  --to <key>          Lock the file to this public key: a key file (.asc) or a key in your
                      keyring (fingerprint, key id or email). Only its secret key can open it.
  --passphrase-stdin  Read the file's passphrase from the first line of stdin, instead of gpg's
                      prompt. Not with --to. Needs a <name>. An empty passphrase is refused.
  --passphrase-fd <n> Read the file's passphrase from the first line of file descriptor <n>,
                      e.g. --passphrase-fd 3 3< pass.txt. Not with --to. stdin stays free, so the
                      items can still be picked. An empty passphrase is refused.
  -o, --output <file>|<folder>
                      Where to write the file.
  -h, --help          Show this help.
EOF
}

# envfolio store export [-s|--secrets] [--to <key>|--passphrase-stdin|--passphrase-fd <n>]
#                       [-o|--output <file>|<folder>] [<name>...]
# Anything not given is asked for: the items, and how to lock the file.
StoreExport() {
    # Process the command-line options
    local secrets=0 to="" passphrase_stdin=0 passphrase_fd="" target="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -s|--secrets)       secrets=1 ;;
            --to|-o|--output|--passphrase-fd)
                                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                                case $arg in
                                    --to)            to=$1 ;;
                                    --passphrase-fd) passphrase_fd=$1 ;;
                                    *)               target=$1 ;;
                                esac
                                shift ;;
            --to=*)             to=${arg#*=} ;;
            --output=*)         target=${arg#*=} ;;
            --passphrase-fd=*)  passphrase_fd=${arg#*=} ;;
            --passphrase-stdin) passphrase_stdin=1 ;;
            -h|--help)          store-export-help ; return 0 ;;
            --)                 names+=("$@") ; break ;;
            -*)                 die "store export: unknown option: $arg${EXTRA_LINE}$(store-export-usage)" ;;
            *)                  names+=("$arg") ;;
        esac
    done
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--passphrase-stdin and --passphrase-fd cannot be used together."
    fi
    [[ -z $to ]] || { (( ! passphrase_stdin )) && [[ -z $passphrase_fd ]] ; } \
        || die "--passphrase-stdin and --passphrase-fd are for a passphrase; a file locked --to needs none."
    (( ! passphrase_stdin || ${#names[@]} > 0 )) \
        || die "--passphrase-stdin needs the items named: stdin cannot also answer which ones."
    if [[ -n $passphrase_fd ]]; then
        [[ $passphrase_fd =~ ^[0-9]+$ ]] \
            || die "--passphrase-fd needs a file descriptor number, not '$passphrase_fd'."
        { : <&"$passphrase_fd" ; } 2>/dev/null \
            || die "--passphrase-fd $passphrase_fd: no such file descriptor is open."
    fi
    require-store

    section "Overview"
    cat >&2 <<'EOF'
This copies some items into one file, to bring them into another store with `envfolio store import`.
The items are encrypted and signed with a new key made for this export only; your store's key
stays here. The file is locked with a passphrase, or to the public key of where it is going.
It needs:
  - The items to export.
  - Where to write the file.
  - How to lock it.
gpg may ask for your store key's passphrase to read the secrets.
EOF

    section "Parameters"

    # Input: the store — ENVFOLIO_STORE_DIR, default ~/.envfolio (see STORE_PATH at the top)
    show-answer "Store path" "$(tilde-path "$STORE_PATH")"

    # Input: the items — the <name>s (a folder's secrets too with --secrets), or picked from a list
    select-items export "$STORE_PATH" "$secrets" 0 "${names[@]}"
    local item texts=0
    for item in "${SELECTED[@]}"; do [[ $item == *.gpg ]] || texts=$(( texts + 1 )) ; done
    show-answer "Items" "${#SELECTED[@]} (texts: $texts, secrets: $(( ${#SELECTED[@]} - texts )))"
    for item in "${SELECTED[@]}"; do printf '    %s\n' "$(item-label "$item")" >&2 ; done

    # Input: the file — -o <file>|<folder>; otherwise asked, offering a new file in the current
    # folder (taken as it is when stdin carries the passphrase, so cannot answer).
    local file=$target
    if [[ -z $file ]]; then
        file=./store-$(date +%Y%m%d)$EXPORT_SUFFIX
        if (( ! passphrase_stdin )); then
            file=$(ask-path "File (or a folder)" "" "$file") || exit 1
        fi
    fi
    [[ -d $file ]] && file=${file%/}/store-$(date +%Y%m%d)$EXPORT_SUFFIX
    [[ $file == *"$EXPORT_SUFFIX" ]] || file+=$EXPORT_SUFFIX
    [[ ! -e $file ]]            || die "$file already exists."
    [[ -d $(dirname "$file") ]] || die "There is no folder $(dirname "$file")."
    [[ $(cd "$(dirname "$file")" && pwd -P)/ != "$(cd "$STORE_PATH" && pwd -P)"/* ]] \
        || die "$file is inside the store; write the export somewhere else."
    show-answer "File" "$(tilde-path "$file")"

    # Input: the lock — --to <key>, or a passphrase (--passphrase-stdin / --passphrase-fd);
    # with neither, asked: a passphrase (gpg asks for it later), or a public key.
    local choice to_key="To a public key"
    if [[ -z $to && -z $passphrase_fd ]] && (( ! passphrase_stdin )); then
        echo >&2
        choice=$(ask-choice "How should the file be locked?" "With a passphrase" "$to_key") \
            || die "Cancelled."
        if [[ $choice == "$to_key" ]]; then
            to=$(pick-public-key) || exit 1
            [[ -n $to ]] \
                || to=$(ask-path "Public key" "a .asc file, or a fingerprint, key id or email") || exit 1
            [[ -n $to ]] || die "A public key is needed to lock the file to it."
        fi
    fi

    umask 077
    local stage home pack status key recipient="" passphrase=""
    stage=$(mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$stage" "$file.partial"
    home=$stage/home pack=$stage/pack
    new-gpg-home "$home"
    mkdir -p "$pack/store"

    if [[ -n $to ]]; then
        # Into the export's own keyring only: a key file never lands in yours.
        if [[ -f $to ]]; then GNUPGHOME=$home gpg --batch --quiet --import "$to"
        else gpg --export -- "$to" | GNUPGHOME=$home gpg --batch --quiet --import
        fi 2>/dev/null
        recipient=$(GNUPGHOME=$home gpg --list-keys --with-colons 2>/dev/null \
            | awk -F: '$1 == "pub" { p = 1 } $1 == "fpr" && p { p = 0 ; print $10 }')
        [[ -n $recipient ]]                || die "No public key found in or for '$to'."
        [[ $recipient != *$'\n'* ]]        || die "'$to' holds or matches more than one key; give one by its fingerprint."
        show-answer "Lock" "to $recipient $(GNUPGHOME=$home key-uid "$recipient")"
    else
        if (( passphrase_stdin )); then
            IFS= read -rs passphrase || true
            [[ -n $passphrase ]] || die "No passphrase on stdin."
        elif [[ -n $passphrase_fd ]]; then
            IFS= read -rs -u "$passphrase_fd" passphrase || true
            [[ -n $passphrase ]] || die "No passphrase on file descriptor $passphrase_fd."
        fi
        if [[ -n $passphrase ]]; then
            show-answer "Lock" "a passphrase: ************"
        else
            show-answer "Lock" "a passphrase: gpg asks for it when it locks the file"
        fi
    fi

    section "Exporting"
    info "That is everything needed. Exporting now." >&2

    section "Make the export's own key"
    status=$(GNUPGHOME=$home gpg --batch --passphrase '' --status-fd 3 \
                 --quick-generate-key "EnvFolio export $(date +%Y%m%d-%H%M%S)" default default never 3>&1 1>/dev/null 2>/dev/null)
    key=$(printf '%s\n' "$status" | awk '$2 == "KEY_CREATED" { print $4 }')
    [[ -n $key ]] || die "Making the export's key failed."
    echo "$key" > "$pack/store/.gpg-id"
    show-answer "Key" "$key"

    section "Copy the items (gpg may ask for your store key's passphrase)"
    local name out
    for item in "${SELECTED[@]}"; do
        name=${item%.*} out=$pack/store/$item
        mkdir -p "$(dirname "$out")"
        if [[ $item == *.gpg ]]; then
            pass show -- "$name" \
                | GNUPGHOME=$home gpg --batch --quiet --trust-model always --compress-algo none \
                      --encrypt --recipient "$key" --output "$out"
            [[ ${PIPESTATUS[*]} == "0 0" ]] || die "export: could not copy '$name'."
        else
            verify-text "$name"
            cp "$STORE_PATH/$item" "$out"
            GNUPGHOME=$home gpg --batch --quiet --local-user "$key" --detach-sign --output "$out.sig" "$out" \
                || die "export: could not sign '$name'."
        fi
        show-answer "Copied" "$(item-label "$item")"
    done
    GNUPGHOME=$home gpg --batch --armor --export-secret-keys "$key" > "$pack/key.asc" 2>/dev/null
    [[ -s $pack/key.asc ]] || die "Exporting the export's key failed."
    {
        echo "envfolio-export 1"
        echo "created $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "key $key"
    } > "$pack/envfolio-export.txt"

    section "Pack and lock the file"
    if [[ -z $recipient && -z $passphrase ]]; then
        acknowledge "Next, gpg asks you to choose a passphrase for the export file (twice)." \
                    "Whoever imports the file needs it: tell them another way than the file itself."
    fi
    local seal=(gpg --symmetric --compress-algo none --output -)
    [[ -n $passphrase ]] && seal=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${seal[@]:1}")
    [[ -n $recipient ]] && seal=(env GNUPGHOME="$home" gpg --batch --trust-model always --compress-algo none
                                 --encrypt --recipient "$recipient" --output -)
    # As in store backup: the passphrase reaches gpg on fd 3, never in argv.
    COPYFILE_DISABLE=1 tar -czf - -C "$pack" envfolio-export.txt key.asc store \
        | "${seal[@]}" > "$file.partial" 3< <(printf '%s\n' "$passphrase")
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Packing the export failed."
    unset passphrase
    mv "$file.partial" "$file" || die "Cannot write $file."
    show-answer "File" "$file"

    local lock="a passphrase" opens="the file's passphrase"
    if [[ -n $recipient ]]; then
        lock="to $recipient"
        opens="the secret key of $(GNUPGHOME=$home key-uid "$recipient")"
    fi
    echo ""
    show-box "Your items are exported." \
             "" \
             "File:   $(tilde-path "$file")" \
             "Items:  ${#SELECTED[@]} (texts: $texts, secrets: $(( ${#SELECTED[@]} - texts )))" \
             "Locked: $lock" \
             "" \
             "To bring them into a store (a new one, or one that is there):" \
             "  envfolio store import $file" \
             "That needs $opens."
}

# --- store import -------------------------------------------------------------

function store-import-usage() {
    cat <<'EOF'
Usage: envfolio store import [-a|--all] [--overwrite|--skip-existing] [--key <id>]
                             [--passphrase-stdin|--passphrase-fd <n>] [--allow-unsafe-folder]
                             [<file> [<name>...]]
EOF
}

function store-import-help() {
    store-import-usage
    cat <<'EOF'

Bring items from a file made by `envfolio store export` into the EnvFolio store
($ENVFOLIO_STORE_DIR, default ~/.envfolio): the secrets are encrypted to the store's key, the texts
checked and signed with it (gpg may ask for its passphrase). With no store yet, one is made first,
as `envfolio store init` does: its key is asked for here, before anything is made. The export's key
is used here only, never added to your keyring.

With no <file>, EnvFolio asks for it. A <name> is an item in the export, or a folder: every item
under it. With neither <name> nor --all, EnvFolio lists the export's items and asks which ones. An
item already in the store is overwritten or skipped, as the options say; otherwise EnvFolio asks.

Options:
  -a, --all           Take every item in the export.
  --overwrite         Replace the items already in the store.
  --skip-existing     Keep the items already in the store; take only the new ones.
  --key <id>          With no store yet: make it with this key, as `envfolio store init --key`.
  --passphrase-stdin  Read the file's passphrase (or your key's, for a file locked to it) from the
                      first line of stdin. Needs <file>, and --all or a <name>; with no store
                      yet, --key too.
  --passphrase-fd <n> The same, from the first line of file descriptor <n>, e.g.
                      --passphrase-fd 3 3< pass.txt. stdin stays free, so anything not given is
                      still asked for.
  --allow-unsafe-folder
                      Use a store folder that is someone else's or open to other users without
                      asking (still with the warning).
  -h, --help          Show this help.
EOF
}

# envfolio store import [-a|--all] [--overwrite|--skip-existing] [--key <id>]
#                       [--passphrase-stdin|--passphrase-fd <n>] [--allow-unsafe-folder] [<file> [<name>...]]
# Anything not given is asked for: the file, a new store's key, the items, what to do with clashes.
StoreImport() {
    # Process the command-line options
    local all=0 clash="" key_id="" passphrase_stdin=0 passphrase_fd="" allow_unsafe=0 file="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -a|--all)           all=1 ;;
            --overwrite)        clash=overwrite ;;
            --skip-existing)    clash=skip ;;
            --key|--passphrase-fd)
                                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                                if [[ $arg == --key ]]; then key_id=$1 ; else passphrase_fd=$1 ; fi
                                shift ;;
            --key=*)            key_id=${arg#*=} ;;
            --passphrase-fd=*)  passphrase_fd=${arg#*=} ;;
            --passphrase-stdin) passphrase_stdin=1 ;;
            --allow-unsafe-folder) allow_unsafe=1 ;;
            -h|--help)          store-import-help ; return 0 ;;
            -*) die "store import: unknown option: $arg${EXTRA_LINE}$(store-import-usage)" ;;
            *)  if [[ -z $file ]]; then file=$arg ; else names+=("$arg") ; fi ;;
        esac
    done
    (( ! all || ${#names[@]} == 0 )) || die "--all takes every item; give no <name> with it."
    if (( passphrase_stdin )) && [[ -n $passphrase_fd ]]; then
        die "--passphrase-stdin and --passphrase-fd cannot be used together."
    fi
    # stdin carries the passphrase, so it cannot also answer the questions.
    if (( passphrase_stdin )); then
        [[ -n $file ]] || die "--passphrase-stdin needs the file given: stdin cannot also answer which one."
        (( all || ${#names[@]} > 0 )) \
            || die "--passphrase-stdin needs --all or the items named: stdin cannot also answer which ones."
    fi
    if [[ -n $passphrase_fd ]]; then
        [[ $passphrase_fd =~ ^[0-9]+$ ]] \
            || die "--passphrase-fd needs a file descriptor number, not '$passphrase_fd'."
        { : <&"$passphrase_fd" ; } 2>/dev/null \
            || die "--passphrase-fd $passphrase_fd: no such file descriptor is open."
    fi
    [[ -z $file ]] || check-export-file "$file"
    # The store's folder: one there is, or none yet (missing, or an empty folder) to make one in.
    local status=0 new_store=0
    store-exists || status=$?
    if (( status == 2 )) && ! is-empty-dir "$STORE_PATH"; then
        die "$STORE_PATH exists but is not a ready EnvFolio store" \
            "(maybe an earlier \`envfolio store init\` did not finish)." \
            "Remove it and run again, or run with${EXTRA_LINE}    ENVFOLIO_STORE_DIR=<other-folder>"
    fi
    (( status == 0 )) || new_store=1
    (( new_store )) || [[ -z $key_id ]] || die "--key is only for making a new store, and $STORE_PATH is one already."
    if (( new_store && passphrase_stdin )) && [[ -z $key_id ]]; then
        die "--passphrase-stdin with no store yet needs --key: stdin cannot also answer which key."
    fi

    section "Overview"
    cat >&2 <<'EOF'
This brings items from a file made by `envfolio store export` into your EnvFolio store. With no
store yet, one is made first. It needs:
  - The export file, and what opens it: its passphrase, or your key it is locked to.
  - The items to take.
  - The store: the one there is, or the key for a new one.
  - What to do with the items already in the store.
gpg may ask for your store key's passphrase to sign the texts.
EOF

    section "Parameters"

    # Input: the export file — <file>, or asked.
    [[ -n $file ]] || file=$(ask-path "Export file" "a .envfolio file") || exit 1
    [[ -n $file ]] || die "An export file is needed."
    check-export-file "$file"
    show-answer "File" "$(tilde-path "$file")"

    # Input: what opens the file — its passphrase (--passphrase-stdin / --passphrase-fd, or gpg
    # asks), or your key it is locked to (gpg may ask for that key's passphrase).
    local passphrase=""
    if (( passphrase_stdin )); then
        IFS= read -rs passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on stdin."
    elif [[ -n $passphrase_fd ]]; then
        IFS= read -rs -u "$passphrase_fd" passphrase || true
        [[ -n $passphrase ]] || die "No passphrase on file descriptor $passphrase_fd."
    fi

    umask 077
    local stage home root
    stage=$(mktemp -d) || die "Cannot make a temporary folder."
    remove-on-exit "$stage"
    home=$stage/home root=$stage/unpack/store
    new-gpg-home "$home"
    mkdir "$stage/unpack"

    if [[ -z $passphrase ]] && is-passphrase-locked "$file"; then
        acknowledge "Next, gpg asks for the export file's passphrase: the one chosen when it was exported."
    fi
    local open=(gpg --decrypt --output -)
    [[ -n $passphrase ]] && open=(gpg --batch --pinentry-mode loopback --passphrase-fd 3 "${open[@]:1}")
    "${open[@]}" < "$file" 3< <(printf '%s\n' "$passphrase") | tar -xzf - -C "$stage/unpack"
    [[ ${PIPESTATUS[*]} == "0 0" ]] || die "Opening $file failed."
    unset passphrase

    local field value format="" key=""
    [[ -f $stage/unpack/envfolio-export.txt ]] || die "$file is not an EnvFolio export: it has no envfolio-export.txt."
    while read -r field value; do
        case $field in
            envfolio-export) format=$value ;;
            key)         key=$value    ;;
        esac
    done < "$stage/unpack/envfolio-export.txt"
    [[ $format == 1 ]]                 || die "$file is an EnvFolio export of a format this EnvFolio cannot read ($format)."
    [[ $key =~ ^[0-9A-F]{40,64}$ ]]    || die "$file names a key that is not a fingerprint: $key"
    [[ -s $stage/unpack/key.asc && -d $root ]] || die "$file has no key or no items in it."
    GNUPGHOME=$home gpg --batch --quiet --import "$stage/unpack/key.asc" 2>/dev/null
    GNUPGHOME=$home gpg --list-secret-keys "$key" >/dev/null 2>&1 || die "$file has no secret key $key."
    show-answer "Opened" "the export's key is $key"

    # Input: the items — --all, the <name>s, or picked from a list
    select-items import "$root" 1 "$all" "${names[@]}"
    local item name signer texts=0
    for item in "${SELECTED[@]}"; do [[ $item == *.gpg ]] || texts=$(( texts + 1 )) ; done
    show-answer "Items" "${#SELECTED[@]} (texts: $texts, secrets: $(( ${#SELECTED[@]} - texts )))"
    for item in "${SELECTED[@]}"; do printf '    %s\n' "$(item-label "$item")" >&2 ; done

    # Every text must be the one the export signed, before anything is written.
    for item in "${SELECTED[@]}"; do
        [[ $item == *.txt ]] || continue
        signer=$(GNUPGHOME=$home gpg --status-fd 1 --verify "$root/$item.sig" "$root/$item" 2>/dev/null \
                    | awk '$2 == "VALIDSIG" { print $NF }')
        [[ $signer == "$key" ]] || die "import: the signature of '${item%.txt}' in the export does not verify."
    done

    # Input: the store — ENVFOLIO_STORE_DIR, default ~/.envfolio (see STORE_PATH at the top). Before
    # anything is written: the store, or the empty folder it is to be made in, must be safe.
    (( status == 1 )) || accept-unsafe-store "$allow_unsafe" "$passphrase_stdin"
    if (( new_store )); then
        show-answer "Store path" "$(tilde-path "$STORE_PATH") — no store yet: one is made first"
    else
        show-answer "Store path" "$(tilde-path "$STORE_PATH")"
    fi

    # Input: a new store's key — --key; otherwise picked from the keyring's secret keys, or a new
    # one from a name and email (asked with a guess). gpg asks a new key's passphrase when it makes it.
    local init_args=() name email
    if (( new_store )); then
        if [[ -n $key_id ]]; then
            key_id=$(find-key "$key_id") || exit 1
        else
            key_id=$(select-key) || exit 1
        fi
        if [[ -n $key_id ]]; then
            show-answer "Store key" "$key_id"
            init_args=(--key "$key_id")
        else
            name=$( ask-text "Your name"  "e.g. Jane Doe"         "$(guess-name)")  || exit 1
            [[ -n $name  ]] || die "A name is needed to create a key."
            email=$(ask-text "Your email" "e.g. jane@example.com" "$(guess-email)") || exit 1
            [[ -n $email ]] || die "An email is needed to create a key."
            show-answer "Store key" "a new one for $name <$email> — gpg asks for its passphrase"
            init_args=(--name "$name" --email "$email")
        fi
    fi

    # Input: what to do with the items already in the store — --overwrite / --skip-existing, or asked.
    local clashes=()
    for item in "${SELECTED[@]}"; do [[ -f $STORE_PATH/$item ]] && clashes+=("$item") ; done
    if (( ${#clashes[@]} > 0 )); then
        if [[ -z $clash ]]; then
            echo >&2
            echo "Already in the store:" >&2
            for item in "${clashes[@]}"; do printf '    %s\n' "$(item-label "$item")" >&2 ; done
            case $(ask-choice "What to do with these ${#clashes[@]}?" "Overwrite them" "Skip them") in
                Overwrite*) clash=overwrite ;;
                Skip*)      clash=skip ;;
                *)          die "Cancelled." ;;
            esac
        fi
        show-answer "Already in the store" "${#clashes[@]}: $( [[ $clash == skip ]] && echo "skipped" || echo "overwritten" )"
    fi

    section "Importing"
    info "That is everything needed. Importing now." >&2

    if (( new_store )); then
        section "Make the store"
        StoreInit "${init_args[@]}"
    fi
    require-store

    section "Import the items (gpg may ask for your store key's passphrase)"
    local secrets=0 skipped=0
    texts=0
    for item in "${SELECTED[@]}"; do
        name=${item%.*}
        if [[ -f $STORE_PATH/$item && $clash == skip ]]; then
            skipped=$(( skipped + 1 ))
            continue
        fi
        if [[ $item == *.gpg ]]; then
            # pass encrypts to the store's key(s) and commits, as for any secret it is given.
            GNUPGHOME=$home gpg --batch --quiet --decrypt "$root/$item" 2>/dev/null \
                | pass insert --multiline --force -- "$name" >/dev/null
            [[ ${PIPESTATUS[*]} == "0 0" ]] || die "import: could not import '$name'."
            secrets=$(( secrets + 1 ))
        else
            save-text "$name" "Import text for $name." < "$root/$item"
            texts=$(( texts + 1 ))
        fi
        show-answer "Imported" "$(item-label "$item")"
    done

    echo ""
    show-box "Your items are imported." \
             "" \
             "Store:   $(tilde-path "$STORE_PATH")" \
             "Texts:   $texts" \
             "Secrets: $secrets" \
             "Skipped: $skipped (already in the store)"
}

# check-export-file <file>: die unless <file> is there and named as an export.
function check-export-file() {
    [[ -f $1 ]] || die "There is no file $1."
    [[ $1 == *"$EXPORT_SUFFIX" ]] || die "$1 is not an EnvFolio export: its name does not end in $EXPORT_SUFFIX."
}

# is-passphrase-locked <file>: whether an export is locked with a passphrase, not to a key — its first
# OpenPGP packet is a symmetric-key session key (tag 3: 0x8c-0x8f old format, 0xc3 new).
function is-passphrase-locked() {
    case $(od -An -tx1 -N1 "$1" | tr -d ' \n') in
        8c|8d|8e|8f|c3) return 0 ;;
        *)              return 1 ;;
    esac
}

# --- Items: choose some -------------------------------------------------------

# select-items <how> <root> <secrets:0|1> <all:0|1> [<name>...]: set SELECTED to item files
# (<name>.txt, <name>.gpg) under <root>: every one with <all>; else those the names pick — an item
# by its name, or else every item under a folder, its secrets only with <secrets>; else those
# picked from a numbered list.
function select-items() {
    local how=$1 root=$2 secrets=$3 all=$4 items=() taken=$'\n' item name found left answer picks i
    shift 4
    SELECTED=()
    while IFS= read -r item; do items+=("${item#"$root"/}") ; done < <(entries-under 1 "$root")
    (( ${#items[@]} > 0 )) || die "$how: there are no items."

    if (( all )); then
        SELECTED=("${items[@]}")
    elif (( $# > 0 )); then
        for name in "$@"; do
            name=${name%/} found=0 left=0
            [[ -n $name && $name != -* && /$name/ != */../* && /$name/ != */./* ]] \
                || die "$how: '$name' is not a valid name."
            for item in "${items[@]}"; do
                case $item in "$name".txt|"$name".gpg) found=1 ;; *) continue ;; esac
                [[ $taken == *$'\n'"$item"$'\n'* ]] || { SELECTED+=("$item") ; taken+=$item$'\n' ; }
            done
            if (( ! found )); then
                for item in "${items[@]}"; do
                    [[ $item == "$name"/* ]] || continue
                    if [[ $item == *.gpg ]] && (( ! secrets )); then left=$(( left + 1 )) ; continue ; fi
                    found=1
                    [[ $taken == *$'\n'"$item"$'\n'* ]] || { SELECTED+=("$item") ; taken+=$item$'\n' ; }
                done
            fi
            (( found || ! left )) || die "$how: only secrets under '$name' ($left); add --secrets to take them."
            (( found ))           || die "$how: '$name' is not an item or a folder of items."
            (( ! left )) || printf "envfolio %s: left out %d secret(s) under '%s'; add --secrets to take them.\n" \
                                   "$how" "$left" "$name" >&2
        done
    else
        section "Which items?"
        for (( i = 0; i < ${#items[@]}; i++ )); do
            printf '%4d) %s\n' $(( i + 1 )) "$(item-label "${items[i]}")" >&2
        done
        while :; do
            answer=$(ask-text "Numbers or ranges, e.g. 1 3 5-7, or all") || exit 1
            picks=$(parse-picks "${#items[@]}" "$answer") && break
            echo "Not a choice: '$answer'." >&2
        done
        for i in $picks; do SELECTED+=("${items[i - 1]}") ; done
    fi
}

# parse-picks <count> <answer>: the numbers (1..<count>) an answer like "1 3 5-7" or "all" picks,
# one per line, in order, each once. Fails when it picks nothing or anything out of range.
function parse-picks() {
    local count=$1 words word from to i picked=" "
    IFS=' ,' read -r -a words <<< "$2"
    for word in "${words[@]}"; do
        case $word in
            all)                     from=1 to=$count ;;
            *[!0-9-]*|-*|*-|*-*-*)   return 1 ;;
            *-*)                     from=$(( 10#${word%-*} )) to=$(( 10#${word#*-} )) ;;
            *)                       from=$(( 10#$word )) to=$from ;;
        esac
        (( 1 <= from && from <= to && to <= count )) || return 1
        for (( i = from; i <= to; i++ )); do [[ $picked == *" $i "* ]] || picked+="$i " ; done
    done
    [[ $picked != " " ]] || return 1
    printf '%s' "${picked# }" | tr ' ' '\n' | sort -n
}

# item-label <file>: "(S) <name>" for <name>.gpg, "(T) <name>" for <name>.txt — as
# `envfolio ls --flat`.
function item-label() {
    case $1 in
        *.gpg) echo "(S) ${1%.gpg}" ;;
        *)     echo "(T) ${1%.txt}" ;;
    esac
}

#== Command: Text ==============================================================

Text() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        ls)       TextLs        "$@" ;;
        find)     TextFind      "$@" ;;
        grep)     TextGrep      "$@" ;;
        show)     TextShow      "$@" ;;
        insert)   TextInsert    "$@" ;;
        edit)     TextEdit      "$@" ;;
        generate) TextGenerate  "$@" ;;
        rm)       TextRm        "$@" ;;
        mv)       TextMv        "$@" ;;
        cp)       TextCp        "$@" ;;
        "")       echo "Usage: envfolio text <ls|find|grep|show|insert|edit|generate|rm|mv|cp> [args...]" >&2 ; return 1 ;;
        *)        echo "envfolio text: unknown command: $category"                                        >&2 ; return 1 ;;
    esac
}

# A text is a plain file in the store, laid out like the secrets: <name>.txt next to <name>.gpg,
# with <name>.txt.sig — a detached signature by the store's key, so a changed text can be told.

# save-text <name> <commit-message> < content: write, sign and commit <name>.txt.
# The text and its signature are written beside the old ones and swapped in only once signing
# worked, so a failed signature leaves the old text as it was.
function save-text() {
    local name=$1 message=$2 file=$STORE_PATH/$1.txt key
    umask "${PASSWORD_STORE_UMASK:-077}"
    key=$(head -n 1 "$STORE_PATH/.gpg-id")
    mkdir -p "$(dirname "$file")"
    cat > "$file.new"
    if ! gpg --quiet --yes --local-user "$key" --detach-sign --output "$file.sig.new" "$file.new"; then
        rm -f "$file.new" "$file.sig.new"
        die "signing failed; nothing was saved."
    fi
    mv "$file.new" "$file" && mv "$file.sig.new" "$file.sig"

    git -C "$STORE_PATH" add -- "$name.txt" "$name.txt.sig"
    git -C "$STORE_PATH" diff --cached --quiet || git -C "$STORE_PATH" commit --quiet -m "$message"
}

# verify-text <name>: die unless <name>.txt.sig is there, matches, and is by the store's key (the
# first in .gpg-id) — i.e. the text was not changed outside EnvFolio. Needs no passphrase.
function verify-text() {
    local name=$1 file=$STORE_PATH/$1.txt store_key signer check
    check="Uncommitted change:  git -C $STORE_PATH diff -- $name.txt${EXTRA_LINE}"
    check+="Its history:         git -C $STORE_PATH log -p -- $name.txt${EXTRA_LINE}"
    check+="If the text is right, sign it again:  envfolio text insert -f -m $name < $file"
    [[ -f $file.sig ]] || die "'$name' has no signature.${EXTRA_LINE}$check"
    # VALIDSIG's last field is the signing key's primary fingerprint; gpg prints it for a good one only.
    store_key=$(gpg --list-keys --with-colons "$(head -n 1 "$STORE_PATH/.gpg-id")" 2>/dev/null \
        | awk -F: '$1 == "fpr" { print $10; exit }')
    signer=$(gpg --status-fd 1 --verify "$file.sig" "$file" 2>/dev/null | awk '$2 == "VALIDSIG" { print $NF }')
    [[ -n $signer && $signer == "$store_key" ]] \
        || die "the signature of '$name' does not verify with the store's key.${EXTRA_LINE}$check"
}

# --- text ls ------------------------------------------------------------------

function text-ls-help() {
    cat <<'EOF'
Usage: envfolio text ls [--flat] [<subfolder>]

List the texts in the EnvFolio store as a tree — names only. Give a subfolder to list only what is
under it.

Options:
      --flat          Full names, one per line, sorted, instead of a tree.
  -h, --help          Show this help and stop.
EOF
}

# envfolio text ls [<subfolder>]
# As `secret ls`: `pass ls`, for the texts. Only a folder; a text is shown by `text show`.
TextLs() {
    case ${1:-} in -h|--help) text-ls-help ; return 0 ;; esac
    require-store
    list-store txt "Text Store" "text ls" "$@"
}

# --- text find ----------------------------------------------------------------

function text-find-help() {
    cat <<'EOF'
Usage: envfolio text find <part>...

List the texts whose names contain any of the parts (ignoring case), as a tree — names only.

Options:
  -h, --help          Show this help and stop.
EOF
}

# envfolio text find <part>...
# As `secret find`: `pass find`, for the texts.
TextFind() {
    local arg terms
    for arg in "$@"; do case $arg in -h|--help) text-find-help ; return 0 ;; esac ; done
    (( $# > 0 )) || die "Usage: envfolio text find <part>..."
    require-store
    terms="*$(printf '%s*|*' "$@")"
    printf 'Search Terms: %s\n' "$*"
    store-tree txt "$STORE_PATH" -P "${terms%|*}" --matchdirs --ignore-case
}

# --- text grep ----------------------------------------------------------------

function text-grep-help() {
    cat <<'EOF'
Usage: envfolio text grep [<grep-option>...] <pattern>

Print the lines of every text that match <pattern>, under each text's name.

Options:
  <grep-option>       Any option of grep, e.g. -i to ignore case, -v to invert the match.
  -h, --help          Show this help and stop (not grep's -h).
EOF
}

# envfolio text grep [<grep-option>...] <pattern>
# As `pass grep`, over the texts: the same loop, reading each .txt instead of decrypting a .gpg.
TextGrep() {
    local arg file found dir
    for arg in "$@"; do case $arg in --) break ;; -h|--help) text-grep-help ; return 0 ;; esac ; done
    (( $# > 0 )) || die "Usage: envfolio text grep [<grep-option>...] <pattern>"
    require-store
    while IFS= read -r -d '' file; do
        found=$(grep --color=always "$@" < "$file") || continue
        file=${file%.txt} ; file=${file#"$STORE_PATH"/}
        dir="${file%/*}/" ; [[ $dir == "$file/" ]] && dir=""
        printf '\e[94m%s\e[1m%s\e[0m:\n' "$dir" "${file##*/}"
        printf '%s\n' "$found"
    done < <(find -L "$STORE_PATH" -path '*/.git' -prune -o -name '*.txt' -print0)
}

# --- text show ----------------------------------------------------------------

function text-show-help() {
    cat <<'EOF'
Usage: envfolio text show [-c|--clip[=<line>]] <name>

Show a text: check its signature, then print it. A text whose signature is missing, does not
match, or is not by the store's key is not shown — it was changed outside EnvFolio.
With --clip, copy its first line to the clipboard instead. A text is not a secret, so the
clipboard is not cleared afterwards.

Options:
  -c, --clip[=<line>] Copy the first line — or line <line> — to the clipboard; print nothing.
  -h, --help          Show this help and stop.
EOF
}

# envfolio text show [-c|--clip[=<line>]] <name>
# Only a text that verifies is shown: signed (<name>.txt.sig) by the store's key, unchanged since.
# --clip picks a line as `pass show --clip` does.
TextShow() {
    local clip="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)  text-show-help ; return 0 ;;
            -c|--clip)  clip=1 ;;
            -c[0-9]*)   clip=${arg#-c} ;;
            --clip=*)   clip=${arg#*=} ;;
            --)         names+=("$@") ; break ;;
            -*)         die "text show: unknown option: $arg" ;;
            *)          names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 )) || die "Usage: envfolio text show [-c|--clip[=<line>]] <name>"
    local name=${names[0]} line copy
    [[ $name != -* && /$name/ != */../* ]] || die "text show: '$name' is not a valid name."
    [[ -z $clip || $clip =~ ^[1-9][0-9]*$ ]] || die "text show: '$clip' is not a line number."
    require-store
    [[ -f $STORE_PATH/$name.txt ]] || die "text show: '$name' is not a text in the store."
    verify-text "$name"
    [[ -n $clip ]] || { cat "$STORE_PATH/$name.txt" ; return ; }

    line=$(tail -n "+$clip" "$STORE_PATH/$name.txt" | head -n 1)
    [[ -n $line ]] || die "text show: '$name' has no text at line $clip."
    # The same tool ensure-requirements checks for.
    if   [[ $(uname -s) == Darwin    ]]; then copy=(pbcopy)
    elif [[ -n ${WAYLAND_DISPLAY:-}  ]]; then copy=(wl-copy)
    elif [[ -n ${DISPLAY:-}          ]]; then copy=(xclip -selection clipboard)
    else die "text show: no clipboard: no X11 or Wayland display."
    fi
    # stdout away: a clipboard tool that stays to serve the copy must not hold `$(envfolio ...)`
    # open.
    printf '%s' "$line" | "${copy[@]}" >/dev/null || die "text show: could not copy to the clipboard."
    echo "Copied $name to clipboard. A text is not a secret: the clipboard is not cleared."
}

# --- text insert --------------------------------------------------------------

function text-insert-help() {
    cat <<'EOF'
Usage: envfolio text insert [-m|--multiline] [-f|--force] [-t|--text <text>] <name>

Add a text to the EnvFolio store — kept plain, not encrypted — and sign it with the store's key
(gpg may ask for the key's passphrase). The text is asked for once, with echo; piped in, it is
the first line. Texts are not secrets: never put a secret here.

Options:
  -t, --text <text>   The text itself, instead of asking.
  -m, --multiline     The text is several lines; end it with Ctrl-D. Piped in, all of stdin.
  -f, --force         Overwrite an existing text without asking (only asked at a terminal).
  -h, --help          Show this help and stop.
EOF
}

# envfolio text insert [-m|--multiline] [-f|--force] [-t|--text <text>] <name>
# Like `pass insert`, but the text is written plain and signed, not encrypted.
TextInsert() {
    local multiline=0 force=0 given=0 text="" names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)      text-insert-help ; return 0 ;;
            -m|--multiline) multiline=1 ;;
            -f|--force)     force=1 ;;
            -t|--text)      (( $# > 0 )) || die "$arg needs a value." ; text=$1 ; given=1 ; shift ;;
            --text=*)       text=${arg#*=} ; given=1 ;;
            --)             names+=("$@") ; break ;;
            -*)             die "text insert: unknown option: $arg" ;;
            *)              names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 )) || die "Usage: envfolio text insert [-m|--multiline] [-f|--force] [-t|--text <text>] <name>"
    local name=${names[0]} file content
    # As pass's check_sneaky_paths: no way out of the store.
    [[ -n $name && $name != */ && /$name/ != */../* ]] || die "text insert: '$name' is not a valid name."
    require-store
    file=$STORE_PATH/$name.txt

    if [[ -e $file ]] && (( ! force )) && [[ -t 0 ]]; then
        confirm "An entry already exists for $name. Overwrite it?" || exit 1
    fi

    if (( given )); then
        content=$text$'\n'
    elif (( multiline )); then
        [[ -t 0 ]] && printf 'Enter contents of %s and press Ctrl+D when finished:\n\n' "$name" >&2
        content=$(cat ; printf .) ; content=${content%.}   # the dot keeps trailing newlines
    else
        [[ -t 0 ]] && printf 'Enter text for %s: ' "$name" >&2
        IFS= read -r text || [[ -n $text ]] || die "text insert: no text given."
        content=$text$'\n'
    fi

    printf '%s' "$content" | save-text "$name" "Add given text for $name to store."
}

# --- text edit ----------------------------------------------------------------

function text-edit-help() {
    cat <<'EOF'
Usage: envfolio text edit <name>

Edit a text in $EDITOR (vi if unset), or add it if it is new; then sign and commit it. The text's
signature is checked first: a text changed outside EnvFolio is not opened.

Options:
  -h, --help          Show this help and stop.
EOF
}

# envfolio text edit <name>
# As `pass edit`: edit a copy, keep it only if it changed. A text is checked first, so editing never
# signs a text that was changed outside EnvFolio.
TextEdit() {
    case ${1:-} in -h|--help) text-edit-help ; return 0 ;; esac
    (( $# == 1 )) || die "Usage: envfolio text edit <name>"
    local name=${1%/} file tmp_dir tmp_file action=Add editor=${EDITOR:-vi}
    [[ -n $name && $name != -* && /$name/ != */../* ]] || die "text edit: '$name' is not a valid name."
    require-store
    file=$STORE_PATH/$name.txt
    tmp_dir=$(mktemp -d)
    remove-on-exit "$tmp_dir"
    tmp_file=$tmp_dir/${name//\//-}.txt

    if [[ -f $file ]]; then
        verify-text "$name"
        cp "$file" "$tmp_file"
        action=Edit
    fi
    # Unquoted, as pass does: EDITOR may carry arguments, e.g. "code --wait".
    # shellcheck disable=SC2086
    $editor "$tmp_file"
    [[ -f $tmp_file ]] || die "Text not saved."
    [[ -f $file ]] && cmp -s "$file" "$tmp_file" && die "Text unchanged."
    save-text "$name" "$action text for $name using $editor." < "$tmp_file"
}

# --- text generate ------------------------------------------------------------

function text-generate-help() {
    cat <<'EOF'
Usage: envfolio text generate [-n|--no-symbols] [-i|--in-place|-f|--force] <name> [<length>]

Generate a random text (25 characters unless <length> is given), save and sign it, and print it.
It is a text, kept plain — for a random password, use `envfolio secret generate`.

Options:
  -n, --no-symbols    Letters and digits only.
  -i, --in-place      Replace only the first line of an existing text; keep the rest.
  -f, --force         Overwrite an existing text without asking (only asked at a terminal).
  -h, --help          Show this help and stop.
EOF
}

# envfolio text generate [-n|--no-symbols] [-i|--in-place|-f|--force] <name> [<length>]
# As `pass generate`, for a text: the same characters and length, then saved and signed.
TextGenerate() {
    local chars=${PASSWORD_STORE_CHARACTER_SET:-[:punct:][:alnum:]} inplace=0 force=0 args=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)       text-generate-help ; return 0 ;;
            -n|--no-symbols) chars=${PASSWORD_STORE_CHARACTER_SET_NO_SYMBOLS:-[:alnum:]} ;;
            -i|--in-place)   inplace=1 ;;
            -f|--force)      force=1 ;;
            --)              args+=("$@") ; break ;;
            -*)              die "text generate: unknown option: $arg" ;;
            *)               args+=("$arg") ;;
        esac
    done
    (( (${#args[@]} == 1 || ${#args[@]} == 2) && !(inplace && force) )) \
        || die "Usage: envfolio text generate [-n|--no-symbols] [-i|--in-place|-f|--force] <name> [<length>]"
    local name=${args[0]} length=${args[1]:-${PASSWORD_STORE_GENERATED_LENGTH:-25}} file text
    [[ -n $name && $name != */ && /$name/ != */../* ]] || die "text generate: '$name' is not a valid name."
    [[ $length =~ ^[0-9]+$ && $length -gt 0 ]] || die "text generate: the length must be a number above 0."
    require-store
    file=$STORE_PATH/$name.txt

    if [[ -e $file ]] && (( ! inplace && ! force )) && [[ -t 0 ]]; then
        confirm "An entry already exists for $name. Overwrite it?" || exit 1
    fi
    read -r -n "$length" text < <(LC_ALL=C tr -dc "$chars" < /dev/urandom 2>/dev/null)
    [[ ${#text} -eq $length ]] || die "text generate: could not generate a text from /dev/urandom."

    if (( inplace )) && [[ -f $file ]]; then
        # The rest of the text is kept, so it must be the one EnvFolio signed.
        verify-text "$name"
        { printf '%s\n' "$text" ; tail -n +2 "$file" ; } \
            | save-text "$name" "Replace generated text for $name." || exit 1
    else
        printf '%s\n' "$text" | save-text "$name" "Add generated text for $name." || exit 1
    fi
    printf 'The generated text for %s is:\n%s\n' "$name" "$text"
}

# --- text rm ------------------------------------------------------------------

function text-rm-help() {
    cat <<'EOF'
Usage: envfolio text rm [-r|--recursive] [-f|--force] <name>

Remove a text, or every text in a folder with --recursive (secrets in it are kept). At a
terminal, asks first unless --force; from a script or pipe, it does not ask.
The removed text stays in the store's git history.

Options:
  -r, --recursive     Remove every text in a folder.
  -f, --force         Do not ask.
  -h, --help          Show this help and stop.
EOF
}

# envfolio text rm [-r|--recursive] [-f|--force] <name>
# As `pass rm`, for texts: <name> is a text, or — ending in / or not a text — a folder.
TextRm() {
    local recursive=0 force=0 names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)      text-rm-help ; return 0 ;;
            -r|--recursive) recursive=1 ;;
            -f|--force)     force=1 ;;
            --)             names+=("$@") ; break ;;
            -*)             die "text rm: unknown option: $arg" ;;
            *)              names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 )) || die "Usage: envfolio text rm [-r|--recursive] [-f|--force] <name>"
    local name=${names[0]} path=${names[0]%/} folder=0
    [[ -n $path && /$path/ != */../* ]] || die "text rm: '$name' is not a valid name."
    require-store

    if [[ -f $STORE_PATH/$path.txt && ! ( $name == */ && -d $STORE_PATH/$path ) ]]; then
        folder=0
    elif [[ -d $STORE_PATH/$path ]]; then
        (( recursive )) || die "text rm: '$path' is a folder; use -r to remove the texts in it."
        folder=1
    else
        die "text rm: '$name' is not in the store."
    fi
    (( force )) || [[ ! -t 0 ]] || confirm "Are you sure you would like to delete $path?" || exit 1

    if (( folder )); then
        find "$STORE_PATH/$path" -type f \( -name '*.txt' -o -name '*.txt.sig' \) -exec rm -f -- {} +
        find "$STORE_PATH/$path" -depth -type d -empty -exec rmdir -- {} \;
        # git's * matches across folders: every text under <path>.
        git -C "$STORE_PATH" rm -r -q --cached --ignore-unmatch -- "$path/*.txt" "$path/*.txt.sig"
    else
        rm -f -- "$STORE_PATH/$path.txt" "$STORE_PATH/$path.txt.sig"
        git -C "$STORE_PATH" rm -q --cached --ignore-unmatch -- "$path.txt" "$path.txt.sig"
    fi
    rmdir -p "$(dirname "$STORE_PATH/$path")" 2>/dev/null
    git -C "$STORE_PATH" diff --cached --quiet || git -C "$STORE_PATH" commit --quiet -m "Remove $path from store."
}

