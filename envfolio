#== Command: Exec ==============================================================

function run-exec-help() {
    cat <<'HELP'
Usage: envfolio exec [-s|--secrets] [-a|--all] [-n|--names] <entry>... -- <command> [<arg>...]

Run a command with entries from the store as environment variables. Texts load by default;
secrets only with --secrets. Values are never printed.

An <entry> is a text or secret name, a folder (every entry under it), or VAR=<name> to pick
the variable's name. Otherwise the name comes from the entry's path: a top folder starting with @
(a namespace) is removed, / turns into _, and it is uppercased (@nawa/gh/token -> GH_TOKEN). A
later entry overrides an earlier one; VAR=<name> overrides them all.

Options:
  -s, --secrets       Also load secrets.
  -a, --all           Load every entry outside the @namespaces first; <entry> is then optional.
  -n, --names         Only show which variable would get which entry, and stop: nothing is read,
                      nothing runs.
  -h, --help          Show this help and stop.
HELP
}

function run-shell-help() {
    cat <<'HELP'
Usage: envfolio shell [-s|--secrets] [-a|--all] [-n|--names] <entry>...

Start your shell ($SHELL) with entries from the store as environment variables, and say which
names were loaded (never their values). ENVFOLIO_SHELL=1 is set. Type `exit` to leave.
Entries and variable names are as in `envfolio exec`.

Options:
  -s, --secrets       Also load secrets.
  -a, --all           Load every entry outside the @namespaces first; <entry> is then optional.
  -n, --names         Only show which variable would get which entry, and stop: nothing is read,
                      nothing runs.
  -h, --help          Show this help and stop.
HELP
}

Exec()  { exec-with-entries exec  "$@" ; }
Shell() { exec-with-entries shell "$@" ; }

VAR_NAME_PATTERN='^[A-Za-z_][A-Za-z0-9_]*$'

# exec-with-entries <exec|shell> [-s|--secrets] <entry>... [-- <command> [<arg>...]]
# Read every entry first, then export them all at once and exec: no `pass` or `gpg` call made
# while reading ever sees a value already loaded.
function exec-with-entries() {
    local how=$1 secrets=0 all=0 only_names=0 dashes=0 entries=() arg ; shift
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)    "run-$how-help" ; return 0 ;;
            -s|--secrets) secrets=1 ;;
            -a|--all)     all=1 ;;
            -n|--names)   only_names=1 ;;
            --)           dashes=1 ; break ;;
            -*)           die "$how: unknown option: $arg" ;;
            *)            entries+=("$arg") ;;
        esac
    done
    if [[ $how == exec ]]; then
        (( (${#entries[@]} > 0 || all) && (only_names || (dashes && $# > 0)) )) \
            || die "Usage: envfolio exec [-s|--secrets] [-a|--all] [-n|--names] <entry>... -- <command> [<arg>...]"
    else
        (( (${#entries[@]} > 0 || all) && ! dashes )) \
            || die "Usage: envfolio shell [-s|--secrets] [-a|--all] [-n|--names] <entry>..."
        set -- "${SHELL:-/bin/sh}"
    fi
    require-store
    # --all is the store's root (""), loaded first wherever it was typed.
    (( all )) && entries=("" "${entries[@]}")
    resolve-entries "$how" "$secrets" "${entries[@]}"
    (( only_names )) && { print-entry-names ; return 0 ; }

    local pairs=() i file value texts=0
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        file=${EXEC_FILES[i]}
        if [[ $file == *.txt ]]; then
            verify-text "${file%.txt}"
            value=$(cat "$STORE_PATH/$file") ; texts=$(( texts + 1 ))
        else
            value=$(pass show -- "${file%.gpg}") || die "$how: could not decrypt '${file%.gpg}'."
        fi
        pairs+=("${EXEC_VARS[i]}=$value")
    done
    unset value

    if [[ $how == shell ]]; then
        local names
        names=$(printf ', %s' "${EXEC_VARS[@]}")
        printf "envfolio shell: loaded %s (texts: %d, secrets: %d). Type 'exit' to leave.\n" \
            "${names#, }" "$texts" $(( ${#EXEC_VARS[@]} - texts )) >&2
        export ENVFOLIO_SHELL=1
    fi
    if [[ -n $CALLER_STORE_DIR_SET ]]; then export PASSWORD_STORE_DIR=$CALLER_STORE_DIR
    else unset PASSWORD_STORE_DIR
    fi
    # Arrays would swallow a loaded name of theirs (export makes it element 0, never exported).
    set -- "${pairs[@]}" -- "$@"
    unset pairs entries EXEC_VARS EXEC_FILES
    export-and-exec "$@"
}

# export-and-exec <var>=<value>... -- <command> [<arg>...]
# Export each, check that the command will really get it, then exec. Only positional parameters,
# so no loaded name can clobber what this needs; the check catches the names bash keeps for
# itself (RANDOM, UID, ...).
function export-and-exec() {
    while [[ $1 != -- ]]; do
        set -- "${1%%=*}" "$@"
        # shellcheck disable=SC2163  # $2 is <var>=<value>, exported as written
        if ! export -- "$2" 2>/dev/null \
            || [[ $(declare -p -- "$1" 2>/dev/null) != "declare -x $1="* || ${!1} != "${2#*=}" ]]; then
            die "could not set $1: bash or EnvFolio keeps that name for itself. Load it under another name with VAR=<name>."
        fi
        shift 2
    done
    shift
    exec "$@"
}

# resolve-entries <exec|shell> <secrets:0|1> <entry>...
# Work out which variable gets which entry, into EXEC_VARS[i] <- EXEC_FILES[i] (<name>.txt or
# <name>.gpg). VAR=<name> entries first: they claim their entry, and are applied last so they win.
# Every other entry is named by its path, a later one overriding an earlier one. An empty entry is
# the store's root (--all): every entry outside the @namespaces.
function resolve-entries() {
    local how=$1 secrets=$2 entry var name found file claimed=" " exp_vars=() exp_files=() i
    shift 2
    EXEC_VARS=() EXEC_FILES=()
    for entry in "$@"; do
        is-explicit "$entry" || continue
        var=${entry%%=*} name=${entry#*=}
        [[ $var =~ $VAR_NAME_PATTERN ]] || die "$how: '$var' is not a valid variable name."
        entry-file "$how" "$secrets" "$name" || die "$how: '$name' is not a text or secret in the store."
        exp_vars+=("$var") ; exp_files+=("$ENTRY_FILE") ; claimed+="$ENTRY_FILE "
    done

    for entry in "$@"; do
        is-explicit "$entry" && continue
        found=0
        if [[ -n $entry ]] && entry-file "$how" "$secrets" "$entry"; then
            found=1
            [[ $claimed == *" $ENTRY_FILE "* ]] || add-derived "$how" "$ENTRY_FILE"
        elif [[ -z $entry || -d $STORE_PATH/$entry ]]; then
            while IFS= read -r file; do
                file=${file#"$STORE_PATH"/}
                [[ -n $entry || $file != @* ]] || continue
                if [[ $file == *.gpg && -f $STORE_PATH/${file%.gpg}.txt ]]; then
                    die "$how: '${file%.gpg}' is both a text and a secret; give one VAR=<name> or rename one."
                fi
                found=1
                [[ $claimed == *" $file "* ]] || add-derived "$how" "$file"
            done < <(entries-under "$secrets" "$STORE_PATH${entry:+/${entry%/}}")
            (( secrets )) || note-skipped-secrets "$how" "$entry" "$found"
        fi
        if (( ! found )); then
            [[ -n $entry ]] && die "$how: '$entry' has no entries to load."
            die "$how: the store has no entries to load."
        fi
    done

    for (( i = 0; i < ${#exp_vars[@]}; i++ )); do set-entry-var "${exp_vars[i]}" "${exp_files[i]}" ; done
    (( ${#EXEC_VARS[@]} > 0 )) || die "$how: nothing to load."
}

# print-entry-names: what --names shows — each variable and the entry it would get, in order,
# (S)ecret or (T)ext. Nothing is read or decrypted.
function print-entry-names() {
    local i width=0 file kind
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        (( ${#EXEC_VARS[i]} > width )) && width=${#EXEC_VARS[i]}
    done
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        file=${EXEC_FILES[i]} kind=T
        [[ $file == *.gpg ]] && kind=S
        printf '%-*s <- %s (%s)\n' "$width" "${EXEC_VARS[i]}" "${file%.*}" "$kind"
    done
}

# is-explicit <entry>: true for VAR=<name> (no / or [ before the =).
function is-explicit() { [[ $1 == *=* && ${1%%=*} != *[/[]* ]] ; }

# entry-file <how> <secrets> <name>: set ENTRY_FILE to the one entry <name> is, or return 1 when
# it is none (e.g. a folder). Refuse a secret without --secrets, and a name that is both kinds.
function entry-file() {
    local how=$1 secrets=$2 name=$3
    [[ -n ${name%/} && $name != -* && /$name/ != */../* && /$name/ != */./* ]] \
        || die "$how: '$name' is not a valid name."
    local txt=$STORE_PATH/$name.txt gpg=$STORE_PATH/$name.gpg
    if [[ -f $gpg ]] && (( secrets )); then
        [[ ! -f $txt ]] || die "$how: '$name' is both a text and a secret; give one VAR=<name> or rename one."
        ENTRY_FILE=$name.gpg
    elif [[ -f $txt ]]; then
        ENTRY_FILE=$name.txt
    elif [[ -f $gpg ]]; then
        die "$how: '$name' is a secret; add --secrets to load it."
    else
        return 1
    fi
}

# entries-under <secrets> <folder>: the texts (and with secrets, the secrets) under <folder>,
# sorted, leaving out hidden ones like .git.
function entries-under() {
    local kinds=(-name '*.txt')
    (( $1 )) && kinds+=(-o -name '*.gpg')
    find "$2" -mindepth 1 -name '.*' -prune -o -type f \( "${kinds[@]}" \) -print | LC_ALL=C sort
}

# note-skipped-secrets <how> <folder> <found:0|1>: say on stderr how many secrets were left out
# for want of --secrets (names and values never shown). With nothing else found, that is the error.
# An empty <folder> is the store's root (--all), its @namespaces left out.
function note-skipped-secrets() {
    local how=$1 entry=$2 found=$3 file count=0 where
    while IFS= read -r file; do
        [[ -n $entry || ${file#"$STORE_PATH"/} != @* ]] && count=$(( count + 1 ))
    done < <(find "$STORE_PATH${entry:+/${entry%/}}" -mindepth 1 -name '.*' -prune -o -type f -name '*.gpg' -print)
    (( count > 0 )) || return 0
    where="under '$entry'" ; [[ -n $entry ]] || where="in the store"
    (( found )) || die "$how: only secrets $where ($count); add --secrets to load them."
    printf "envfolio %s: left out %d secret(s) %s; add --secrets to load them.\n" "$how" "$count" "$where" >&2
}

# add-derived <how> <file>: name <file> by its path — @nawa/gh/token.gpg -> GH_TOKEN — or, when
# that is not a valid variable name, warn and leave it out. Only a top @folder is a namespace.
function add-derived() {
    local how=$1 name=${2%.*} var
    var=${name}
    [[ $var == @*/* ]] && var=${var#*/}
    var=$(printf '%s' "${var//\//_}" | LC_ALL=C tr '[:lower:]' '[:upper:]')
    if [[ $var =~ $VAR_NAME_PATTERN ]]; then
        set-entry-var "$var" "$2"
    else
        printf "envfolio %s: warning: '%s' would be %s, not a valid variable name; left out. Use VAR=%s.\n" \
            "$how" "$name" "$var" "$name" >&2
    fi
}

# set-entry-var <var> <file>: <var> gets <file>, replacing what it had.
function set-entry-var() {
    local i
    for (( i = 0; i < ${#EXEC_VARS[@]}; i++ )); do
        [[ ${EXEC_VARS[i]} == "$1" ]] && { EXEC_FILES[i]=$2 ; return 0 ; }
    done
    EXEC_VARS+=("$1") ; EXEC_FILES+=("$2")
}

#== Common Functions ===========================================================

# --- Pass ---------------------------------------------------------------------

# call-pass <help-function> <pass-command> [args...]
# Show EnvFolio's help on -h/--help (before any --); otherwise hand everything to `pass <command>`.
function call-pass() {
    local help=$1 command=$2 arg ; shift 2
    for arg in "$@"; do
        case $arg in
            --)        break ;;
            -h|--help) "$help" ; return 0 ;;
        esac
    done
    pass "$command" "$@"
}

# list-store <gpg|txt|all> <title> <command> [--flat] [<subfolder>]: what `envfolio ls`, `text ls`
# and `secret ls` share — the tree under <title>, or with --flat, the full names one per line.
function list-store() {
    local kind=$1 title=$2 command=$3 flat=0 args=() arg ; shift 3
    for arg in "$@"; do
        case $arg in
            --flat) flat=1 ;;
            *)      args+=("$arg") ;;
        esac
    done
    set -- "${args[@]}"
    (( $# <= 1 )) || die "Usage: envfolio $command [--flat] [<subfolder>]"
    [[ $# -eq 0 || ( $1 != -* && /$1/ != */../* && -d $STORE_PATH/$1 ) ]] \
        || die "$command: '$1' is not a folder in the store."
    if (( flat )); then store-flat "$kind" "$STORE_PATH${1:+/${1%/}}" ; return ; fi
    echo "$title"
    [[ $# -eq 0 ]] || echo "${1%/}"
    store-tree "$kind" "$STORE_PATH/${1:-}"
}

# store-flat <gpg|txt|all> <folder>: as store-tree, but full names one per line, sorted. With all,
# each name gets (S) or (T) in front. Follows links, as tree -l does; hidden ones (.git) left out.
function store-flat() {
    local kind=$1 file
    find -L "$2" -mindepth 1 -name '.*' -prune -o -type f \( -name '*.gpg' -o -name '*.txt' \) -print \
        | LC_ALL=C sort \
        | while IFS= read -r file; do
            file=${file#"$STORE_PATH"/}
            case $kind:$file in
                gpg:*.gpg) echo "${file%.gpg}" ;;
                txt:*.txt) echo "${file%.txt}" ;;
                all:*.gpg) echo "(S) ${file%.gpg}" ;;
                all:*.txt) echo "(T) ${file%.txt}" ;;
            esac
        done
}

# store-tree <gpg|txt|all> <folder> [tree-option...]: the secrets (gpg), the texts (txt) or both
# (all) under <folder> as a tree, names only. pass's own `tree` line (ls, find), plus leaving out
# signatures, the other kind, and folders left empty. With all, each name gets (S) or (T) in front.
function store-tree() {
    local kind=$1 folder=$2 others ; shift 2
    case $kind in
        gpg) others='*.txt|*.txt.sig' ;;
        txt) others='*.gpg|*.txt.sig' ;;
        all) others='*.txt.sig'       ;;
    esac
    tree -N -C -l --noreport -I "$others" --prune "$@" "$folder" | tail -n +2 \
        | if [[ $kind == all ]]; then
            # "├── name.gpg" -> "├── (S) name"; tree draws "|-- " instead outside UTF-8.
            sed -E -e 's/^(.*(── |-- ))(.*)\.gpg(\x1B\[[0-9]+m)?( ->.*)?$/\1(S) \3\4\5/' \
                   -e 's/^(.*(── |-- ))(.*)\.txt(\x1B\[[0-9]+m)?( ->.*)?$/\1(T) \3\4\5/'
        else
            sed -E "s/\\.$kind(\x1B\\[[0-9]+m)?( ->|\$)/\\1\\2/g"
        fi
}

# --- Requirements -------------------------------------------------------------

# Ensure that all the dependency are there. Show when at lease one is missing.
function ensure-requirements() {
    local failed=0

    has-dependency() { command -v "${1// /}" >/dev/null 2>&1 ; }
    # lines <cmd> <reason> <install> [optional]: a missing optional one is marked, but doesn't fail.
    lines() {
        local cmd="$1" reason="$2" install="$3" optional="${4:-}"
        local icon=$'\e[32m✓\e[0m'
        if ! has-dependency "$cmd"; then
            if [[ -n $optional ]]; then icon=$'\e[33m-\e[0m'; else icon=$'\e[31m✗\e[0m' ; failed=1 ; fi
        fi
        echo "| $icon $cmd  | $reason | $install |"
        echo "+------------+--------------------+---------------------------+"
    }

    echo "Dependencies"
    echo "+------------+--------------------+---------------------------+"
    echo "| Dependency | Description        | Brew install command      |"
    echo "+------------+--------------------+---------------------------+"
    lines     "pass   " "Password manager  " "brew install pass        "
    lines     "gpg    " "Encrypts the store" "brew install gnupg       "
    lines     "git    " "Syncs the store   " "brew install git         "
    lines     "tree   " "Lists the store   " "brew install tree        "

    if [[ "$1 $2" =~ store\ (backup|restore|import|export) ]]; then
        lines     "tar    " "Packs backups     " "brew install gnu-tar     "
        lines     "gzip   " "Compresses backups" "brew install gzip        "
    fi

    # Clipboard: only the tool `show -c` and `generate -c` use on this platform; none without a display.
    if [[ "$*" =~ ^(secret|text)\ (show|generate)\ (.*\ )?(--clip|-[a-z]*c) ]]; then
        if   [[ "$(uname -s)" == "Darwin" ]]; then : # pbcopy - should be built-in in Mac.
        elif [[ -n "${WAYLAND_DISPLAY:-}" ]]; then lines "wl-copy" "Clipboard copy    " "brew install wl-clipboard"
        elif [[ -n "${DISPLAY:-}"         ]]; then lines "xclip  " "Clipboard copy    " "brew install xclip       "
        fi
    fi

    echo ""
    echo "Use other package manager if brew is not present."

    return "$failed"
}

# --- Output -------------------------------------------------------------------

function info() { printf '%s\n' "$*"; }
function die()  { printf 'envfolio: %s\n' "$*" >&2; exit 1; }
# remove-on-exit <path>...: remove these when EnvFolio exits, however it exits. The gpg-agent of a
# new-gpg-home is stopped first.
REMOVE_ON_EXIT=() GPG_HOMES=()
function remove-on-exit() {
    REMOVE_ON_EXIT+=("$@")
    # shellcheck disable=SC2154  # h is the trap's own loop variable
    trap 'for h in "${GPG_HOMES[@]}"; do GNUPGHOME=$h gpgconf --kill gpg-agent; done 2>/dev/null
          rm -rf -- "${REMOVE_ON_EXIT[@]}"' EXIT
}
# new-gpg-home <folder>: a GnuPG home of its own, for an export's key; gone when EnvFolio exits.
function new-gpg-home() {
    mkdir -m 700 "$1" || die "Cannot make a temporary folder."
    GPG_HOMES+=("$1")
    remove-on-exit "$1"
}

# section lines up: ==| Title |=====…
function section() {
    local title="==| $* |" width=72 fill
    fill=$(( width - ${#title} ))
    (( fill >= 3 )) || fill=3
    printf '\n%s%s\n' "$title" "$(printf '%*s' "$fill" '' | tr ' ' '=')" >&2;
}
# section end: ======…  (same width as section)
function section-end() {
    printf '%s\n\n' "$(printf '%*s' 72 '' | tr ' ' '=')" >&2;
}

function show-answer() {
    local spaces="${3:-}"
    printf '✓ %s:%s %s\n' "$1" "$spaces" "$2" >&2;
}

# <path> with $HOME shown as ~, for display.
function tilde-path() {
    # shellcheck disable=SC2088  # a literal ~ is the point: this path is for display only
    case $1 in
        "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
        *)         printf '%s\n' "$1" ;;
    esac
}

# --- Input --------------------------------------------------------------------

# Every prompt goes through the functions below (plain bash). Prompts go to stderr; only the answer
# goes to stdout, so `$(ask-...)` captures just the answer.

# ask-text <header> [placeholder] [guess]: prints the answer; an empty answer keeps the guess.
function ask-text() {
    local header="$1"
    local placeholder="${2:-}"
    local guess_value="${3:-}"
    local value hint
    hint=${guess_value:-$placeholder}
    printf '\n%s%s: ' "$header" "${hint:+ [$hint]}" >&2
    IFS= read -r value || die "Cancelled."
    [[ -n $value ]] || value=$guess_value
    printf '%s\n' "$value"
}

# ask-path <header> [placeholder] [guess]: as ask-text, for a file or folder. At a terminal, Tab
# completes names (readline: `read -e`, which draws the prompt itself). A leading ~ is the home folder.
function ask-path() {
    local header="$1"
    local placeholder="${2:-}"
    local guess_value="${3:-}"
    local value hint prompt
    hint=${guess_value:-$placeholder}
    prompt="$header${hint:+ [$hint]}: "
    if [[ -t 0 ]]; then
        printf '\n' >&2
        IFS= read -e -r -p "$prompt" value || { echo >&2 ; die "Cancelled." ; }
    else
        printf '\n%s' "$prompt" >&2
        IFS= read -r value || die "Cancelled."
    fi
    # readline puts a space after a name it completes.
    while [[ $value == *" " ]]; do value=${value% } ; done
    [[ -n $value ]] || value=$guess_value
    # shellcheck disable=SC2088  # a literal ~ typed in is matched here, and made $HOME
    case $value in
        "~")   value=$HOME ;;
        "~/"*) value=$HOME/${value#"~/"} ;;
    esac
    printf '%s\n' "$value"
}

# ask-choice <header> <option>...: prints the chosen option; fails on cancel (Ctrl-D).
function ask-choice() {
    local header=$1 choice ; shift
    printf '%s\n' "$header" >&2
    local PS3="Pick a number (Ctrl-D cancels): "
    select choice in "$@"; do
        [[ -n $choice ]] && { printf '%s\n' "$choice"; return 0; }
    done
    echo >&2
    return 1
}

# confirm <question>: succeeds on yes. Anything else — and the default — is no.
function confirm() {
    local answer
    printf '%s [y/N] ' "$1" >&2
    IFS= read -r answer || { echo >&2; return 1; }
    [[ $answer == [yY]* ]]
}

# acknowledge <line>...: tell the user what comes next, and wait for Enter. Dies on cancel (Ctrl-D).
function acknowledge() {
    local answer
    printf '\n' >&2
    printf '%s\n' "$@" >&2
    printf 'Press Enter to continue (Ctrl-D cancels): ' >&2
    IFS= read -r answer || { echo >&2 ; die "Cancelled." ; }
}

# show-box <line>...: the lines in a rounded box.
function show-box() {
    local line width=0 border
    for line in "$@"; do (( ${#line} > width )) && width=${#line}; done
    border=$(printf '%*s' $(( width + 2 )) '')
    border=${border// /─}
    printf '╭%s╮\n' "$border"
    for line in "$@"; do printf '│ %s%*s │\n' "$line" $(( width - ${#line} )) ''; done
    printf '╰%s╯\n' "$border"
}

# --- User + Key ---------------------------------------------------------------

# Best guess at the user's name
function guess-name() {
    # Git
    local line name=${GIT_AUTHOR_NAME:-$(git config --global user.name 2>/dev/null)}

    # /etc/passwd (Linux, WSL, and some macOS accounts)
    if [[ -z $name ]]; then
        line=$(grep "^$(id -un):" /etc/passwd 2>/dev/null)
        line=${line#*:*:*:*:}  # drop user:pass:uid:gid:
        line=${line%%:*}       # drop :home:shell
        name=${line%%,*}       # drop ,office,phone
    fi

    # macOS Directory Services
    if [[ -z $name && $(uname -s) == Darwin ]]; then
        name=$(id -F 2>/dev/null)
    fi

    printf '%s\n' "$name"
}

# Best guess at the user's email
function guess-email() {
    local email=${GIT_AUTHOR_EMAIL:-}
    [[ -n $email ]] || email=$(git config --global user.email 2>/dev/null || true)
    [[ -n $email ]] || email=${EMAIL:-}
    printf '%s\n' "$email"
}

# One line per secret key: "<fingerprint><TAB><first user id>".
function list-secret-keys() {
    # [<id>] limits the list to the keys gpg matches with it (fingerprint, key id, email, ...).
    gpg --list-secret-keys --with-colons "$@" 2>/dev/null | awk -F: '
        $1 == "sec"                 { want_fpr = 1; want_uid = 1; fpr = ""; next }
        $1 == "fpr" && want_fpr     { fpr = $10; want_fpr = 0; next }
        $1 == "uid" && want_uid     { print fpr "\t" $10; want_uid = 0 }
    '
}

# The fingerprint of the one secret key matching <id>; fails when none or several match.
function find-key() {
    local matches
    matches=$(list-secret-keys "$1")
    [[ -n $matches ]] || die "No secret key matches '$1'."
    if (( $(printf '%s\n' "$matches" | wc -l) > 1 )); then
        die "More than one secret key matches '$1'; use its fingerprint:${EXTRA_LINE}$(printf '%s\n' "$matches" | awk -F'\t' '{ print "    " $1 "  " $2 }')"
    fi
    printf '%s\n' "${matches%%$'\t'*}"
}

# generate-key <name> <email> <passphrase-on-stdin>: a new key with gpg's defaults. Its passphrase is
# the first line of stdin when <passphrase-on-stdin> is 1; otherwise gpg's own prompt (pinentry) asks.
# Prints the new key's fingerprint.
function generate-key() {
    local uid="$1 <$2>" passphrase_on_stdin=$3 status finger_print

    info "Generating key ..." >&2
    # gpg's normal output goes to the terminal (stderr); its machine-readable status lines (fd 3)
    # are captured so we get the fingerprint without guessing which key is new.
    if (( passphrase_on_stdin )); then
        status=$(gpg --batch --pinentry-mode loopback --passphrase-fd 0 \
                     --status-fd 3 --quick-generate-key --yes "$uid" 3>&1 1>&2) \
            || die "Creating the key failed."
    else
        status=$(gpg --batch --status-fd 3 --quick-generate-key --yes "$uid" 3>&1 1>&2) \
            || die "Creating the key failed."
    fi
    finger_print=$(printf '%s\n' "$status" | awk '$2 == "KEY_CREATED" { print $4 }')
    # gpg exits 0 when the user answers No to its own "Continue?", and simply makes no key.
    [[ -n $finger_print ]] || die "Cancelled — no key was created."

    printf '%s\n' "$finger_print"
}

# One line per public key that can encrypt — not expired, revoked, disabled or invalid:
# "<fingerprint><TAB><first user id>".
function list-public-keys() {
    gpg --list-keys --with-colons 2>/dev/null | awk -F: '
        $1 == "pub"             { ok = ($2 !~ /[eridn]/ && $12 ~ /E/ && $12 !~ /D/)
                                  want_fpr = ok; want_uid = ok; fpr = ""; next }
        $1 == "fpr" && want_fpr { fpr = $10; want_fpr = 0; next }
        $1 == "uid" && want_uid { print fpr "\t" $10; want_uid = 0 }
    '
}

# Pick a public key from the keyring to lock a file to. Prints its fingerprint, or nothing for
# "A key file (.asc), or another key id" — and when the keyring has none to offer.
function pick-public-key() {
    local other="A key file (.asc), or another key id" line choices=() choice
    # Shown as "<user id>  [<fingerprint>]"; the fingerprint is read back from the brackets.
    while IFS= read -r line; do
        choices+=("${line#*$'\t'}  [${line%%$'\t'*}]")
    done < <(list-public-keys)
    (( ${#choices[@]} > 0 )) || return 0
    echo >&2
    choice=$(ask-choice "Which public key?" "${choices[@]}" "$other") || die "Cancelled."
    [[ $choice != "$other" ]] || return 0
    choice=${choice##*[}
    printf '%s\n' "${choice%]}"
}

# Pick the key for the store: an existing one, or a new one. Prints the fingerprint, or nothing for
# a new key. Always a list, even for one key: confirm reports cancel the same as No, which would
# turn a cancel into "create a new key".
function select-key() {
    local create_new_key="Create a new key" line choices=() choice key
    # Shown as "<user id>  [<fingerprint>]"; the fingerprint is read back from the brackets.
    while IFS= read -r line; do
        choices+=("${line#*$'\t'}  [${line%%$'\t'*}]")
    done < <(list-secret-keys)
    choices+=("${create_new_key}")

    # No existing keys: nothing to choose, a new key it is.
    (( ${#choices[@]} > 1 )) || return 0
    echo >&2
    choice=$(ask-choice "Which GPG key should encrypt the store?" "${choices[@]}") \
        || die "Cancelled."
    [[ $choice != "${create_new_key}" ]] || return 0
    key=${choice##*[}
    printf '%s\n' "${key%]}"
}

# The first user id ("Name <email>") of the key with fingerprint <fpr>.
function key-uid() {
    gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '$1 == "uid" { print $10; exit }'
}

# The expiry date (YYYY-MM-DD, UTC) of the key with fingerprint <fpr>; nothing when it never expires.
function key-expiry() {
    local epoch
    epoch=$(gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '$1 == "pub" { print $7; exit }')
    [[ -n $epoch ]] || return 0
    # GNU date takes -d @<epoch>; BSD (macOS) date takes -r <epoch>.
    date -u -d "@$epoch" +%F 2>/dev/null || date -u -r "$epoch" +%F
}

