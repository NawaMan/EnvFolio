#!/usr/bin/env bash

#== Setting ===================================================================

STORE_PATH=${KEEP_STORE_DIR:-$HOME/.keep}
# Always absolute: `pass` loops forever on a relative PASSWORD_STORE_DIR whose folder doesn't exist
# yet (its set_git keeps stripping "/…" off a path that has none left).
[[ $STORE_PATH == /* ]] || STORE_PATH=$PWD/$STORE_PATH

# The Keep store is laid out like a pass store, but lives in its own place so it never touches the
# user's own ~/.password-store. Every `pass` call goes there.
export PASSWORD_STORE_DIR="$STORE_PATH"

#== Main ======================================================================

function version() {
    echo "Keep 0.1"
}

function main() {
    # Quiet when all is there; otherwise show the table and stop.
    if ! ensure-requirements "$@" >/dev/null; then ensure-requirements "$@" ; return 1 ; fi

    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        store)   store  "$@" ;;
        text)    text   "$@" ;;
        pass)    secret "$@" ;;
        ls)      list   "$@" ;;
        version) version "$@" ;;
        help)    help   "$@" ;;
        "")      echo   "Usage: keep <version|help|store|text|pass|ls> [args...]" >&2 ; return 1 ;;
        *)       echo   "keep: unknown command: $category"                        >&2 ; return 1 ;;
    esac
}

#== Common Constants ==========================================================

EXTRA_LINE="""
"""

# <path> with $HOME shown as ~, for display.
function tilde-path() {
    # shellcheck disable=SC2088  # a literal ~ is the point: this path is for display only
    case $1 in
        "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
        *)         printf '%s\n' "$1" ;;
    esac
}

#==  Command:Help + Version ===================================================

# keep help [command...]
function help() {
    case "$*" in
        "")           keep-help       ;;
        "store init") store-init-help ;;
        *)            echo "keep help: no help for '$*' yet." >&2 ; return 1 ;;
    esac
}

function keep-help() {
    cat <<'EOF'
Usage: keep <command> [args...]

Commands:
  store init        Create the Keep store
  store path        Print the store's folder
  store backup      (not yet)
  store restore     (not yet)
  store export      (not yet)
  store import      (not yet)
  text ...          Plain-text items (not yet)
  pass ...          Secrets (not yet)
  ls                List texts and secrets (not yet)
  version           Print Keep's version
  help [command]    Show help, e.g. `keep help store init`

The store is $KEEP_STORE_DIR, default ~/.keep.
Details and examples: MANUAL.md
EOF
}

#== Command:Store =============================================================

function store-path() {
    echo "${STORE_PATH}"
}

# Whether the store is ready to use. Prints nothing; the caller acts on the return code:
#   0 - ready: the folder exists and has a non-empty .gpg-id (written by `pass init`)
#   1 - missing: no folder at all
#   2 - not a store: the folder exists but has no (or an empty) .gpg-id
#   3 - unfinished: a `keep store init` started here and did not finish (see init-progress-file)
function store-exists() {
    [[ -d $STORE_PATH          ]] || return 1
    [[ -e $(init-progress-file) ]] && return 3
    [[ -s $STORE_PATH/.gpg-id  ]] || return 2
    return 0
}

# --- Init progress ------------------------------------------------------------
# While `keep store init` runs, the store holds .keep-init: "key <fingerprint>" first, then one line
# per finished step. It is removed when init is done, so a leftover one means init was cut short.
# Every step can safely run again, so resuming just redoes the steps not listed.

function init-progress-file() { printf '%s/.keep-init\n' "$STORE_PATH"; }
function init-progress-mark() { printf '%s\n' "$*" >> "$(init-progress-file)"; }
function init-progress-done() { grep -qx -- "$1" "$(init-progress-file)" 2>/dev/null; }
function init-progress-key()  { awk '$1 == "key" { print $2; exit }' "$(init-progress-file)" 2>/dev/null; }

# Show what an unfinished init got done, then ask what to do. Prints: continue | start-over | cancel
function ask-unfinished-init() {
    local key=$1 uid=$2
    info "An earlier \`keep store init\` did not finish at $(tilde-path "$STORE_PATH")." >&2
    show-answer "Key" "$key ${uid:-(no longer in your keyring)}" "    "
    init-progress-done pass-init   && show-answer "Store"   "created" "  "
    init-progress-done git-history && show-answer "History" "started"
    local choice
    choice=$(gum choose --header "${EXTRA_LINE}What should happen?" \
        "Continue where it stopped" "Start over" "Cancel") || choice=Cancel
    case $choice in
        Continue*) echo continue   ;;
        Start*)    echo start-over ;;
        *)         echo cancel     ;;
    esac
}

# Whether we can ask the user anything (stdin is a terminal).
function can-ask() { [[ -t 0 ]]; }

function confirm() { gum confirm "$1"; }

function store-init-usage() {
    cat <<'EOF'
Usage: keep store init [--key <id>]
       keep store init [--new-key] [--name <name>] [--email <email>] [--passphrase-stdin]
EOF
}

function store-init-help() {
    store-init-usage
    cat <<'EOF'

Create the Keep store ($KEEP_STORE_DIR, default ~/.keep): pick or create the GPG key that
encrypts it, run `pass init`, and start the store's git history. Anything not given is asked for.

Options:
  --key <id>          Use an existing secret key: fingerprint, key id or email (must match one).
                      No passphrase is needed: the store only encrypts to the key.
  --new-key           Create a new key. Implied by any option below.
  --name <name>       The new key's name.
  --email <email>     The new key's email.
  --passphrase-stdin  Read the new key's passphrase from the first line of stdin.
                      Needs --name and --email. An empty passphrase is refused.
  -h, --help          Show this help.

--opt=value works as well as --opt value.
Examples: MANUAL.md, section `keep store init`.
EOF
}

# keep store init [--key <id>] | [--new-key] [--name <name>] [--email <email>] [--passphrase-stdin]
# Anything not given is asked for. An existing key needs no passphrase: the store only encrypts to it.
function store-init() {
    # Processs input
    local key_id="" new_key=0 name="" email="" passphrase_stdin=0 arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        # --opt=value is the same as --opt value
        if [[ $arg == --*=* ]]; then set -- "${arg#*=}" "$@" ; arg=${arg%%=*} ; fi
        case $arg in
            --key|--name|--email)
                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                case $arg in
                    --key)   key_id=$1 ;;
                    --name)  name=$1   ;;
                    --email) email=$1  ;;
                esac
                shift ;;
            --new-key)          new_key=1          ;;
            --passphrase-stdin) passphrase_stdin=1 ;;
            -h|--help)          store-init-help ; return 0 ;;
            *) die "store init: unknown option: $arg${EXTRA_LINE}$(store-init-usage)" ;;
        esac
    done
    [[ -n $name || -n $email ]] || (( passphrase_stdin )) && new_key=1
    if [[ -n $key_id ]] && (( new_key )); then
        die "--key cannot be used with --new-key, --name, --email or --passphrase-stdin."
    fi
    # stdin carries the passphrase, so nothing else can be asked for.
    if (( passphrase_stdin )) && [[ -z $name || -z $email ]]; then
        die "--passphrase-stdin needs --name and --email too."
    fi

    local status=0 key="" uid expiry
    store-exists || status=$?
    if (( status == 3 )); then
        key=$(init-progress-key)
        [[ -n $key ]] && uid=$(key-uid "$key")
        if (( new_key )) || { [[ -n $key_id ]] && [[ $(find-key "$key_id") != "$key" ]]; }; then
            die "An unfinished init at $STORE_PATH uses the key $key." \
                "Run \`keep store init\` without key options to continue or start over."
        fi
        can-ask || die "An earlier \`keep store init\` did not finish at $STORE_PATH." \
                       "Run it again in a terminal to continue or start over, or remove that folder."
        case $(ask-unfinished-init "$key" "$uid") in
            continue)
                [[ -n $key && -n $uid ]] || die "The key for this store is no longer in your keyring." \
                                                "Run again and choose Start over."
                ;;
            start-over)
                confirm "Delete $(tilde-path "$STORE_PATH") and everything in it, then start over?" \
                    || die "Cancelled."
                rm -rf -- "$STORE_PATH"
                key="" ; status=1
                ;;
            *) die "Cancelled." ;;
        esac
    fi
    if (( status == 0 )); then
        die "A Keep store already exists at $STORE_PATH." \
            "To create another one, run with ${EXTRA_LINE}" \
            "    KEEP_STORE_DIR=<other-folder> $0 store init."
    fi
    if (( status == 2 )) && [[ -n $(ls -A "$STORE_PATH" 2>/dev/null) ]]; then
        die "$STORE_PATH is not empty and is not a Keep store." \
            "Empty it, or run with ${EXTRA_LINE}" \
            "    KEEP_STORE_DIR=<other-folder> $0 store init."
    fi

    # A resumed init already has its key.
    if [[ -z $key ]]; then
        section "Select key to protect the keep store."
        if [[ -n $key_id ]]; then
            key=$(find-key "$key_id") || exit 1
            show-answer "Key" "$key"
        elif (( new_key )); then
            section "Generating the key."
            key=$(generate-key "$name" "$email" "$passphrase_stdin") || exit 1
            section-end
            show-answer "Key" "$key"
        else
            key=$(select-key) || exit 1
        fi
        uid=$(key-uid "$key")
        [[ -n $uid ]] || die "Cannot find the key $key."

        # From here on the store is being written: record each step, so a cut-short init can resume.
        mkdir -p "$STORE_PATH"     || die "Cannot create $STORE_PATH."
        init-progress-mark key "$key"
    fi
    expiry=$(key-expiry "$key")

    if ! init-progress-done pass-init; then
        section "Create the password store"
        pass init "$key"           || die "pass init failed."
        init-progress-mark pass-init
    fi

    if ! init-progress-done git-history; then
        section "Start the store's git history"
        start-store-history "$uid"
        init-progress-mark git-history
    fi

    rm -f -- "$(init-progress-file)"

    section "Summary"
    store-summary "$key" "$uid" "$expiry"
    echo ""
}

