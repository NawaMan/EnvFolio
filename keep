#== Command: Secret ============================================================

function secret() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    # Every secret command needs a ready store — except asking for its help.
    case " $* " in
        *" -h "*|*" --help "*) ;;
        *) [[ -z $category ]] || require-store ;;
    esac
    case "$category" in
        ls)       secret-ls       "$@" ;;
        find)     secret-find     "$@" ;;
        grep)     secret-grep     "$@" ;;
        show)     secret-show     "$@" ;;
        insert)   secret-insert   "$@" ;;
        edit)     secret-edit     "$@" ;;
        generate) secret-generate "$@" ;;
        rm)       secret-rm       "$@" ;;
        mv)       secret-mv       "$@" ;;
        cp)       secret-cp       "$@" ;;
        "")       echo "Usage: keep secret <ls|find|grep|show|insert|edit|generate|rm|mv|cp> [args...]" >&2 ; return 1 ;;
        *)        echo "keep secret: unknown command: $category"                                        >&2 ; return 1 ;;
    esac
}

# --- secret ls ----------------------------------------------------------------

function secret-ls-help() {
    cat <<'EOF'
Usage: keep secret ls [<subfolder>]

List the secrets in the Keep store as a tree — names only, never their values.
Give a subfolder to list only what is under it.

Options:
  -h, --help          Show this help and stop.
EOF
}

# keep secret ls [<subfolder>]
# `pass ls`, minus the texts. Only a folder: given an entry, `pass ls` would print the secret.
function secret-ls() {
    case ${1:-} in -h|--help) secret-ls-help ; return 0 ;; esac
    (( $# <= 1 )) || die "Usage: keep secret ls [<subfolder>]"
    [[ $# -eq 0 || ( $1 != -* && /$1/ != */../* && -d $STORE_PATH/$1 ) ]] \
        || die "secret ls: '$1' is not a folder in the store."
    echo "Secret Store"
    [[ $# -eq 0 ]] || echo "${1%/}"
    store-tree gpg "$STORE_PATH/${1:-}"
}

# --- secret find --------------------------------------------------------------

function secret-find-help() {
    cat <<'EOF'
Usage: keep secret find <part>...

List the secrets whose names contain any of the parts (ignoring case), as a tree — names only,
never their values.

Options:
  -h, --help          Show this help and stop.
EOF
}

# keep secret find <part>...
# `pass find`, minus the texts.
function secret-find() {
    local arg terms
    for arg in "$@"; do case $arg in -h|--help) secret-find-help ; return 0 ;; esac ; done
    (( $# > 0 )) || die "Usage: keep secret find <part>..."
    terms="*$(printf '%s*|*' "$@")"
    printf 'Search Terms: %s\n' "$*"
    store-tree gpg "$STORE_PATH" -P "${terms%|*}" --matchdirs --ignore-case
}

# --- secret grep --------------------------------------------------------------

function secret-grep-help() {
    cat <<'EOF'
Usage: keep secret grep [<grep-option>...] <pattern>

Decrypt every secret and print the lines that match <pattern>, under each secret's name.
The matching lines are secret values: they are shown on screen.

Options:
  <grep-option>       Any option of grep, e.g. -i to ignore case, -v to invert the match.
  -h, --help          Show this help and stop (not grep's -h).
EOF
}

# keep secret grep [<grep-option>...] <pattern>
function secret-grep() { call-pass secret-grep-help grep "$@" ; }

# --- secret show --------------------------------------------------------------

function secret-show-help() {
    cat <<'EOF'
Usage: keep secret show [-c|--clip[=<line>]] <name>

Show a secret: decrypt it and print it. With --clip, copy it to the clipboard instead; the
clipboard is cleared after 45 seconds (PASSWORD_STORE_CLIP_TIME).

Options:
  -c, --clip[=<line>] Copy the secret — or only its line <line> — to the clipboard; print nothing.
  -h, --help          Show this help and stop.
EOF
}

# keep secret show [-c|--clip[=<line>]] <name>
# Only an entry goes through: given a folder, `pass show` would list it.
function secret-show() {
    local clip=() names=() arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        case $arg in
            -h|--help)                   secret-show-help ; return 0 ;;
            -c|-c[0-9]*|--clip|--clip=*) clip=("$arg") ;;
            -q*|--qrcode*)               die "secret show: --qrcode is not offered." ;;
            --)                          names+=("$@") ; break ;;
            -*)                          die "secret show: unknown option: $arg" ;;
            *)                           names+=("$arg") ;;
        esac
    done
    (( ${#names[@]} == 1 ))              || die "Usage: keep secret show [-c|--clip[=<line>]] <name>"
    [[ -f $STORE_PATH/${names[0]}.gpg ]] || die "secret show: '${names[0]}' is not a secret in the store."
    pass show "${clip[@]}" -- "${names[0]}"
}

# --- secret insert ------------------------------------------------------------

function secret-insert-help() {
    cat <<'EOF'
Usage: keep secret insert [-m|--multiline] [-f|--force] <name>

Add a secret to the Keep store, encrypted with the store's key. The secret is asked for twice,
without echo. Piped in, give it twice (one per line), or use --multiline to take all of stdin.

Options:
  -m, --multiline     The secret is several lines; end it with Ctrl-D.
  -f, --force         Overwrite an existing secret without asking (only asked at a terminal).
  -h, --help          Show this help and stop.
EOF
}

# keep secret insert [-m|--multiline] [-f|--force] <name>
# Everything goes to `pass insert` — except --help, and --echo, which would show the secret.
function secret-insert() {
    local arg
    for arg in "$@"; do
        case $arg in
            --)                  break ;;
            -h|--help)           break ;;
            --echo|-e*|-[!-]*e*) die "secret insert: --echo is not offered; it would show the secret." ;;
        esac
    done
    call-pass secret-insert-help insert "$@"
}

# --- secret edit --------------------------------------------------------------

function secret-edit-help() {
    cat <<'EOF'
Usage: keep secret edit <name>

Edit a secret in $EDITOR, or add it if it is new. The secret is decrypted to a temporary file
for the editor (in /dev/shm, a RAM disk, where there is one) and removed afterwards.

Options:
  -h, --help          Show this help and stop.
EOF
}

# keep secret edit <name>
function secret-edit() { call-pass secret-edit-help edit "$@" ; }

# --- secret generate ----------------------------------------------------------

function secret-generate-help() {
    cat <<'EOF'
Usage: keep secret generate [-n|--no-symbols] [-c|--clip] [-i|--in-place|-f|--force] <name> [<length>]

Generate a random secret (25 characters unless <length> is given), save it, and print it.
With --clip, copy it to the clipboard instead of printing it; the clipboard is cleared after
45 seconds (PASSWORD_STORE_CLIP_TIME).

Options:
  -n, --no-symbols    Letters and digits only.
  -c, --clip          Copy the secret to the clipboard; do not print it.
  -i, --in-place      Replace only the first line of an existing secret; keep the rest.
  -f, --force         Overwrite an existing secret without asking (only asked at a terminal).
  -h, --help          Show this help and stop.
EOF
}

# keep secret generate [-n|--no-symbols] [-c|--clip] [-i|--in-place|-f|--force] <name> [<length>]
# Everything goes to `pass generate` — except --help, and --qrcode (it needs qrencode).
function secret-generate() {
    local arg
    for arg in "$@"; do
        case $arg in
            --)                     break ;;
            -h|--help)              break ;;
            --qrcode|-q*|-[!-]*q*)  die "secret generate: --qrcode is not offered." ;;
        esac
    done
    call-pass secret-generate-help generate "$@"
}

# --- secret rm ----------------------------------------------------------------

function secret-rm-help() {
    cat <<'EOF'
Usage: keep secret rm [-r|--recursive] [-f|--force] <name>

Remove a secret, or a whole folder with --recursive. At a terminal, asks first unless --force;
from a script or pipe, it does not ask.
The removed secret stays in the store's git history.

Options:
  -r, --recursive     Remove a folder and everything in it.
  -f, --force         Do not ask.
  -h, --help          Show this help and stop.
EOF
}

# keep secret rm [-r|--recursive] [-f|--force] <name>
function secret-rm() { call-pass secret-rm-help rm "$@" ; }

# --- secret mv ----------------------------------------------------------------

function secret-mv-help() {
    cat <<'EOF'
Usage: keep secret mv [-f|--force] <old-name> <new-name>

Rename or move a secret or a folder. At a terminal, asks before overwriting unless --force;
from a script or pipe, it overwrites.

Options:
  -f, --force         Overwrite without asking.
  -h, --help          Show this help and stop.
EOF
}

# keep secret mv [-f|--force] <old-name> <new-name>
function secret-mv() { call-pass secret-mv-help mv "$@" ; }

