#!/usr/bin/env bash

#== Doc ========================================================================
#
# Keep — a terminal UI for keeping texts and secrets, built on `pass`.
#
# Usage: keep <command> [args...]        (`keep help` lists the commands)
#   keep store  init | path | backup | restore | export | import
#   keep text   ls | find | grep | show | insert | edit | generate | rm | mv | cp
#   keep pass   ls | find | grep | show | insert | edit | generate | rm | mv | cp   (secrets)
#   keep ls | version | help [command]
#
# Environment:
#   KEEP_STORE_DIR  The Keep store (default ~/.keep). Laid out like a pass store, but kept apart
#                   from your own ~/.password-store.
#   KEEP_NO_GUM     Set to use plain prompts even when `gum` (optional) is installed.
#
# Every command, with examples: MANUAL.md

#== Settings ===================================================================

STORE_PATH=${KEEP_STORE_DIR:-$HOME/.keep}
# Always absolute: `pass` loops forever on a relative PASSWORD_STORE_DIR whose folder doesn't exist
# yet (its set_git keeps stripping "/…" off a path that has none left).
[[ $STORE_PATH == /* ]] || STORE_PATH=$PWD/$STORE_PATH

# The Keep store is laid out like a pass store, but lives in its own place so it never touches the
# user's own ~/.password-store. Every `pass` call goes there.
export PASSWORD_STORE_DIR="$STORE_PATH"

#== Main =======================================================================

function main() {
    # Quiet when all is there; otherwise show the table and stop.
    if ! ensure-requirements "$@" >/dev/null; then ensure-requirements "$@" ; return 1 ; fi

    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        store)   store  "$@" ;;
        text)    text   "$@" ;;
        pass)    secret "$@" ;;
        ls)      list   "$@" ;;
        version) version "$@" ;;
        help)    help   "$@" ;;
        "")      echo   "Usage: keep <version|help|store|text|pass|ls> [args...]" >&2 ; return 1 ;;
        *)       echo   "keep: unknown command: $category"                        >&2 ; return 1 ;;
    esac
}

function version() {
    echo "Keep 0.1"
}

# keep help [command...]
function help() {
    case "$*" in
        "")           keep-help       ;;
        "store init") store-init-help ;;
        *)            echo "keep help: no help for '$*' yet." >&2 ; return 1 ;;
    esac
}

function keep-help() {
    cat <<'EOF'
Usage: keep <command> [args...]

Commands:
  store init        Create the Keep store
  store path        Print the store's folder
  store backup      (not yet)
  store restore     (not yet)
  store export      (not yet)
  store import      (not yet)
  text ...          Plain-text items (not yet)
  pass ...          Secrets (not yet)
  ls                List texts and secrets (not yet)
  version           Print Keep's version
  help [command]    Show help, e.g. `keep help store init`

The store is $KEEP_STORE_DIR, default ~/.keep.
Details and examples: MANUAL.md
EOF
}

#== Common Constants ===========================================================

EXTRA_LINE="""
"""

#== Command: Store =============================================================

function store() {
    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        path)    store-path    "$@" ;;
        init)    store-init    "$@" ;;
        backup)  store-backup  "$@" ;;
        restore) store-restore "$@" ;;
        export)  store-export  "$@" ;;
        import)  store-import  "$@" ;;
        "")      echo "Usage: keep store <init|backup|restore|export|import> [args...]" >&2 ; return 1 ;;
        *)       echo "keep store: unknown command: $category"                          >&2 ; return 1 ;;
    esac
}

function store-path() {
    echo "${STORE_PATH}"
}

# Whether the store is ready to use. Prints nothing; the caller acts on the return code:
#   0 - ready: the folder exists and has a non-empty .gpg-id (written by `pass init`)
#   1 - missing: no folder at all
#   2 - not a store: the folder exists but has no (or an empty) .gpg-id
function store-exists() {
    [[ -d $STORE_PATH          ]] || return 1
    [[ -s $STORE_PATH/.gpg-id  ]] || return 2
    return 0
}

# --- store init ---------------------------------------------------------------

function store-init-usage() {
    cat <<'EOF'
Usage: keep store init [--key <id>]
       keep store init [--new-key] [--name <name>] [--email <email>] [--passphrase-stdin]
EOF
}

function store-init-help() {
    store-init-usage
    cat <<'EOF'

Create the Keep store ($KEEP_STORE_DIR, default ~/.keep): pick or create the GPG key that
encrypts it, run `pass init`, and start the store's git history. Anything not given is asked for.

Options:
  --key <id>          Use an existing secret key: fingerprint, key id or email (must match one).
                      No passphrase is needed: the store only encrypts to the key.
  --new-key           Create a new key. Implied by any option below.
  --name <name>       The new key's name.
  --email <email>     The new key's email.
  --passphrase-stdin  Read the new key's passphrase from the first line of stdin.
                      Needs --name and --email. An empty passphrase is refused.
  -h, --help          Show this help.

--opt=value works as well as --opt value.
Examples: MANUAL.md, section `keep store init`.
EOF
}

# keep store init [--key <id>] | [--new-key] [--name <name>] [--email <email>] [--passphrase-stdin]
# Anything not given is asked for. An existing key needs no passphrase: the store only encrypts to it.
function store-init() {
    # Processs inputs
    local key_id="" new_key=0 name="" email="" passphrase_stdin=0 arg
    while (( $# > 0 )); do
        arg=$1 ; shift
        # --opt=value is the same as --opt value
        if [[ $arg == --*=* ]]; then set -- "${arg#*=}" "$@" ; arg=${arg%%=*} ; fi
        case $arg in
            --key|--name|--email)
                [[ $# -gt 0 && -n $1 ]] || die "$arg needs a value."
                case $arg in
                    --key)   key_id=$1 ;;
                    --name)  name=$1   ;;
                    --email) email=$1  ;;
                esac
                shift ;;
            --new-key)          new_key=1          ;;
            --passphrase-stdin) passphrase_stdin=1 ;;
            -h|--help)          store-init-help ; return 0 ;;
            *) die "store init: unknown option: $arg${EXTRA_LINE}$(store-init-usage)" ;;
        esac
    done
    [[ -n $name || -n $email ]] || (( passphrase_stdin )) && new_key=1
    if [[ -n $key_id ]] && (( new_key )); then
        die "--key cannot be used with --new-key, --name, --email or --passphrase-stdin."
    fi
    # stdin carries the passphrase, so nothing else can be asked for.
    if (( passphrase_stdin )) && [[ -z $name || -z $email ]]; then
        die "--passphrase-stdin needs --name and --email too."
    fi

    if [[ -e $STORE_PATH ]]; then
        die "A folder already exists at $STORE_PATH." \
            "If an earlier \`keep store init\` did not finish, remove it and run again." \
            "To create another store, run with ${EXTRA_LINE}" \
            "    KEEP_STORE_DIR=<other-folder> $0 store init."
    fi

    local key uid expiry
    section "Select key to protect the keep store."
    if [[ -n $key_id ]]; then
        key=$(find-key "$key_id") || exit 1
        show-answer "Key" "$key"
    elif (( new_key )); then
        section "Generating the key."
        key=$(generate-key "$name" "$email" "$passphrase_stdin") || exit 1
        section-end
        show-answer "Key" "$key"
    else
        key=$(select-key) || exit 1
    fi
    uid=$(key-uid "$key")
    [[ -n $uid ]] || die "Cannot find the key $key."
    expiry=$(key-expiry "$key")

    mkdir -p "$STORE_PATH"     || die "Cannot create $STORE_PATH."

    section "Create the password store"
    pass init "$key"           || die "pass init failed."

    section "Start the store's git history"
    start-store-history "$uid"

    section "Summary"
    store-summary "$key" "$uid" "$expiry"
    echo ""
}

# Start the store's git history, so `pass` commits every change from here on. The repo gets its
# own author (from the key's user id) first: without a global git identity, `pass git init`'s
# first commit — and every later automatic one — would fail.
function start-store-history() {
    local uid=$1
    local name=${uid% <*} email=${uid##*<}
    email=${email%>}

    git -C "$STORE_PATH" init --quiet                || die "Starting the store's git history failed."
    git -C "$STORE_PATH" config user.name  "$name"
    git -C "$STORE_PATH" config user.email "$email"
    pass git init >/dev/null                         || die "Starting the store's git history failed."
    show-answer "History" "$(git -C "$STORE_PATH" log --oneline | wc -l | tr -d ' ') commit(s)"
}

# The closing box: what was set up, and what the user must keep to ever get their passwords back.
function store-summary() {
    local key=$1 uid=$2 expiry=$3 lines
    lines=(
        "Your pass store is ready."
        ""
        "Store:   $(tilde-path "$(store-path)")"
        "Key:     $key"
        "         $uid"
        "Expires: ${expiry:-never}"
        ""
        "To get your passwords back if this machine is lost, you need both:"
        ""
        "1. Your passphrase — it can't be reset. Memorise it, and keep a written copy offline."
        ""
        "2. A backup of your key and store — one file, made with:"
        "     keep store backup"
        "   Keep it somewhere safe and offline, and run it again after you change passwords."
    )
    if [[ -n $expiry ]]; then
        lines+=(
            ""
            "When the key expires ($expiry), pass can't add or change entries until you extend it:"
            "  gpg --quick-set-expire $key 2y"
        )
    fi
    show-box "${lines[@]}"
}

