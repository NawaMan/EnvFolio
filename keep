#== Main ======================================================================

function main() {
    ensure-requirements "$@" >/dev/null ; if [[ $? -ne 0 ]]; then ensure-requirements "$@" ; fi

    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        store) store  "$@" ;;
        text)  text   "$@" ;;
        pass)  secret "$@" ;;
        ls)    list   "$@" ;;
        "")    echo "Usage: keep <store|text|pass|ls> [args...]" >&2 ; return 1 ;;
        *)     echo "keep: unknown command: $category"            >&2 ; return 1 ;;
    esac
}

main "$@"
