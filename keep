}

function store-export() {
    echo "Do store export - not implement yet"
    exit 1
}

function store-import() {
    echo "Do store import - not implement yet"
    exit 1
}

function store() {
    echo "Do store"

    local category="${1:-}" ; (( $# > 0 )) && shift
    case "$category" in
        path)    store-path    "$@" ;;
        init)    store-init    "$@" ;;
        backup)  store-backup  "$@" ;;
        restore) store-restore "$@" ;;
        export)  store-export  "$@" ;;
        import)  store-import  "$@" ;;
        "")      echo "Usage: keep store <init|backup|restore|export|import> [args...]" >&2 ; return 1 ;;
        *)       echo "keep store: unknown command: $category"                          >&2 ; return 1 ;;
    esac
}

